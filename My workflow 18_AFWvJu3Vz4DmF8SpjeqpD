rifique as melhores oportunidades pra você?`,\n\n`Olá! Temos oportunidades de bolsa em diversas instituições.\nSe quiser, te mando as opções e prazos.`, // sem variáveis\n\n// variações específicas de curso/cidade\n`Oi {{nome}}! Vi aqui seu interesse em {{curso_de_interesse}}.\nQueremos te ajudar a garantir a bolsa ideal pra começar logo. Posso te orientar?`,\n\n`Olá {{nome}}! Perfeito você buscar {{curso_de_interesse}} em {{cidade_de_interesse}}.\nPosso checar agora as bolsas ativas nessa região e te enviar?`,\n\n`{{nome}}, estamos com bolsas em {{cidade_de_interesse}} para {{curso_de_interesse}}.\nQuer receber as opções por aqui?`,\n\n`Olá! Temos bolsas para {{curso_de_interesse}} em {{cidade_de_interesse}}.\nSe quiser, já faço a triagem e te retorno com os descontos.`, // sem nome\n\n// plataforma focada\n`Olá {{nome}}! Vi seu contato pelo {{plataforma}}.\nQuer que eu te encaminhe as bolsas que combinam com seu perfil?`,\n\n`Oi! Seu cadastro pelo {{plataforma}} chegou pra gente.\nPosso te enviar agora as bolsas com maior desconto disponíveis?`,\n\n// genéricas de urgência\n`Prazer falar com você, {{nome}}.\nTemos vagas com bolsa por tempo limitado.\nQuer prioridade no atendimento?`,\n\n`Temos novas bolsas liberadas hoje.\nQuer receber uma lista com as melhores oportunidades pra você?` // sem variáveis\n];\n\n// ========== Utilidades de placeholder ==========\nconst TOKEN_MAP = {\n  '{{nome}}': 'nome',\n  '{{plataforma}}': 'plataforma',\n  '{{curso_de_interesse}}': 'curso',\n  '{{curso de interesse}}': 'curso',\n  '{{cidade_de_interesse}}': 'cidade',\n  '{{cidade de interesse}}': 'cidade',\n};\n\nfunction placeholdersIn(template) {\n  const re = /{{\\s*[^}]+\\s*}}/g;\n  const found = template.match(re) || [];\n  const normalized = new Set();\n  for (const t of found) {\n    const key = TOKEN_MAP[t.trim()];\n    if (key) normalized.add(key);\n  }\n  return Array.from(normalized);\n}\n\nfunction templateUsable(template, available) {\n  const needs = placeholdersIn(template);\n  return needs.every(k => available[k]);\n}\n\n// ========== Filtragem por variáveis disponíveis ==========\nconst usableTemplates = templates\n  .map((t, i) => ({ text: t, idx: i, needs: placeholdersIn(t) }))\n  .filter(t => templateUsable(t.text, available));\n\n// Se nada servir, cria um fallback seguro\nconst fallbackTemplates = [\n  `Olá! Vi seu interesse em bolsas de estudo pelo Bolsa Mais Brasil. Posso te enviar opções agora?`,\n  `Oi! Temos oportunidades de bolsa ativas. Quer receber uma seleção feita pra você?`\n].map((t, i) => ({ text: t, idx: 100 + i, needs: [] }));\n\nconst pool = usableTemplates.length > 0 ? usableTemplates : fallbackTemplates;\n\n// ========== Escolha do modelo ==========\nconst chooseIdx = (n) => {\n  if (DETERMINISTIC_BY_LEAD) {\n    return deterministicIndex(n, phone || nomeCompleto || plataformaRaw || curso || cidade);\n  }\n  return randIndex(n);\n};\nconst pick = pool[chooseIdx(pool.length)];\n\n// ========== Preenchimento ==========\nconst fill = (t) => t\n  .replaceAll('{{nome}}', nome)\n  .replaceAll('{{plataforma}}', plataforma)\n  .replaceAll('{{curso_de_interesse}}', curso)\n  .replaceAll('{{curso de interesse}}', curso)\n  .replaceAll('{{cidade_de_interesse}}', cidade)\n  .replaceAll('{{cidade de interesse}}', cidade);\n\nconst mensagem = fill(pick.text);\n\n// ========== Retorno ==========\nreturn [\n  {\n    json: {\n      mensagem,\n      modeloIndex: pick.idx,\n      placeholdersUsados: pick.needs,\n      entrada: input,\n      variaveisDisponiveis: available,\n      totalTemplatesDisponiveis: pool.length\n    }\n  }\n];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1216,976],"id":"a753ef01-3f1f-4be1-8136-1226746b3cd6","name":"Code in JavaScript1"},{"parameters":{"assignments":{"assignments":[{"id":"5aafc673-b5ae-4ff9-84f2-8274d2e567aa","name":"já conhecia o bolsa mais brasil?","value":"=","type":"string"},{"id":"15761d2c-70e6-42a4-b7a6-528326f946fd","name":"curso de interesse","value":"={{ $j