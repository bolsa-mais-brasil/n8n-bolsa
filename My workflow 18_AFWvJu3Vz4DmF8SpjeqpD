 const ns = process.hrtime.bigint(); // nanosegundos\n      base = Number(ns & 0xffffffffn);\n    } else {\n      base = Date.now() >>> 0;\n    }\n  } catch (e) {\n    base = Date.now() >>> 0;\n  }\n  // mistura com Math.random\n  base ^= (Math.floor(Math.random() * 0xffffffff)) >>> 0;\n  // roda 3 steps do xorshift\n  let r = xorshift32(base);\n  r = xorshift32(r);\n  r = xorshift32(r);\n  return Math.floor((r / 0x100000000) * n);\n}\n\n// Alternativa determinística por lead (desative por padrão)\nfunction hash32(str) {\n  let h = 2166136261 >>> 0; // FNV-like\n  for (let i = 0; i < str.length; i++) {\n    h ^= str.charCodeAt(i);\n    h = Math.imul(h, 16777619);\n  }\n  return h >>> 0;\n}\nfunction deterministicIndex(n, s) {\n  const h = hash32(s || '');\n  return h % n;\n}\n\n// Toggle: mude para true se quiser padronizar por lead (mesmo lead recebe sempre o mesmo modelo)\nconst DETERMINISTIC_BY_LEAD = false;\n\n// ========== Normalização ==========\nconst plataformaRaw = (input['plataforma'] ?? '').toString().trim().toUpperCase();\nlet plataforma = plataformaRaw === 'IG' ? 'Instagram'\n             : plataformaRaw === 'FB' ? 'Facebook'\n             : plataformaRaw;\n\nconst nomeCompleto = (input['nome'] ?? '').toString().trim();\nconst nome = nomeCompleto.split(/\\s+/)[0] || '';\n\nconst curso = (input['curso de interesse'] ?? input['curso_de_interesse'] ?? '').toString().trim();\nconst cidade = (input['cidade de interesse'] ?? input['cidade_de_interesse'] ?? '').toString().trim();\n// mantido caso use no futuro\nconst conhecia = (input['já conhecia o bolsa mais brasil?'] ?? input['já_conhecia_o_bolsa_mais_brasil'] ?? '')\n  .toString().trim().toLowerCase();\n\nconst phone = (input['phone_number'] ?? '').toString();\n\n// Mapa de disponibilidade\nconst available = {\n  nome: !!nome,\n  plataforma: !!plataforma,\n  curso: !!curso,\n  cidade: !!cidade,\n};\n\n// ========== 20 Modelos ==========\nconst templates = [\n`Olá {{nome}}! Vimos seu cadastro pelo {{platafo