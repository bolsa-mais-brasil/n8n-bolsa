d) return null;\n    try {\n      return JSON.parse(trimmed);\n    } catch {\n      try {\n        return JSON.parse(trimmed.replace(/^\\uFEFF/, \"\"));\n      } catch {\n        return null;\n      }\n    }\n  }\n  return null;\n}\n\nfunction normalizeForMatch(s) {\n  return normStr(s)\n    .toLowerCase()\n    .normalize(\"NFD\")\n    .replace(/[\\u0300-\\u036f]/g, \"\") // remove acentos\n    .replace(/[^a-z0-9\\s-]/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .trim();\n}\n\n// Retorna: \"PRESENCIAL\" | \"SEMIPRESENCIAL\" | \"EAD\" | null\nfunction detectModalidade(raw) {\n  const m = normalizeForMatch(raw);\n  if (!m) return null;\n\n  // semipresencial primeiro, porque contém \"presencial\"\n  if (m.includes(\"semi\") && m.includes(\"presencial\")) return \"SEMIPRESENCIAL\";\n  if (m.includes(\"presencial\")) return \"PRESENCIAL\";\n  if (m.includes(\"ead\")) return \"EAD\";\n\n  return null;\n}\n\nfunction uniqueCaseInsensitive(arr) {\n  const seen = new Set();\n  const out = [];\n  for (const v of arr || []) {\n    const val = normStr(v);\n    if (!val) continue;\n    const key = val.toLowerCase();\n    if (seen.has(key)) continue;\n    seen.add(key);\n    out.push(val);\n  }\n  return out;\n}\n\nfunction toTitlePtBr(s) {\n  const lowerWords = new Set([\"de\", \"da\", \"do\", \"das\", \"dos\", \"e\"]);\n  const clean = normStr(s).toLowerCase();\n\n  return clean\n    .split(\" \")\n    .map((w, idx) => {\n      if (!w) return w;\n      if (idx !== 0 && lowerWords.has(w)) return w;\n\n      // d'oeste etc.\n      if (w.includes(\"'\")) {\n        return w\n          .split(\"'\")\n          .map(p => (p ? p.charAt(0).toUpperCase() + p.slice(1) : p))\n          .join(\"'\");\n      }\n\n      return w.charAt(0).toUpperCase() + w.slice(1);\n    })\n    .join(\" \");\n}\n\nfunction formatCity(cityRaw, uf) {\n  let c = normStr(cityRaw);\n  if (!c) return \"\";\n\n  // remove sufixo \" - UF\" se existir (já temos UF separado)\n  const m = c.match(/^(.*)\\s-\\s([A-Za-z]{2})$/);\n  if (m) c = m[1];\n\n  // normaliza caixa (mata \"MACEIÓ\" e afins)\n  return toTitlePtBr(c);\n}\n\nfunction getRowsFromItem(itemJson) {\n  // Aceita:\n  // - itemJson.content.data (obj já parseado)\n  // - itemJson.cursos (string JSON)\n  // - itemJson.data (string JSON)\n  if (itemJson?.content?.data && Array.isArray(itemJson.content.data)) {\n    return itemJson.content.data;\n  }\n\n  const parsed =\n    safeJsonParse(itemJson?.cursos) ??\n    safeJsonParse(itemJson?.data) ??\n    safeJsonParse(itemJson);\n\n  const rows = parsed?.content?.data;\n  return Array.isArray(rows) ? rows : [];\n}\n\n// -------------------- Coleta e agrupa --------------------\n\nconst items = $input.all();\n\nconst cursosPorModalidade = {\n  PRESENCIAL: new Set(),\n  SEMIPRESENCIAL: new Set(),\n  EAD: new Set(),\n};\n\nconst locaisPorModalidadeCurso = {\n  PRESENCIAL: new Map(),      // curso -> Map(UF -> Set(cidades))\n  SEMIPRESENCIAL: new Map(),\n  EAD: new Map(),\n};\n\nlet instituicao = \"\";\nlet encontrouModalidade = false;\n\nfor (const it of items) {\n  const j = it?.json ?? {};\n  const rows = getRowsFromItem(j);\n\n  for (const row of rows) {\n    if (!instituicao && row?.school_name) instituicao = normStr(row.school_name);\n\n    const modalidade = detectModalidade(row?.content_modality ?? \"\");\n    if (!modalidade) continue; // ignora outros tipos\n    encontrouModalidade = true;\n\n    const curso = normStr(row?.course_name);\n    if (!curso) continue;\n\n    cursosPorModalidade[modalidade].add(curso);\n\n    const uf = normStr(row?.unit_state).toUpperCase();\n    const cidade = formatCity(row?.unit_city, uf);\n\n    if (!locaisPorModalidadeCurso[modalidade].has(curso)) {\n      locaisPorModalidadeCurso[modalidade].set(curso, new Map());\n    }\n    const mapaUF = locaisPorModalidadeCurso[modalidade].get(curso);\n\n    if (uf) {\n      if (!mapaUF.has(uf)) mapaUF.set(uf, new Set());\n      if (cidade) mapaUF.get(uf).add(cidade);\n    }\n  }\n}\n\nif (!instituicao) instituicao = \"Instituição\";\n\n// Se você rodar isso em cima do seu output agregado (sem content_modality),\n// vai cair aqui. Não é bug, é falta de dado mesmo.\nif (!encontrouModalidade) {\n  return [{\n    json: {\n      mensagem_erro:\n        \"Não encontrei o campo content_modality nos dados de entrada. \" +\n        \"Para dividir em PRESENCIAL / SEMIPRESENCIAL / EAD, envie os registros brutos (content.data) com content_modality.\",\n    }\n  }];\n}\n\n// -------------------- Formata: Lista de cursos por modalidade --------------------\n\nfunction formatListaCursos(mod) {\n  const cursos = [...cursosPorModalidade[mod]]\n    .map(normStr)\n    .filter(Boolean)\n    .sort((a, b) => a.localeCompare(b, \"pt-BR\"));\n\n  return cursos.length ? cursos.join(\"\\n\") : \"(nenhum)\";\n}\n\nconst mensagem_lista_cursos =\n  `${instituicao}\\n\\n` +\n  `PRESENCIAL\\n${formatListaCursos(\"PRESENCIAL\")}\\n\\n` +\n  `SEMIPRESENCIAL\\n${formatListaCursos(\"SEMIPRESENCIAL\")}\\n\\n` +\n  `EAD\\n${formatListaCursos(\"EAD\")}`;\n\n// -------------------- Formata: Cursos com UF/cidades por modalidade --------------------\n\nfunction sortUfs(mapUF) {\n  return [...mapUF.entries()].sort(([a], [b]) => a.localeCompare(b, \"pt-BR\"));\n}\n\nfunction formatLocaisModalidade(mod) {\n  const mapaCursos = locaisPorModalidadeCurso[mod];\n  const cursos = [...mapaCursos.keys()].sort((a, b) => a.localeCompare(b, \"pt-BR\"));\n\n  if (cursos.length === 0) return \"(nenhum)\";\n\n  const blocos = [];\n\n  for (const curso of cursos) {\n    const mapUF = mapaCursos.get(curso);\n    const linhas = [];\n    linhas.push(curso);\n\n    for (const [uf, cidadesSet] of sortUfs(mapUF)) {\n      const cidades = uniqueCaseInsensitive([...cidadesSet])\n        .map(toTitlePtBr)\n        .filter(Boolean)\n        .sort((a, b) => a.localeCompare(b, \"pt-BR\"));\n\n      if (uf && cidades.length) {\n        linhas.push(`${uf}: ${cidades.join(\", \")}`);\n      }\n    }\n\n    blocos.push(linhas.join(\"\\n\"));\n  }\n\n  return blocos.join(\"\\n\\n\");\n}\n\nconst mensagem_cursos_com_locais =\n  `${instituicao}\\n\\n` +\n  `PRESENCIAL\\n\\n${formatLocaisModalidade(\"PRESENCIAL\")}\\n\\n` +\n  `SEMIPRESENCIAL\\n\\n${formatLocaisModalidade(\"SEMIPRESENCIAL\")}\\n\\n` +\n  `EAD\\n\\n${formatLocaisModalidade(\"EAD\")}`;\n\nconst mensagem_completa =\n  `Lista de cursos (por modalidade)\\n\\n${mensagem_lista_cursos}\\n\\n` +\n  `Lista de cursos com estados e cidades disponíveis (por modalidade)\\n\\n${mensagem_cursos_com_locais}`;\n\n// Saída (1 item)\nreturn [{\n  json: {\n    mensagem_lista_cursos,\n    mensagem_cursos_com_locais,\n    mensagem_completa,\n  }\n}];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-672,-496],"id":"708fb17d-a6f1-4db5-aeb9-6445d599fd23","name":"Code in JavaScript30"},{"parameters":{"options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[-480,-496],"id":"0e70e4b2-8cbf-430d-8990-40ce3bd75006","name":"Respond to Webhook59"},{"parameters":{"httpMethod":"POST","path":"aed0d5d0-e2f3-4f3c-a937-a414ec2a2483","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-1824,-496],"id":"7b8617e9-e938-4d8d-93a2-5a5b67874679","name":"Webhook14","webhookId":"aed0d5d0-e2f3-4f3c-a937-a414ec2a2483"},{"parameters":{"url":"https://api.bolsamaisbrasil.com.br/schools?limit=3000&page=1","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[-1632,-496],"id":"8b0e573c-0597-4409-9b42-445e4687f3eb","name":"HTTP Request6"},{"parameters":{"assignments":{"assignments":[{"id":"00271704-2cad-43b5-af9e-4485176cdfa2","name":"instituição selecionada","value":"={{ $('Webhook14').item.json.body.data[0][\"instituição\"] }}","type":"string"},{"id":"b2ec6c81-6a5c-4324-ac45-d2add5956041","name":"datalista de instituições","value":"={{ $json.data }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-1440,-496],"id":"8a