 || '')\n    .toLowerCase()\n    .split(' ')\n    .filter(Boolean)\n    .map(word => word.charAt(0).toUpperCase() + word.slice(1))\n    .join(' ');\n}\n\nfor (const entry of data) {\n  // >>> REMOVIDO: filtro que mantinha apenas \"presencial\"\n  // Agora entra qualquer modalidade (presencial, EAD, semipresencial, etc.)\n\n  const schoolName = entry.school_name || 'SEM_NOME';\n  const courseName = entry.course_name;\n\n  const schoolLower = (schoolName || '').toLowerCase();\n  const courseLower = (courseName || '').toLowerCase();\n\n  // IGNORA: Universidad Columbia Del Paraguay / MEDICINA\n  if (schoolLower === blockedSchool && courseLower === blockedCourse) {\n    continue;\n  }\n\n  if (!schoolsMap[schoolName]) {\n    schoolsMap[schoolName] = new Set();\n  }\n\n  if (courseName) {\n    schoolsMap[schoolName].add(courseName);\n  }\n}\n\n// Monta blocos de texto por instituição\nconst blocos = Object.entries(schoolsMap)\n  // Garante que não devolve escola sem curso\n  .filter(([_, coursesSet]) => coursesSet.size > 0)\n  .map(([schoolName, coursesSet]) => {\n    const linhas = [\n      // título: maior (##) e negrito (**)\n      '## **' + toTitleCase(schoolName) + '**',\n      ...Array.from(coursesSet)\n        .map(toTitleCase)\n        .sort()\n    ];\n    return linhas.join('\\n');\n  });\n\n// Junta blocos de instituições com linha em branco entre elas\nconst textoFinal = blocos.join('\\n\\n');\n\n// Mensagem padrão quando não achar nada:\nconst saida = textoFinal || 'Nenhuma oferta encontrada.';\n\n// Retorna um único item no formato que o n8n espera\nreturn [\n  {\n    json: {\n      texto: saida\n    }\n  }\n];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-1248,960],"id":"e4cb43b4-3923-460d-b3a4-bce3a981fff4","name":"Code in JavaScript28"},{"parameters":{"content":"## SOBRE A INSTITUIÇÃO\n","height":368,"width":944,"color":4},"type":"n8n-nodes-base.stickyNote","position":[-1872,-288],"typeVersion":1,"id":"6ac8fe00-c0df-48b8-bd6c-631cef61b9eb"