hecimentos).\n- Não afirme credenciamento, autorização ou reconhecimento oficial\n  a menos que isso esteja explicitamente confirmado.\n- Quando a informação não for certa, use expressões seguras como:\n  “conforme divulgação institucional”, “de acordo com informações públicas”,\n  ou “deve ser verificado em canais oficiais”.\n- Não use linguagem negativa.\n- Não faça promessas ou comparações.\n- Não inclua fontes, links ou comentários extras.\n\nFORMATO DE SAÍDA (OBRIGATÓRIO)\n\n## 🎓 <Nome da instituição>\n\n### 📘 Visão geral  \nTexto curto (1–2 frases) descrevendo a instituição de forma genérica e positiva,\nsem afirmar fatos específicos.\n\n### 💡 Proposta de valor  \n- Emoji + benefício genérico (3 bullets no máximo)\n- Linguagem neutra, positiva e institucional\n\n### 🧪 Cursos e áreas de atuação  \n- Descrever áreas de atuação de forma ampla  \n- Se não houver certeza, usar: “cursos na área de … conforme divulgação institucional”\n\n### 🏛️ Credenciamento e regularidade  \n- Usar linguagem cautelosa  \n- Se não houver certeza absoluta, escrever:\n  “A situação de credenciamento e autorizações deve ser verificada em canais oficiais.”\n\n### 🌱 Por que considerar  \n- 2 a 3 bullets curtos\n- Sempre positivos, genéricos e cuidadosos\n\nENTRADA\nNome da instituição: {{ $json.instituicao_nome }}\n\nSAÍDA\nEntregar apenas o texto final no formato acima, com títulos, subtítulos,\nbullets e emojis, sem explicações adicionais.\n"}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3,"position":[-1440,-224],"id":"814f5b3a-ceb8-4f57-99e1-21f18eb7bde1","name":"AI Agent"},{"parameters":{"model":{"__rl":true,"value":"gpt-4.1-nano","mode":"list","cachedResultName":"gpt-4.1-nano"},"builtInTools":{},"options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","typeVersion":1.3,"position":[-1440,-48],"id":"15364c6e-354b-4ac4-8737-5df1dc730038","name":"OpenAI Chat Model1","credentials":{"openAiApi":{"id":"BCQpx8PlGkX0l2ce","name":"Automações"}}},{"parameters":{"httpMethod":"POST","path":"b5f27ec4-80ad-49a3-8651-2ff3c44a0095","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-1824,-224],"id":"6ec351ac-ac94-445d-90b6-f7018e00c58c","name":"Webhook","webhookId":"b5f27ec4-80ad-49a3-8651-2ff3c44a0095"},{"parameters":{"url":"https://api.bolsamaisbrasil.com.br/schools/get","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[688,1104],"id":"a61ca309-8761-411b-ae8c-9de1518ad0b0","name":"HTTP Request2"},{"parameters":{"jsCode":"// Nó \"Code\" no n8n\n// Mode: Run Once for All Items\n\nconst dataString = items[0].json.data;\n\n// Converte a string JSON em array de objetos\nconst institutions = JSON.parse(dataString);\n\n// Nomes a bloquear (comparação pelo nome ORIGINAL)\nconst nomesBloqueadosRaw = new Set([\n  'BLACK DO BOLSA',\n  'ANHANGUERA/UNOPAR',\n  'EJA + TÉCNICO',\n  'GRUPO BOLSA MAIS BRASIL - UNICORP',\n]);\n\n// Overrides exatos\nconst overridesExatos = {\n  'MEUPROF': 'MeuProf',\n  'UNINORTE': 'UniNorte',\n  'UNIMAIS': 'UniMais',\n};\n\n// Siglas que devem permanecer em MAIÚSCULO\nconst siglasMaiusculas = [\n  'CENTEC',\n  'UNICV',\n  'CPET',\n  'CURES',\n  'FAMA',\n  'FAMEC',\n  'FAPI',\n  'FASPEC',\n  'FASTECH',\n  'FUCAPI',\n  'LFG',\n  'U:VERSE',\n  'UFBRA',\n  'UNAMA',\n  'UNESC',\n  'UNG',\n  'UNI7',\n  'UNIC',\n  'UNIDERP',\n  'UNIFAEL',\n  'UNIFATECIE',\n  'UNIME',\n  'UNIMEP',\n  'UNOPAR',\n  'UPTIME',\n];\n\n// Capitaliza tokens mantendo / e -\nfunction capitalizeToken(token) {\n  return token\n    .split(/([\\/\\-]+)/)\n    .map(chunk => {\n      if (/^[\\/\\-]+$/.test(chunk)) return chunk;\n      if (!chunk) return chunk;\n\n      const lower = chunk.toLowerCase();\n      return lower.charAt(0).toUpperCase() + lower.slice(1);\n    })\n    .join('');\n}\n\n// Formatação base\nfunction formatNameBase(name) {\n  return name\n    .toLowerCase()\n    .split(/\\s+/)\n    .map(capitalizeToken)\n    .join(' ');\n}\n\n// Aplica siglas\nfunction aplicarSiglasMaiusculas(name) {\n  let result = name;\n\n  siglasMaiusculas.forEach(sigla => {\n    const pattern = sigla.replace(/[:\\/\\-]/g, m => '\\\\' + m);\n    const regex = new RegExp(pattern, 'gi');\n    result = result.replace(regex, sigla);\n  });\n\n  return result;\n}\n\n// Processa instituições\nconst formattedNames = institutions\n  .filter(inst => !nomesBloqueadosRaw.has(inst.name.toUpperCase()))\n  .map(inst => {\n    const rawUpper = inst.name.toUpperCase();\n\n    if (overridesExatos[rawUpper]) {\n      return overridesExatos[rawUpper];\n    }\n\n    let nome = formatNameBase(inst.name);\n    nome = aplicarSiglasMaiusculas(nome);\n    return nome;\n  })\n  // remove duplicados\n  .filter((v, i, arr) => arr.indexOf(v) === i)\n  // ordena\n  .sort((a, b) =>\n    a.localeCompare(b, 'pt-BR', { sensitivity: 'base' })\n  );\n\n// ✅ SAÍDA CORRETA PARA TYPEBOT (lista)\nreturn [\n  {\n    json: {\n      data: formattedNames\n    }\n  }\n];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[880,1104],"id":"43c24053-df66-474a-8caa-a1da53290060","name":"Code in JavaScript25"},{"parameters":{"content":"## SOBRE AS INSTITUIÇÕES","height":224,"width":816,"color":4},"type":"n8n-nodes-base.stickyNote","position":[448,1040],"typeVersion":1,"id":"5581364b-9cf0-49f6-91f0-fbcf0d048fd7","name":"Sticky Note7"},{"parameters":{"respondWith":"allIncomingItems","options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.4,"position":[1072,1104],"id":"52ecc09e-b188-47c9-9a49-98d0813a50e3","name":"Respond to Webhook50"},{"parameters":{"path":"974020c1-3f6e-4731-a869-23e6e4f63f56","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[496,1104],"id":"2c89eaf6-e480-47d6-b42e-fa87ca8fa9e5","name":"Webhook6","webhookId":"974020c1-3f6e-4731-a869-23e6e4f63f56"},{"parameters":{"content":"## BUSCAR ESCOLAS SOBRE\n","height":224,"width":816,"color":4},"type":"n8n-nodes-base.stickyNote","position":[448,784],"typeVersion":1,"