ador por escola\nconst schoolsMap = {};\n\n// Combo bloqueado\nconst blockedSchool = \"universidad columbia del paraguay\";\nconst blockedCourse = \"medicina\";\n\n// Title Case simples (inicial maiúscula)\nfunction toTitleCase(str) {\n  return (str || \"\")\n    .toLowerCase()\n    .split(\" \")\n    .filter(Boolean)\n    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))\n    .join(\" \");\n}\n\nfor (const entry of data) {\n  const modality = entry?.content_modality_name;\n\n  // FILTRO: só presenciais\n  if (!modality || modality.toLowerCase() !== \"presencial\") {\n    continue;\n  }\n\n  const schoolName = entry?.school_name || \"SEM_NOME\";\n  const courseName = entry?.course_name || \"\";\n\n  const schoolLower = schoolName.toLowerCase();\n  const courseLower = courseName.toLowerCase();\n\n  // IGNORA combo específico\n  if (schoolLower === blockedSchool && courseLower === blockedCourse) {\n    continue;\n  }\n\n  if (!schoolsMap[schoolName]) {\n    schoolsMap[schoolName] = new Set();\n  }\n\n  if (courseName) {\n    schoolsMap[schoolName].add(courseName);\n  }\n}\n\n// Monta blocos por instituição\nconst blocos = Object.entries(schoolsMap)\n  .filter(([_, coursesSet]) => coursesSet.size > 0)\n  .map(([schoolName, coursesSet]) => {\n    const cursos = Array.from(coursesSet).map(toTitleCase).sort();\n    const linhas = [`## **${toTitleCase(schoolName)}**`, ...cursos];\n    return linhas.join(\"\\n\");\n  });\n\n// Texto final (Markdown)\nconst textoFinal = blocos.join(\"\\n\\n\");\n\n// Mensagem padrão se não achar nada\nconst saida = textoFinal || \"Nenhuma oferta presencial encontrada.\";\n\n// Retorna no formato do n8n\nreturn [\n  {\n    json: {\n      texto: saida,\n    },\n  },\n];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-1248,704],"id":"affa945d-4ef9-473a-a36a-4732a09c71ea","name":"Code in JavaScript1"},{"parameters":{"httpMethod":"POST","path":"83241cdf-b066-40b9-b258-91ac2713519f","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-1824,704],"id":"40689aa8-db02-4479-94be-b96a9c4acce1","name":"Webhook1","webhookId":"83241cdf-b066-40b9-b258-91ac2713519f"},{"parameters":{"respondWith":"allIncomingItems","options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.4,"position":[-1056,704],"id":"986b6bdf-7df9-45bf-a3ce-aca1508a9f9e","name":"Respond to Webhook"},{"parameters":{"assignments":{"assignments":[{"id":"598075a4-2a7a-43ae-8722-b14c88fbf9f0","name":"content_level","value":"={{ $json.body.nivel }}","type":"string"},{"id":"e0864444-614f-4dcc-9068-2561098bb584","name":"city","value":"={{ $json.body.cidade }}","type":"string"},{"id":"321e18b7-21ff-48c3-aa2a-6fa5641c815d","name":"state","value":"={{ $json.body.uf }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-1632,704],"id":"a497f234-7d06-4147-892c-f3609a005037","name":"Edit Fields"},{"parameters":{"content":"## BUSCAR CURSOS PRESENCIAIS\n\n","height":224,"width":1008,"color":4},"type":"n8n-nodes-base.stickyNote","position":[-1872,640],"typeVersion":1,"id":"1ffc5979-461b-4678-a9b4-0492fc03bbd2","name":"Sticky Note1"},{"parameters":{"url":"https://api.bolsamaisbrasil.com.br/schools/get","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[688,592],"id":"2a78472f-e2d7-491d-8526-ac11b2aa3c3e","name":"HTTP Request1"},{"parameters":{"jsCode":"// Nó \"Code\" no n8n\n// Mode: \"Run Once for All Items\"\n\nconst dataString = items[0].json.data;\n\n// Converte a string JSON em array de objetos\nconst institutions = JSON.parse(dataString);\n\n// Nomes a bloquear com base no \"name\" original (sem depender da formatação)\nconst nomesBloqueadosRaw = new Set([\n  'BLACK DO BOLSA',\n  'ANHANGUERA/UNOPAR',\n  'EJA + TÉCNICO',\n  'GRUPO BOLSA MAIS BRASIL - UNICORP',\n]);\n\n// Overrides de nome EXATO (saem exatamente assim no output)\nconst overridesExatos = {\n  'MEUPROF': 'MeuProf',\n  'UNINORTE': 'UniNorte',\n  'UNIMAIS': 'UniMais',\n};\n\n// Siglas que devem ficar em MAIÚSCULO onde aparecerem no nome\nconst siglasMaiusculas = [\n  'CENTEC',\n  'UNICV',\n  'CPET',\n  'CURES',\n  'FAMA',\n  'FAMEC',\n  'FAPI',\n  'FASPEC',\n  'FASTECH',\n  'FUCAPI',\n  'LFG',\n  'U:VERSE',\n  'UFBRA',\n  'UNAMA',\n  'UNESC',\n  'UNG',\n  'UNI7',\n  'UNIC',\n  'UNIDERP',\n  'UNIFAEL',\n  'UNIFATECIE',\n  'UNIME',\n  'UNIMEP',\n  'UNOPAR',\n  'UPTIME',\n];\n\n// Função que capitaliza pedaços separados por / e -\nfunction capitalizeToken(token) {\n  return token\n    .split(/([\\/\\-]+)/) // mantém / e - no array\n    .map(chunk => {\n      if (/^[\\/\\-]+$/.test(chunk)) return chunk; // se for só / ou -, mantém\n      if (!chunk) return chunk;\n\n      const lower = chunk.toLowerCase();\n      return lower.charAt(0).toUpperCase() + lower.slice(1);\n    })\n    .join('');\n}\n\n// Formata o nome base: cada palavra com inicial maiúscula\nfunction formatNameBase(name) {\n  return name\n    .toLowerCase()\n    .split(/\\s+/)       // quebra por espaço\n    .map(capitalizeToken)\n    .join(' ');\n}\n\n// Aplica as siglas em MAIÚSCULO dentro do nome já formatado\nfunction aplicarSiglasMaiusculas(name) {\n  let result = name;\n\n  siglasMaiusculas.forEach(sigla => {\n    // escapa caracteres especiais como : / -\n    const pattern = sigla.replace(/[:\\/\\-]/g, m => '\\\\' + m);\n    const regex = new RegExp(pattern, 'gi'); // case-insensitive\n\n    result = result.replace(regex, sigla);\n  });\n\n  return result;\n}\n\n// Gera lista de nomes formatados, com filtros e regras especiais\nconst formattedNames = institutions\n  // remove instituições bloqueadas com base no nome original\n  .filter(inst => !nomesBloqueadosRaw.has(inst.name.toUpperCase()))\n  .map(inst => {\n    const rawUpper = inst.name.toUpperCase();\n\n    // Se tiver override exato, usa ele e ignora o restante\n    if (overridesExatos[rawUpper]) {\n      return overridesExatos[rawUpper];\n    }\n\n    // Formata normalmente e depois aplica siglas maiúsculas\n    let nome = formatNameBase(inst.name);\n    nome = aplicarSiglasMaiusculas(nome);\n    return nome;\n  });\n\n// Ordena em ordem alfabética (ignorando acentos/maiúsculas)\nformattedNames.sort((a, b) =>\n  a.localeCompare(b, 'pt-BR', { sensitivity: 'base' })\n);\n\n// Cria uma string com um nome por linha\nconst lista = formattedNames.join('\\n');\n\n// Retorna um único item com a lista em texto puro\nreturn [\n  {\n    json: {\n      lista\n    }\n  }\n];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[880,592],"id":"2e00af00-7964-4527-8d42-b8c4ed35182c","name":"Code in JavaScript"},{"parameters":{"content":"## BUSCAR ESCOLAS\n\n","height":224,"width":816,"color":4},"type":"n8n-nodes-base.stickyNote","position":[448,528],"typeVersion":1,"id":"872e9f03-23de-4204-ad88-89a30c985cda","name":"Sticky Note2"},{"parameters":{"path":"0f7244d0-4750-4af0-a7ac-83e9e68b0b7e","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[496,592],"id":"cbb075b7-f1ee-4d19-adec-38359b80cadb","name":"Webhook2","webhookId":"0f7244d0-4750-4af0-a7ac-83e9e68b0b7e"},{"parameters":{"respondWith":"allIncomingItems","options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.4,"position":[1072,592],"id":"a07a6eb3-537c-47c4-96e7-9749aedd265c","name":"Respond to Webhook1"},{"parameters":{"content":"## SOBRE O CURSO\n","height":368,"width":1328,"color":4},"type":"n8n-nodes-base.stickyNote","position":[-1872,896],"typeVersion":1,"id":"b25b0927-690f-489b-97b2-ad8d004a0171","name":"Sticky Note3"},{"parameters":{"respondWith":"allIncomingItems","options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.4,"position":[-736,960],"id":"683fe4e8-f8bf-46d5-bf0d-d14dc954a7e9","name":"Respond to Webhook2"},{"parameters":{"httpMethod":"POST","path":"bf86077b-6492-4f8c-965d-5c19ddf1b5db","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-1824,960],"id":"35d0f218-8283-4f75-86ad-923b1ca1da4c","name":"Webhook3","webhookId":"bf86077b-6492-4f8c-965d-5c19ddf1b5db"},{"parameters":{"promptType":"define","text":"=curso escolhido: {{ $('Webhook3').item.json.body.curso }}\n\nlista de cursos: {{ $json.texto }}","options":{"systemMessage":"=Você é um agente que recebe (1) um curso buscado e (2) uma lista de cursos por instituição.\nSua tarefa é: encontrar o curso exato OU sugerir um curso próximo existente na lista.\n\nENTRADA\n- Curso escolhido: {{ $('Webhook3').item.json.body.curso }}\n- Lista de cursos disponíveis: {{ $json.texto }}\n\nREGRA DE EXCLUSÃO (obrigatório)\n- Ignore totalmente a instituição \"Black Do Bolsa\".\n- Se somente \"Black Do Bolsa\" tiver algo, trate como se não existisse.\n\nCOMO LER A LISTA (obrigatório)\n- Cada instituição começa com: \"## **NOME**\"\n- As linhas seguintes (até a próxima instituição) são cursos dessa instituição.\n\nNORMALIZAÇÃO (use em tudo para comparar)\n- minúsculas\n- remover acentos\n- remover pontuação/símbolos (hífen, barra, vírgula, travessão etc.)\n- trocar múltiplos espaços por 1\n- aparar espaços nas pontas\n\nNBSP (obrigatório)\n- Após o nome do curso em \"**Nome do curso:**\", adicione exatamente 1 NBSP U+00A0 (este: \" \").\n- NÃO use espaço comum e NÃO use U+202F.\n\nÁREAS (para sugestão quando não existir match exato)\nTERMO DE ÁREA (após normalização) se o usuário digitar algo como:\n- SAUDE: \"saude\", \"area da saude\", \"area de saude\"\n- TI: \"ti\", \"tecnologia\", \"area da tecnologia\", \"computacao\", \"informatica\"\n- NEGOCIOS: \"negocios\", \"gestao\", \"area de negocios\", \"area de gestao\"\n- EDUCACAO: \"educacao\", \"area de educacao\"\n- ENGENHARIAS: \"engenharias\", \"engenharia\", \"area de engenharias\"\n\nCURSOS POR ÁREA (para achar “próximos”)\n- SAÚDE: Enfermagem, Farmácia, Fisioterapia, Nutrição, Biomedicina, Fonoaudiologia, Terapia Ocupacional, Radiologia, Estética e Cosmética, Podologia, Gestão Hospitalar, Agente Comunitário, Terapias Integrativas e Complementares, Educação Física.\n- TI: Análise e Desenvolvimento de Sistemas, Sistemas de Informação, Ciência da Computação, Engenharia de Software, Engenharia da Computação, Redes de Computadores, Segurança da Informação, Sistemas para Internet, Jogos Digitais.\n- NEGÓCIOS: Administração, Ciências Contábeis, Gestão Financeira, Marketing, Logística, Gestão de Recursos Humanos, Processos Gerenciais, Gestão Pública, Comércio Exterior, Gestão Comercial, Negócios Imobiliários, Hotelaria.\n- EDUCAÇÃO: Pedagogia, Letras (todas variações), Matemática, História, Geografia, Educação Especial, Processos Escolares, Psicopedagogia.\n- ENGENHARIAS: qualquer curso cujo nome original comece com \"Engenharia\".\n\nDECISÃO (obrigatório, simples)\n1) Parseie a lista em:\n   - Instituição -> [cursos originais]\n   - Instituição -> [cursos normalizados]\n   (ignorando \"Black Do Bolsa\")\n\n2) Match exato:\n   - Se curso escolhido (normalizado) existir exatamente em 1+ instituições:\n     - Use o FORMATO A.\n     - \"Nome do curso\" deve ser o nome original como aparece na lista (pegue do primeiro match).\n     - \"Instituições disponíveis\" = TODAS as instituições que têm esse match.\n\n3) Se NÃO houver match exato, faça sugestão (FORMATO B):\n   3.1) Descubra uma “área alvo” para sugerir:\n       - Se o usuário digitou um TERMO DE ÁREA, a área alvo é essa.\n       - Senão, se o curso escolhido for um curso listado dentro de alguma área (ex.: “Enfermagem” está em SAÚDE),\n         use essa área como área alvo.\n       - Senão, área alvo = indefinida.\n\n   3.2) Escolha 1 curso sugerido que EXISTA NA LISTA:\n       - Se área alvo definida:\n         - escolha um curso dessa área que exista na lista, na seguinte prioridade:\n           - SAÚDE: Farmácia > Biomedicina > Fisioterapia > Nutrição > Terapia Ocupacional > Radiologia > Educação Física\n           - TI: Análise e Desenvolvimento de Sistemas > Sistemas de Informação > Ciência da Computação > Redes de Computadores > Segurança da Informação\n           - NEGÓCIOS: Administração > Ciências Contábeis > Gestão de Recursos Humanos > Logística > Marketing\n           - EDUCAÇÃO: Pedagogia > Letras > História > Matemática > Geografia > Educação Especial\n           - ENGENHARIAS: qualquer \"Engenharia ...\" que exista\n         - se nenhuma da prioridade existir, pegue qualquer curso dessa área que exista.\n       - Se área alvo indefinida:\n         - pegue o curso existente na lista mais “parecido” por palavras (mesmas palavras relevantes),\n           ignorando palavras comuns como: de, da, do, das, dos, e, em, para.\n         - se não existir semelhança real, use o FORMATO C.\n\n   3.3) Envie todas instituições que possuem o curso que deu match:\n       - A instituição deve oferecer o curso sugerido (match exato após normalização).\n       - Envie a lista completa de instituições com este curso.\n\nREGRAS ANTI-INVENÇÃO (obrigatório)\n- É proibido:\n  - citar curso que não exista na lista (fora do “Curso escolhido” do usuário, que pode não existir)\n  - listar instituição que não ofereça o curso (exato ou sugerido)\n  - retornar lista vazia em “Instituições disponíveis” no Formato A\n- Se não conseguir escolher um curso sugerido que exista, use o Formato C.\n\nRESUMO (obrigatório)\n- No máximo 8 tópicos.\n- Cada tópico: \"- **Tema** (descrição super curta)\" com no máximo 8 palavras nos parênteses.\n- Não repita o nome do curso dentro dos tópicos.\n- Nada de placeholders.\n\n\nFORMATO A (curso exato encontrado)\nEncontrei o curso que você procura:\n**Nome do curso:** <curso> \n**Instituições disponíveis:**\n- <instituição 1>\n- <instituição 2>\n- ...\n\n**Nele você irá estudar:**\n- **Tema principal 1** (descrição super curta)\n- **Tema principal 2** (descrição super curta)\n- **Tema principal 3** (descrição super curta)\n- **Tema principal 4** (descrição super curta)\n- **Tema principal 5** (descrição super curta)\n- **Tema principal 6** (descrição super curta)\n- **Tema principal 7** (descrição super curta)\n- **Tema principal 8** (descrição super curta)\n\nFORMATO B (curso não existe, mas sugeri um próximo)\nNão encontrei o curso que você procura, mas achei um bem próximo:\n**Instituição:** <Lista de instituições que possuem o curso>\n**Nome do curso:** <curso> \n\n**Nele você irá estudar:**\n- **Tema principal 1** (descrição super curta)\n- **Tema principal 2** (descrição super curta)\n- **Tema principal 3** (descrição super curta)\n- **Tema principal 4** (descrição super curta)\n- **Tema principal 5** (descrição super curta)\n- **Tema principal 6** (descrição super curta)\n- **Tema principal 7** (descrição super curta)\n- **Tema principal 8** (descrição super curta)\n\nFORMATO C (sem sugestão real)\nNão encontrei o curso que você procura e não achei nada próximo.\n"}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3,"position":[-1056,960],"id":"32d81228-da6c-4617-8395-d3a7e4e09af1","name":"AI Agent1"},{"parameters":{"model":{"__rl":true,"value":"o4-mini","mode":"list","cachedResultName":"o4-mini"},"builtInTools":{},"options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","typeVersion":1.3,"position":[-1056,1136],"id":"d0aa4a93-828b-4e64-a6c0-559022f7f26e","name":"OpenAI Chat Model","credentials":{"openAiApi":{"id":"BCQpx8PlGkX0l2ce","name":"Automações"}}},{"parameters":{"resource":"fileFolder","filter":{"driveId":{"mode":"list","value":"My Drive"},"folderId":{"__rl":true,"value":"179hYiF1D2P6atDscDRWUrX_-9TzKTFNI","mode":"list","cachedResultName":"MATRIZ CURRICULAR CPET","cachedResultUrl":"https://drive.google.com/drive/folders/179hYiF1D2P6atDscDRWUrX_-9TzKTFNI"}},"options":{}},"type":"n8n-nodes-base.googleDrive","typeVersion":3,"position":[-1344,1312],"id":"26cfa013-04fe-40d0-a06f-ea6305638984","name":"Search files and folders","credentials":{"googleDriveOAuth2Api":{"id":"wlrdgIA54xv5ULIo","name":"Drive"}}},{"parameters":{"path":"06cfbed4-f315-4d01-a0aa-3657789ab0fd","responseMode":"responseNode","options":{}},"type":