parameters":{"assignments":{"assignments":[{"id":"40d1ae83-3f94-4561-b812-5e5d967a1ff0","name":"instituição","value":"={{ $json.body.data[0][\"instituição\"] }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-1632,-224],"id":"370be756-1faa-41e2-9a55-759c511ba69f","name":"Edit Fields2"},{"parameters":{"promptType":"define","text":"={{ $json[\"instituição\"] }}","options":{"systemMessage":"=Você é um assistente que escreve resumos institucionais em português (Brasil),\ncom tom positivo, profissional e cuidadoso.\n\nVocê receberá como entrada o nome de uma instituição de ensino.\n\nOBJETIVO\nGerar um resumo institucional organizado, claro e visualmente agradável,\nutilizando emojis com moderação, mantendo apenas informações genéricas\ne seguras, sem inventar fatos.\n\nREGRAS OBRIGATÓRIAS\n- Não invente dados específicos (notas do MEC, anos de fundação, prêmios,\n  parcerias, empregabilidade, números ou reconhecimentos).\n- Não afirme credenciamento, autorização ou reconhecimento oficial\n  a menos que isso esteja explicitamente confirmado.\n- Quando a informação não for certa, use expressões seguras como:\n  “conforme divulgação institucional”, “de acordo com informações públicas”,\n  ou “deve ser verificado em canais oficiais”.\n- Não use linguagem negativa.\n- Não faça promessas ou comparações.\n- Não inclua fontes, links ou comentários extras.\n\nFORMATO DE SAÍDA (OBRIGATÓRIO)\n\n## 🎓 <Nome da instituição>\n\n### 📘 Visão geral  \nTexto curto (1–2 frases) descrevendo a instituição de forma genérica e positiva,\nsem afirmar fatos específicos.\n\n### 💡 Proposta de valor  \n- Emoji + benefício genérico (3 bullets no máximo)\n- Linguagem neutra, positiva e institucional\n\n### 🧪 Cursos e áreas de atuação  \n- Descrever áreas de atuação de forma ampla  \n- Se não houver certeza, usar: “cursos na área de … conforme divulgação institucional”\n\n### 🏛️ Credenciamento e regularidade  \n- Usar linguagem cautelosa  \n- Se não houver certeza absoluta, escrever:\n  “A situação de credenciamento e autorizações deve ser verificada em canais oficiais.”\n\n### 🌱 Por que considerar  \n- 2 a 3 bullets curtos\n- Sempre positivos, genéricos e cuidadosos\n\nENTRADA\nNome da instituição: {{ $json.instituicao_nome }}\n\nSAÍDA\nEntregar apenas o texto final no formato acima, com títulos, subtítulos,\nbullets e emojis, sem explicações adicionais.\n"}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3,"position":[-1440,-224],"id":"814f5b3a-ceb8-4f57-99e1-21f18eb7bde1","name":"AI Agent"},{"parameters":{"model":{"__rl":true,"value":"gpt-4.1-nano","mode":"list","cachedResultName":"gpt-4.1-nano"},"builtInTools":{},"options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","typeVersion":1.3,"position":[-1440,-48],"id":"15364c6e-354b-4ac4-8737-5df1dc730038","name":"OpenAI Chat Model1","credentials":{"openAiApi":{"id":"BCQpx8PlGkX0l2ce","name":"Automações"}}},{"parameters":{"httpMethod":"POST","path":"b5f27ec4-80ad-49a3-8651-2ff3c44a0095","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-1824,-224],"id":"6ec351ac-ac94-445d-90b6-f7018e00c58c","name":"Webhook","webhookId":"b5f27ec4-80ad-49a3-8651-2ff3c44a0095"},{"parameters":{"url":"https://api.bolsamaisbrasil.com.br/schools/get","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[688,1104],"id":"a61ca309-8761-411b-ae8c-9de1518ad0b0","name":"HTTP Request2"},{"parameters":{"jsCode":"// Nó \"Code\" no n8n\n// Mode: Run Once for All Items\n\nconst dataString = items[0].json.data;\n\n// Converte a string JSON em array de objetos\nconst institutions = JSON.parse(dataString);\n\n// Nomes a bloquear (comparação pelo nome ORIGINAL)\nconst nomesBloqueadosRaw = new Set([\n  'BLACK DO BOLSA',\n  'ANHANGUERA/UNOPAR',\n  'EJA + TÉCNICO',\n  'GRUPO BOLSA MAIS BRASIL - UNICORP',\n]);\n\n// Overrides exatos\nconst overridesExatos = {\n  'MEUPROF': 'MeuProf',\n  'UNINORTE': 'UniNorte',\n  'UNIMAIS': 'UniMais',\n};\n\n// Siglas que devem permanecer em MAIÚSCULO\nconst siglasMaiusculas = [\n  'CENTEC',\n  'UNICV',\n  'CPET',\n  'CURES',\n  'FAMA',\n  'FAMEC',\n  'FAPI',\n  'FASPEC',\n  'FASTECH',\n  'FUCAPI',\n  'LFG',\n  'U:VERSE',\n  'UFBRA',\n  'UNAMA',\n  'UNESC',\n  'UNG',\n  'UNI7',\n  'UNIC',\n  'UNIDERP',\n  'UNIFAEL',\n  'UNIFATECIE',\n  'UNIME',\n  'UNIMEP',\n  'UNOPAR',\n  'UPTIME',\n];\n\n// Capitaliza tokens mantendo / e -\nfunction capitalizeToken(token) {\n  return token\n    .split(/([\\/\\-]+)/)\n    .map(chunk => {\n      if (/^[\\/\\-]+$/.test(chunk)) return chunk;\n      if (!chunk) return chunk;\n\n      const lower = chunk.toLowerCase();\n      return lower.charAt(0).toUpperCase() + lower.slice(1);\n    })\n    .join('');\n}\n\n// Formatação base\nfunction formatNameBase(name) {\n  return name\n    .toLowerCase()\n    .split(/\\s+/)\n    .map(capitalizeToken)\n    .join(' ');\n}\n\n// Aplica siglas\nfunction aplicarSiglasMaiusculas(name) {\n  let result = name;\n\n  siglasMaiusculas.forEach(sigla => {\n    const pattern = sigla.replace(/[:\\/\\-]/g, m => '\\\\' + m);\n    const regex = new RegExp(pattern, 'gi');\n    result = result.replace(regex, sigla);\n  });\n\n  return result;\n}\n\n// Processa instituições\nconst formattedNames = institutions\n  .filter(inst => !nomesBloqueadosRaw.has(inst.name.toUpperCase()))\n  .map(inst => {\n    const rawUpper = inst.name.toUpperCase();\n\n    if (overridesExatos[rawUpper]) {\n      return overridesExatos[rawUpper];\n    }\n\n    let nome = formatNameBase(inst.name);\n    nome = aplicarSiglasMaiusculas(nome);\n    return nome;\n  })\n  // remove duplicados\n  .filter((v, i, arr) => arr.indexOf(v) === i)\n  // ordena\n  .sort((a, b) =>\n    a.localeCompare(b, 'pt-BR', { sensitivity: 'base' })\n  );\n\n// ✅ SAÍDA CORRETA PARA TYPEBOT (lista)\nreturn [\n  {\n    json: {\n      data: formattedNames\n    }\n  }\n];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[880,1104],"id":"43c24053-df66-474a-8caa-a1da53290060","name":"Code in JavaScript25"},{"parameters":{"content":"## SOBRE AS INSTITUIÇÕES","height":224,"width":816,"color":4},"type":"n8n-nodes-base.stickyNote","position":[448,1040],"typeVersion":1,"id":"5581364b-9cf0-49f6-91f0-fbcf0d048fd7","name":"Sticky Note7"},{"parameters":{"respondWith":"allIncomingItems","options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.4,"position":[1072,1104],"id":"52ecc09e-b188-47c9-9a49-98d0813a50e3","name":"Respond to Webhook50"},{"parameters":{"path":"974020c1-3f6e-4731-a869-23e6e4f63f56","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[496,1104],"id":"2c89eaf6-e480-47d6-b42e-fa87ca8fa9e5","name":"Webhook6","webhookId":"974020c1-3f6e-4731-a869-23e6e4f63f56"},{"parameters":{"content":"## BUSCAR ESCOLAS SOBRE\n","height":224,"width":816,"color":4},"type":"n8n-nodes-base.stickyNote","position":[448,784],"typeVersion":1,"id":"44e03dcf-9716-4088-9797-cba8689b56bf","name":"Sticky Note8"},{"parameters":{"path":"bf378bcb-4819-4563-aa17-8944bb289b83","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[496,848],"id":"b5551c91-2c2b-4e64-852b-27d86a18cb06","name":"Webhook7","webhookId":"bf378bcb-4819-4563-aa17-8944bb289b83"},{"parameters":{"operation":"getAll","team":"9014888338","space":"90144313780","folderless":true,"list":"901412918512","filters":{"statuses":["instituições"]}},"type":"n8n-nodes-base.clickUp","typeVersion":1,"position":[688,848],"id":"f31b5608-f501-46db-8e9b-d4002648e43e","name":"Get many tasks","credentials":{"clickUpApi":{"id":"74vuorPFMovlnboz","name":"Bolsa"}}},{"parameters":{"jsCode":"// Pega o \"name\" de cada item, sem alterar nada\nconst nomes = $input.all()\n  .map(i => i.json?.name)\n  .filter(n => typeof n === 'string' && n.trim().length > 0);\n\n// (opcional) remove duplicados exatos\nconst unicos = [...new Set(nomes)];\n\n// Ordena alfabeticamente (sem alterar o texto original)\nunicos.sort((a, b) => a.localeCompare(b, 'pt-BR', { sensitivity: 'base' }));\n\n// Formato certo pro Typebot (lista em \"data\")\nreturn [\n  {\n    json: {\n      data: unicos\n    }\n  }\n];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[880,848],"id":"51276e12-8bbb-4182-981c-d856740b047d","name":"Code in JavaScript26"},{"parameters":{"options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[1072,848],"id":"4a6aba87-4efa-40b5-a42c-44a1170935f2","name":"Respond to Webhook51"},{"parameters":{"content":"## BUSCAR ESCOLAS SOBRE\n","height":224,"width":1008,"color":4},"type":"n8n-nodes-base.stickyNote","position":[-1872,112],"typeVersion":1,"id":"167bf62b-0662-4d20-9c4b-9d7dec218996","name":"Sticky Note9"},{"parameters":{"operation":"getAll","team":"9014888338","space":"90144313780","folderless":true,"list":"901412918512","filters":{"statuses":["instituições"]}},"type":"n8n-nodes-base.clickUp","typeVersion":1,"position":[-1632,176],"id":"1aed5ff3-68d3-4d3a-a309-6357e3bef529","name":"Get many tasks1","credentials":{"clickUpApi":{"id":"74vuorPFMovlnboz","name":"Bolsa"}}},{"parameters":{"respondWith":"allIncomingItems","options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[-1056,176],"id":"dfe7b53d-4d2e-4054-bb0b-4cebed702218","name":"Respond to Webhook52"},{"parameters":{"httpMethod":"POST","path":"923fb588-3ec4-4491-98bc-1d603d2a2687","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-1824,176],"id":"3607a2fb-f993-4482-bacd-433240e5626c","name":"Webhook8","webhookId":"923fb588-3ec4-4491-98bc-1d603d2a2687"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"b47f131f-e0f4-4bfc-b127-676c5a954207","leftValue":"={{ $json.name }}","rightValue":"={{ $('Webhook8').item.json.body.data[0][\"instituição\"] }}","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.filter","typeVersion":2.3,"position":[-1440,176],"id":"2dc4dd7e-b1c1-43ab-be1f-78f65f2b102c","name":"Filter23"},{"parameters":{"jsCode":"// n8n Code node (JavaScript)\n// Entrada: task ClickUp com `name` e `custom_fields`\n// Saída: [{ json: { whatsapp_text: \"...\" } }, ...]\n\nconst FIELD_IDS = {\n  pagaRecorrencia: \"43649d5f-354c-4e76-8cbc-e9b997e1bc3f\",\n  comissaoRecorrencia: \"18d3c0cb-8e9e-44f8-8652-1a606906404c\",\n  comissaoAdesao: \"f089afb7-99ff-443d-b8fa-8595815ed42c\",\n  observacoes: \"7e29fffb-4e38-4fa5-88fa-0a2c3678383d\",\n};\n\nfunction toStr(v) {\n  if (v === null || v === undefined) return \"\";\n  return String(v).trim();\n}\n\nfunction stripAccents(s) {\n  return toStr(s).normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\");\n}\n\nfunction buildCustomFieldMap(task) {\n  const map = new Map();\n  for (const cf of task.custom_fields ?? []) map.set(cf.id, cf);\n  return map;\n}\n\nfunction getCustomValue(cf) {\n  if (!cf) return null;\n  if (cf.value !== undefined && cf.value !== null) return cf.value;\n  if (cf.value_richtext !== undefined && cf.value_richtext !== null) return cf.value_richtext;\n  return null;\n}\n\nfunction normalizeYesNoFromDropdown(cf) {\n  if (!cf) return \"\";\n  const rawValue = getCustomValue(cf);\n  const opts = cf.type_config?.options ?? [];\n\n  const match =\n    opts.find(o => o.orderindex === rawValue) ||\n    opts.find(o => String(o.orderindex) === String(rawValue));\n\n  const label = match?.name ? toStr(match.name) : toStr(rawValue);\n\n  const norm = stripAccents(label).toLowerCase();\n  if (norm === \"nao\" || norm === \"no\") return \"Não\";\n  if (norm === \"sim\" || norm === \"yes\") return \"Sim\";\n\n  return label ? label.charAt(0).toUpperCase() + label.slice(1).toLowerCase() : \"\";\n}\n\nfunction isNao(v) {\n  const norm = stripAccents(v).toLowerCase();\n  return norm === \"nao\" || norm === \"no\";\n}\n\n// Sempre garante o formato final \"%*\"\nfunction formatPercent(v) {\n  let s = toStr(v);\n  if (!s) return \"\";\n\n  s = s.replace(/\\s+/g, \"\");\n  s = s.replace(/%\\*?$/, \"\");\n  return `${s}%*`;\n}\n\n// Observações em tópicos\nfunction formatObservacoesBullets(v) {\n  const s = toStr(v);\n  if (!s) return [\"• Nenhuma Observação\"];\n\n  const parts = s\n    .split(/\\r?\\n|;/)\n    .map(p => p.trim())\n    .filter(Boolean);\n\n  if (parts.length === 0) return [\"• Nenhuma Observação\"];\n\n  return parts.map(p => (p.startsWith(\"•\") ? p : `• ${p}`));\n}\n\nfunction getTaskFromItem(itemJson) {\n  if (itemJson?.custom_fields && itemJson?.name) return itemJson;\n  if (Array.isArray(itemJson?.input) && itemJson.input[0]?.custom_fields) return itemJson.input[0];\n  if (Array.isArray(itemJson) && itemJson[0]?.custom_fields) return itemJson[0];\n  return itemJson;\n}\n\nconst items = $input.all();\n\nreturn items.map((item) => {\n  const task = getTaskFromItem(item.json);\n  const fields = buildCustomFieldMap(task);\n\n  const Nome = toStr(task?.name);\n  const PagaRecorrencia = normalizeYesNoFromDropdown(fields.get(FIELD_IDS.pagaRecorrencia));\n  const ComissaoRecorrencia = formatPercent(getCustomValue(fields.get(FIELD_IDS.comissaoRecorrencia)));\n  const ComissaoAdesao = formatPercent(getCustomValue(fields.get(FIELD_IDS.comissaoAdesao)));\n  const ObservacoesBullets = formatObservacoesBullets(getCustomValue(fields.get(FIELD_IDS.observacoes)));\n\n  const lines = [];\n  lines.push(`📌 *${Nome}*`);\n  lines.push(\"\");\n  lines.push(`💳 *Paga recorrência:* ${PagaRecorrencia}`);\n\n  // regra: se for \"Não\", não exibe comissão recorrência\n  if (!isNao(PagaRecorrencia)) {\n    lines.push(`🔁 *Comissão recorrência:* ${ComissaoRecorrencia}`);\n  }\n\n  lines.push(`💰 *Comissão de adesão:* ${ComissaoAdesao}`);\n\n  // ✅ truque: \":\" fora do negrito para o WhatsApp respeitar a quebra\n  lines.push(`📝 *Observações importantes*:\\n${ObservacoesBullets.join(\"\\n\")}`);\n\n  return {\n    json: {\n    