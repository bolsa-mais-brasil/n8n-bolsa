= items[0].json;\n\n// Se vier como array\nif (Array.isArray(raw)) {\n  raw = raw[0];\n}\n\n// Pega o array \"data\" onde estão as ofertas\nconst data = raw.data || [];\n\n// Definição do combo que deve ser ignorado\nconst blockedSchool = 'universidad columbia del paraguay';\nconst blockedCourse = 'medicina';\n\n// Função para deixar só iniciais em maiúsculo\nfunction toTitleCase(str) {\n  return (str || '')\n    .toLowerCase()\n    .split(' ')\n    .filter(Boolean)\n    .map(word => word.charAt(0).toUpperCase() + word.slice(1))\n    .join(' ');\n}\n\n// Normaliza modalidade para cabeçalho (PRESENCIAL, EAD, SEMIPRESENCIAL, ETC)\nfunction formatModality(mod) {\n  const m = (mod || '').toString().trim().toLowerCase();\n  if (!m) return 'SEM MODALIDADE';\n  if (m === 'presencial') return 'PRESENCIAL';\n  if (m === 'ead' || m === 'e-ad' || m === 'ensino a distância' || m === 'ensino a distancia') return 'EAD';\n  if (m === 'semipresencial' || m === 'semi-presencial') return 'SEMIPRESENCIAL';\n  return m.toUpperCase();\n}\n\n// Ordenação desejável: PRESENCIAL, SEMIPRESENCIAL, EAD, depois resto (A-Z)\nfunction modalitySortKey(modality) {\n  const m = (modality || '').toUpperCase();\n  if (m === 'PRESENCIAL') return '0_PRESENCIAL';\n  if (m === 'SEMIPRESENCIAL') return '1_SEMIPRESENCIAL';\n  if (m === 'EAD') return '2_EAD';\n  return '9_' + m;\n}\n\n// Agora: modalitiesMap[MODALIDADE][INSTITUICAO] = Set(CURSOS)\nconst modalitiesMap = {};\n\nfor (const entry of data) {\n  const modality = formatModality(entry.content_modality_name);\n\n  const schoolName = entry.school_name || 'SEM NOME';\n  const courseName = entry.course_name;\n\n  // Se não tiver curso, ignora\n  if (!courseName) continue;\n\n  const schoolLower = (schoolName || '').toLowerCase();\n  const courseLower = (courseName || '').toLowerCase();\n\n  // IGNORA: Universidad Columbia Del Paraguay / MEDICINA\n  if (schoolLower === blockedSchool && courseLower === blockedCourse) {\n    continue;\n  }\n\n  if (!modalitiesMap[modality]) {\n    modalitiesMap[modality] = {};\n  }\n\n  if (!modalitiesMap[modality][schoolName]) {\n    modalitiesMap[modality][schoolName] = new Set();\n  }\n\n  modalitiesMap[modality][schoolName].add(courseName);\n}\n\n// Monta blocos: MODALIDADE -> Instituição -> Cursos\nconst blocosModalidade = Object.entries(modalitiesMap)\n  .sort(([mA], [mB]) => modalitySortKey(mA).localeCompare(modalitySortKey(mB)))\n  .map(([modality, schoolsMap]) => {\n    const blocosInstituicao = Object.entries(schoolsMap)\n      .filter(([_, coursesSet]) => coursesSet.size > 0)\n      .sort(([sA], [sB]) => toTitleCase(sA).localeCompare(toTitleCase(sB)))\n      .map(([schoolName, coursesSet]) => {\n        const cursosOrdenados = Array.from(coursesSet)\n          .map(toTitleCase)\n          .sort((a, b) => a.localeCompare(b));\n\n        const linhas = [\n          '## **' + toTitleCase(schoolName) + '**',\n          ...cursosOrdenados.map(c => '- ' + c),\n        ];\n\n        return linhas.join('\\n');\n      });\n\n    if (blocosInstituicao.length === 0) return null;\n\n    return ['# **' + modality + '**', ...blocosInstituicao].join('\\n\\n');\n  })\n  .filter(Boolean);\n\n// Junta tudo\nconst textoFinal = blocosModalidade.join('\\n\\n');\nconst saida = textoFinal || 'Nenhuma oferta encontrada.';\n\n// Retorna um único item no formato que o n8n espera\nreturn [\n  {\n    json: {\n      texto: saida\n    }\n  }\n];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-1248,448],"id":"542c68e1-80ec-4dad-aaf2-49828a680ca1","name":"Code in JavaScript29"},{"parameters":{"respondWith":"allIncomingItems","options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.4,"position":[-1056,448],"id":"e1e08df3-9703-4934-b8c5-59ed56bcb207","name":"Respond to Webhook58"},{"parameters":{"assignments":{"assignments":[{"id":"598075a4-2a7a-43ae-8722-b14c88fbf9f0","name":"content_level","value":"={{ $json.body.nivel }}","type":"string"},{"id":"e0864444-614f-4dcc-9068-256109