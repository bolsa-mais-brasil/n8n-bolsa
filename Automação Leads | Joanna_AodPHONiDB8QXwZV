tion pickRawPhone(obj) {\n  // chaves mais comuns primeiro\n  const primaryKeys = [\n    \"Insira somente números sem espaço\",\n    \"phone_number\",\n    \"phone\",\n    \"whatsapp\",\n    \"telefone\",\n    \"celular\",\n    \"mobile\",\n    \"contato\",\n  ];\n\n  for (const k of primaryKeys) {\n    if (Object.prototype.hasOwnProperty.call(obj, k)) {\n      const v = obj[k];\n      const cand = bestCandidateFromText(v);\n      if (cand) return cand;\n    }\n  }\n\n  // varredura profunda: passa por todas as strings do item\n  const stack = [obj];\n  const texts = [];\n  const seen = new Set();\n  while (stack.length) {\n    const cur = stack.pop();\n    if (cur && typeof cur === 'object') {\n      if (seen.has(cur)) continue;\n      seen.add(cur);\n      if (Array.isArray(cur)) {\n        for (const it of cur) stack.push(it);\n      } else {\n        for (const [k, v] of Object.entries(cur)) {\n          if (typeof v === 'string' || typeof v === 'number' || typeof v === 'boolean') {\n            texts.push(`${k}: ${v}`);\n          } else if (v && typeof v === 'object') {\n            stack.push(v);\n          }\n        }\n      }\n    }\n  }\n\n  // tenta extrair do maior texto primeiro\n  texts.sort((a, b) => b.length - a.length);\n  for (const t of texts) {\n    const cand = bestCandidateFromText(t);\n    if (cand) return cand;\n  }\n\n  return '';\n}\n\nconst formatted = pickRawPhone($json);\n\nreturn {\n  json: {\n    ...$json,\n    phone_number_formatado: formatted\n  }\n};\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[160,1632],"id":"2824ddf6-9aa9-4680-bb89-28a5789f8379","name":"formatar numeros 2"},{"parameters":{"operation":"getAll","team":"9014888338","space":"90143751702","folder":"90145996695","list":"901413283054","filters":{"customFieldsUi":{"customFieldsValues":[{"fieldId":"18105e2d-7136-4d95-b6db-f9bd283fb062","value":"={{ $json.phone_number_formatado }}"}]}}},"type":"n8n-nodes-base.clickUp","typeVersion":1,"position":[368,1632],"