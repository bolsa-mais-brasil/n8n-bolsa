ar ações no MCP da RUBE (consultas, atualizações, automações).\n* Planejar passos atômicos e seguros.\n* Retornar progresso e resultados claros ao agente principal.\n\n### 🔧 Ferramentas disponíveis\n\n* **MCP RUBE:** acesso completo às integrações e dados.\n* **Calculator:** cálculos auxiliares.\n* **Think:** raciocínio interno e planejamento.\n\n### 🧩 Regras operacionais\n\n1. Sempre que a tarefa exigir mais de 5 execuções ou chamadas MCP,\n   **interrompa e devolva `partial`** ao Agente Principal, indicando o progresso.\n2. Em caso de bloqueio, peça instrução clara (`blocked`).\n3. Em erro temporário (rate limit, timeout), faça até **2 tentativas internas** antes de devolver `partial`.\n"}},"type":"@n8n/n8n-nodes-langchain.agentTool","typeVersion":2.2,"position":[928,912],"id":"3e11c0ac-fbb9-4ce0-9798-98fd964302a1","name":"agente tool"},{"parameters":{"jsCode":"// NÓ 2 — CLASSIFICADOR + SELETOR (OpenAI only, prevenção de rate limit)\n// - Sem retry. Sem reexecução. Só prevenção antes de chamar o agente.\n// - Estima tokens, respeita orçamento, piso de ferramenta, e ajusta para TPM restante se informado.\n\nconst message = $json.message;\nconst messageLength = $json.messageLength;\nconst messageLower = String(message || '').toLowerCase();\n\n// ---------- util ----------\nfunction extractOverrides(s) {\n  const out = {};\n  const dl = s && s.match ? s.match(/deadline\\s*:\\s*(\\d{2,6})/i) : null;\n  const bg = s && s.match ? s.match(/budget\\s*:\\s*(\\d{1,6})/i) : null;\n  if (dl) out.deadline_ms = Math.max(parseInt(dl[1],10), 500);\n  if (bg) out.budget_cents = Math.max(parseInt(bg[1],10), 1);\n  return out;\n}\nfunction estimateInputTokens(str) {\n  const approx = Math.ceil(String(str || '').length / 4);\n  return Math.max(approx, 1);\n}\n\n// ---------- heurísticas base (as suas, podadas p/ OpenAI) ----------\nfunction calculateComplexity(msg) {\n  let score = 0;\n  const questions = (msg.match(/\\?/g) || []).length; score += questions * 1.5;\n  const advancedTerms = ['arquitetura','escalabilidade','performance','otimização','refatoração','paradigma','framework','infraestrutura','deployment','pipeline','microserviços','kubernetes','machine learning','algoritmo','complexidade','recursão'];\n  advancedTerms.forEach(t => { if (msg.includes(t)) score += 2; });\n  const stepWords = ['primeiro','depois','então','em seguida','por fim','etapa','passo','fase'];\n  stepWords.forEach(w => { if (msg.includes(w)) score += 1; });\n  if (/```|`{3}/.test(msg)) score += 4;\n  if (/[{}\\[\\]()]/.test(msg)) score += 2;\n  const sentences = msg.split(/[.!?]+/).filter(s => s.trim()).length;\n  const words = msg.split(/\\s+/).filter(Boolean).length;\n  if (sentences > 0) {\n    const density = words / sentences;\n    if (density > 25) score += 3; else if (density > 15) score += 1;\n  }\n  if (messageLength > 2000) score += 4; else if (messageLength > 1000) score += 2; else if (messageLength > 500) score += 1;\n  ['e também','além disso','ainda','mais','depois'].forEach(w => { if (msg.includes(w)) score += 0.5; });\n  return Math.min(score, 20);\n}\nfunction identifyTaskTypes(msg) {\n  const tasks = [];\n  const taskKeywords = {\n    codigo: ['código','function','class','bug','debug','erro','script','programar','desenvolver','implementar','api','backend','frontend','algoritmo','refatorar','otimizar código'],\n    dados: ['csv','json','excel','planilha','dados','tabela','dataframe','processar dados','análise de dados','estatística','gráfico','dashboard','relatório','métricas','sql','banco de dados'],\n    criativo: ['criar texto','escrever','redação','artigo','post','email','carta','criativo','ideias','brainstorm','inovar','storytelling','copywriting','slogan','marketing','campanha'],\n    web: ['pesquisar','buscar na web','pesquisa','notícias','atual','hoje','recente','últimas','o que está acontecendo','web','internet','site','url','link'],\n    imagem: ['imagem','foto','desenho','visual','picture','ilustração','criar imagem','gerar imagem','analisar imagem'],\n    automacao: ['automatizar','automação','workflow','n8n','zapier','make','integração','integrar','conectar','sincronizar','trigger','webhook','api rest','mcp','ferramentas','clickup','notion','jira','hubspot','github','slack'],\n    raciocinio: ['estratégia','planejamento','planejar','swot','business plan','roadmap','análise de mercado','consultoria','decisão','otimização de processos','melhoria','framework','metodologia'],\n    simples: ['oi','olá','tchau','obrigado','sim','não','ok','confirmar','cancelar','listar','buscar','mostrar','qual','quando','onde','quem','como','ver','consultar'],\n    traducao: ['traduzir','tradução','translate','inglês','espanhol','português','francês','idioma','língua','linguagem'],\n    explicacao: ['explicar','explicação','documentar','documentação','tutorial','guia','passo a passo','como fazer','ensinar','eli5']\n  };\n  for (const [task, keywords] of Object.entries(taskKeywords)) {\n    if (keywords.some(k => msg.includes(k))) tasks.push(task);\n  }\n  if (!tasks.length) tasks.push('simples');\n  return tasks;\n}\nfunction identifyMcpOperation(msg) {\n  const ops = {\n    trivial: ['ver','mostrar','exibir','consultar'],\n    simple: ['listar','buscar','encontrar','filtrar'],\n    moderate: ['criar','adicionar','atualizar','modificar','editar','deletar'],\n    complex: ['integrar','automatizar','sincronizar','processar em lote','migrar'],\n    critical: ['redesenhar','reestruturar','transformar completamente','reconfigurar']\n  };\n  for (const [lvl, kws] of Object.entries(ops)) if (kws.some(k => msg.includes(k))) return lvl;\n  return null;\n}\nfunction checkUrgency(msg) {\n  return ['urgente','rápido','agora','já','imediato','emergência','asap','pressa'].some(k => msg.includes(k));\n}\nfunction checkMultimodal(msg) {\n  return ['imagem','foto','desenho','visual','picture','criar imagem','gerar imagem','analisar imagem'].some(k => msg.includes(k));\n}\nfunction getLengthScores(length) {\n  if (length <= 30)  return {'gpt-4o-mini':15,'gpt-4.1-mini':12,'gpt-5-mini':5,'gpt-4o':3,'gpt-5':0};\n  if (length <= 100) return {'gpt-4o-mini':12,'gpt-4.1-mini':14,'gpt-5-mini':8,'gpt-4o':6,'gpt-5':2};\n  if (length <= 300) return {'gpt-4o-mini':8,'gpt-4.1-mini':12,'gpt-5-mini':10,'gpt-4o':9,'gpt-5':4};\n  if (length <= 800) return {'gpt-4o-mini':4,'gpt-4.1-mini':8,'gpt-5-mini':12,'gpt-4o':11,'gpt-5':8};\n  if (length <= 2000) return {'gpt-4o-mini':1,'gpt-4.1-mini':3,'gpt-5-mini':8,'gpt-4o':7,'gpt-5':12};\n  return {'gpt-4o-mini':0,'gpt-4.1-mini':0,'gpt-5-mini':4,'gpt-4o':5,'gpt-5':10};\n}\nfunction getAptitudeScores(taskType) {\n  const A = {\n    codigo:     {'gpt-5':14,'gpt-5-mini':12,'gpt-4.1-mini':10,'gpt-4o':8,'gpt-4o-mini':4},\n    dados:      {'gpt-5':16,'gpt-5-mini':14,'gpt-4.1-mini':10,'gpt-4o':8,'gpt-4o-mini':4},\n    criativo:   {'gpt-4o':20,'gpt-5':18,'gpt-5-mini':16,'gpt-4.1-mini':12,'gpt-4o-mini':8},\n    web:        {'gpt-4o':22,'gpt-5':20,'gpt-5-mini':16,'gpt-4.1-mini':12,'gpt-4o-mini':8},\n    imagem:     {'gpt-4o':30,'gpt-5':25,'gpt-5-mini':15,'gpt-4.1-mini':5,'gpt-4o-mini':3},\n    automacao:  {'gpt-5':16,'gpt-5-mini':14,'gpt-4o':12,'gpt-4.1-mini':10,'gpt-4o-mini':4},\n    raciocinio: {'gpt-5':25,'gpt-5-mini':16,'gpt-4o':14,'gpt-4.1-mini':8,'gpt-4o-mini':3},\n    simples:    {'gpt-4o-mini':18,'gpt-4.1-mini':16,'gpt-5-mini':8,'gpt-4o':4,'gpt-5':0},\n    traducao:   {'gpt-4o':18,'gpt-5':17,'gpt-4.1-mini':15,'gpt-5-mini':14,'gpt-4o-mini':10},\n    explicacao: {'gpt-5':17,'gpt-4.1-mini':14,'gpt-5-mini':13,'gpt-4o':12,'gpt-4o-mini':7}\n  };\n  return A[taskType] || {'gpt-4o-mini':10,'gpt-4.1-mini':10,'gpt-5-mini':10,'gpt-4o':10,'gpt-5':10};\n}\nfunction getComplexityScores(c) {\n  if (c<=2)   return {'gpt-4o-mini':12,'gpt-4.1-mini':10,'gpt-5-mini':5,'gpt-4o':4,'gpt-5':0};\n  if (c<=5)   return {'gpt-4o-mini':8,'gpt-4.1-mini':12,'gpt-5-mini':10,'gpt-4o':9,'gpt-5':4};\n  if (c<=9)   return {'gpt-4o-mini':3,'gpt-4.1-mini':8,'gpt-5-mini':14,'gpt-4o':12,'gpt-5':12};\n  if (c<=14)  return {'gpt-4o-mini':1,'gpt-4.1-mini':3,'gpt-5-mini':10,'gpt-4o':9,'gpt-5':20};\n  return        {'gpt-4o-mini':0,'gpt-4.1-mini':0,'gpt-5-mini':4,'gpt-4o':5,'gpt-5':22};\n}\nfunction getMcpScores(op) {\n  const M = {\n    trivial: {'gpt-4o-mini':14,'gpt-4.1-mini':12,'gpt-5-mini':4,'gpt-4o':2,'gpt-5':0},\n    simple:  {'gpt-4o-mini':12,'gpt-4.1-mini':14,'gpt-5-mini':8,'gpt-4o':6,'gpt-5':2},\n    moderate:{'gpt-4.1-mini':14,'gpt-5-mini':12,'gpt-4o':11,'gpt-4o-mini':8,'gpt-5':8},\n    complex: {'gpt-5':16,'gpt-5-mini':14,'gpt-4o':10,'gpt-4.1-mini':6,'gpt-4o-mini':2},\n    critical:{'gpt-5':22,'gpt-5-mini':12,'gpt-4o':8,'gpt-4.1-mini':3,'gpt-4o-mini':0}\n  };\n  return M[op] || {};\n}\nfunction getCostMultiplier(length, complexity) {\n  if (length < 150 && complexity < 3) return {'gpt-4o-mini':2.5,'gpt-4.1-mini':2.0,'gpt-5-mini':0.7,'gpt-4o':0.6,'gpt-5':0.2};\n  if (length < 800 && complexity < 8) return {'gpt-4o-mini':1.3,'gpt-4.1-mini':1.5,'gpt-5-mini':1.4,'gpt-4o':1.3,'gpt-5':0.8};\n  return {'gpt-4o-mini':0.5,'gpt-4.1-mini':0.7,'gpt-5-mini':1.1,'gpt-4o':1.2,'gpt-5':1.6};\n}\nfunction applyUrgencyMultiplier(scores, isUrgent) {\n  if (!isUrgent) return scores;\n  return {\n    'gpt-4o-mini': scores['gpt-4o-mini'] * 1.6,\n    'gpt-4.1-mini': scores['gpt-4.1-mini'] * 1.4,\n    'gpt-5-mini':   scores['gpt-5-mini']   * 1.2,\n    'gpt-4o':       scores['gpt-4o']       * 1.1,\n    'gpt-5':        scores['gpt-5']        * 0.8\n  };\n}\nfunction applyMultimodalMultiplier(scores, needsMultimodal) {\n  if (!needsMultimodal) return scores;\n  return {\n    'gpt-4o-mini': scores['gpt-4o-mini'] * 0.2,\n    'gpt-4.1-mini':scores['gpt-4.1-mini']* 0.3,\n    'gpt-5-mini':  scores['gpt-5-mini']  * 1.5,\n    'gpt-4o':      scores['gpt-4o']      * 3.0,\n    'gpt-5':       scores['gpt-5']       * 2.5\n  };\n}\n\n// ---------- SaaS / profundidade ----------\nfunction detectSaaSTarget(msg) {\n  if (msg.includes('clickup')) return 'clickup';\n  if (msg.includes('notion')) return 'notion';\n  if (msg.includes('jira')) return 'jira';\n  if (msg.includes('hubspot')) return 'hubspot';\n  if (msg.includes('github')) return 'github';\n  if (msg.includes('slack')) return 'slack';\n  return null;\n}\nfunction missingKeyParamsClickUp(msg) {\n  const hasTeamId  = /team[_\\s-]?id\\s*:\\s*\\d+/.test(msg);\n  const hasSpaceId = /space[_\\s-]?id\\s*:\\s*\\d+/.test(msg);\n  const hasListId  = /list[_\\s-]?id\\s*:\\s*\\d+/.test(msg);\n  return { hasTeamId, hasSpaceId, hasListId };\n}\nfunction toolDepthFor(msg, target) {\n  if (!target) return 0;\n  if (target === 'clickup') {\n    const p = missingKeyParamsClickUp(msg);\n    let d = 1; if (!p.hasTeamId) d++; if (!p.hasSpaceId) d++; if (!p.hasListId) d++;\n    return d; // 1..4\n  }\n  const hasAnyId = /\\b[a-z]*_?id\\s*:\\s*\\w+/i.test(msg) || /\\b\\d{6,}\\b/.test(msg);\n  return hasAnyId ? 1 : 2;\n}\n\n// ---------- Execução ----------\nconst complexity = calculateComplexity(messageLower);\nconst taskTypes = identifyTaskTypes(messageLower);\nconst mcpOperation = identifyMcpOperation(messageLower);\nconst isUrgent = checkUrgency(messageLower);\nconst needsMultimodal = checkMultimodal(messageLower);\n\nconst overrides = extractOverrides(message);\nconst deadlineMs = overrides.deadline_ms ?? ($json.deadline_ms ?? 3000);\nconst budgetCents = overrides.budget_cents ?? ($json.budget_cents ?? 25);\nconst inputTokensEst = estimateInputTokens(message);\n\n// Preços (USD / 1M tokens)\nconst prices = {\n  'gpt-4o-mini':  { in: 0.6,  out: 1.2 },\n  'gpt-4.1-mini': { in: 1.2,  out: 3.0 },\n  'gpt-5-mini':   { in: 2.5,  out: 7.0 },\n  'gpt-4o':       { in: 5.0,  out: 15.0 },\n  'gpt-5':        { in: 10.0, out: 30.0 }\n};\n\n// Saída estimada\nfunction estimateOutTokens(taskTypes) {\n  if (taskTypes.includes('imagem')) return 200;\n  if (taskTypes.includes('dados')) return 400;\n  if (taskTypes.includes('criativo') || taskTypes.includes('explicacao')) return 1200;\n  if (taskTypes.includes('automacao') || taskTypes.includes('web')) return 600;\n  return 700;\n}\nlet outTokensEst = estimateOutTokens(taskTypes);\n\nfunction estimateCostUSD(model) {\n  const p = prices[model];\n  if (!p) return Infinity;\n  return (inputTokensEst/1e6)*p.in + (outTokensEst/1e6)*p.out;\n}\n\n// Scores base\nlet scores = { 'gpt-4o-mini': 0, 'gpt-4.1-mini': 0, 'gpt-5-mini': 0, 'gpt-4o': 0, 'gpt-5': 0 };\n\nconst lengthScores = getLengthScores(messageLength);\nfor (const m in scores) scores[m] += (lengthScores[m] || 0) * 1.0;\n\nfor (const t of taskTypes) {\n  const apt = getAptitudeScores(t);\n  for (const m in scores) scores[m] += (apt[m] || 0) * 2.0;\n}\n\nconst cx = getComplexityScores(complexity);\nfor (const m in scores) scores[m] += (cx[m] || 0) * 1.5;\n\nif (mcpOperation) {\n  const ms = getMcpScores(mcpOperation);\n  for (const m in scores) scores[m] += (ms[m] || 0) * 1.2;\n}\n\nconst costMod = getCostMultiplier(messageLength, complexity);\nfor (const m in scores) scores[m] *= costMod[m];\n\nif (isUrgent)        scores = applyUrgencyMultiplier(scores, true);\nif (needsMultimodal) scores = applyMultimodalMultiplier(scores, true);\n\n// Boost por ferramenta\nconst toolTarget = detectSaaSTarget(messageLower);\nconst toolDepth  = toolDepthFor(messageLower, toolTarget);\nif (toolTarget) {\n  if (toolDepth >= 2) { scores['gpt-4o'] += 8; scores['gpt-5'] += 6; scores['gpt-4o-mini'] *= 0.8; }\n  if (toolDepth >= 3) { scores['gpt-4o'] += 2; scores['gpt-5'] += 6; scores['gpt-4.1-mini'] += 2; scores['gpt-4o-mini'] *= 0.8; }\n}\n\n// Seleção inicial\nlet selectedModel = Object.keys(scores).reduce((a,b)=> scores[a]>scores[b]?a:b);\nif (scores[selectedModel] < 5) {\n  selectedModel = messageLength < 150 ? 'gpt-4o-mini'\n                : messageLength < 500 ? 'gpt-4.1-mini'\n                : 'gpt-4o';\n}\n\n// Desempate por custo (<20%)\nconst sorted = Object.keys(scores).sort((a,b)=>scores[b]-scores[a]);\nconst topScore = scores[sorted[0]];\nconst secondScore = scores[sorted[1]] ?? 0;\nif (topScore>0 && secondScore>0) {\n  const diffPct = ((topScore - secondScore)/topScore)*100;\n  if (diffPct < 20) {\n    const costsRank = { 'gpt-4o-mini':1, 'gpt-4.1-mini':2, 'gpt-5-mini':3, 'gpt-4o':4, 'gpt-5':5 };\n    selectedModel = [sorted[0], sorted[1]].sort((a,b)=> (costsRank[a]||99)-(costsRank[b]||99))[0];\n  }\n}\n\n// Piso mínimo por ferramenta (ClickUp ≥ 4o)\nfunction enforceMinModelFloor(current, floor) {\n  const order = ['gpt-4o-mini','gpt-4.1-mini','gpt-4o','gpt-5-mini','gpt-5'];\n  return order.indexOf(current) >= order.indexOf(floor) ? current : floor;\n}\nif (toolTarget === 'clickup' && toolDepth >= 2) {\n  selectedModel = enforceMinModelFloor(selectedModel, 'gpt-4o');\n}\n\n// Orçamento\nconst usdToCents = v => Math.round(v * 100);\nconst budget = Number(budgetCents);\nlet over_budget = false;\nlet route_reason = `tasks=${taskTypes.join('|')}, cx=${complexity}, urgent=${isUrgent}, tool=${toolTarget||'none'}(depth=${toolDepth}), inTok=${inputTokensEst}, outTok≈${outTokensEst}, deadline=${deadlineMs}ms, budget=${budget}c`;\n\nconst baseCostCents = usdToCents(estimateCostUSD(selectedModel));\nif (baseCostCents > budget && !(mcpOperation === 'critical')) {\n  const candidates = sorted.slice(0, 4);\n  let replacement = selectedModel;\n  const floor = (toolTarget && toolDepth>=2) ? 'gpt-4o' : null;\n  for (const c of candidates) {\n    const cst = usdToCents(estimateCostUSD(c));\n    const passFloor = floor ? (enforceMinModelFloor(c, floor) === c) : true;\n    if (cst <= budget && passFloor) { replacement = c; break; }\n  }\n  if (replacement !== selectedModel) {\n    route_reason += ` | degrade_cost:${selectedModel}->${replacement}`;\n    selectedModel = replacement;\n  } else {\n    over_budget = true;\n    route_reason += ` | over_budget_est=${baseCostCents}c`;\n  }\n}\n\n// ---------- Temperatura e TopP ----------\nfunction computeTemperature() {\n  let t =\n    (taskTypes.includes('criativo') || taskTypes.includes('explicacao')) ? 0.35 :\n    (taskTypes.includes('dados') || 