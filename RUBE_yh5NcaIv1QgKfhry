onnet-4.5': scores['claude-sonnet-4.5'] * 0.1,\n    'claude-opus-4.1': scores['claude-opus-4.1'] * 0.1\n  };\n}\n\n// ---------- NOVO: detecção de ferramenta e profundidade ----------\nfunction detectSaaSTarget(msg) {\n  if (msg.includes('clickup')) return 'clickup';\n  if (msg.includes('notion')) return 'notion';\n  if (msg.includes('jira')) return 'jira';\n  if (msg.includes('hubspot')) return 'hubspot';\n  if (msg.includes('github')) return 'github';\n  if (msg.includes('slack')) return 'slack';\n  return null;\n}\nfunction missingKeyParamsClickUp(msg) {\n  const hasTeamId  = /team[_\\s-]?id\\s*:\\s*\\d+/.test(msg);\n  const hasSpaceId = /space[_\\s-]?id\\s*:\\s*\\d+/.test(msg);\n  const hasListId  = /list[_\\s-]?id\\s*:\\s*\\d+/.test(msg);\n  return { hasTeamId, hasSpaceId, hasListId };\n}\nfunction toolDepthFor(msg, target) {\n  if (!target) return 0;\n  if (target === 'clickup') {\n    const p = missingKeyParamsClickUp(msg);\n    let d = 1; // só por citar clickup\n    if (!p.hasTeamId) d++;\n    if (!p.hasSpaceId) d++;\n    if (!p.hasListId) d++;\n    return d; // 1..4\n  }\n  const hasAnyId = /\\b[a-z]*_?id\\s*:\\s*\\w+/i.test(msg) || /\\b\\d{6,}\\b/.test(msg);\n  return hasAnyId ? 1 : 2;\n}\n\n// ---------- Execução ----------\nconst complexity = calculateComplexity(messageLower);\nconst taskTypes = identifyTaskTypes(messageLower);\nconst mcpOperation = identifyMcpOperation(messageLower);\nconst isUrgent = checkUrgency(messageLower);\nconst needsMultimodal = checkMultimodal(messageLower);\n\n// Overrides/defaults\nconst overrides = extractOverrides(message);\nconst deadlineMs = overrides.deadline_ms ?? ($json.deadline_ms ?? 3000);\nconst budgetCents = overrides.budget_cents ?? ($json.budget_cents ?? 25);\nconst inputTokensEst = estimateInputTokens(message);\n\n// Preços estimados\nconst prices = {\n  'gpt-4o-mini':        { in: 0.6,  out: 1.2 },\n  'gpt-4.1-mini':       { in: 1.2,  out: 3.0 },\n  'claude-haiku-3.5':   { in: 0.8,  out: 4.0 },\n  'gpt-5-mini':         { in: 2.5,  out: 7.0 },\n  'gpt-4o':             { in: 5.0,  out: 15.0 },\n  'claude-sonnet-4.5':  { in: 3.0,  out: 15.0 },\n  'gpt-5':              { in: 10.0, out: 30.0 },\n  'claude-opus-4.1':    { in: 15.0, out: 75.0 }\n};\n\n// Saída estimada\nconst outTokensEst = (() => {\n  if (taskTypes.includes('imagem')) return 200;\n  if (taskTypes.includes('dados')) return 400;\n  if (taskTypes.includes('criativo') || taskTypes.includes('explicacao')) return 1200;\n  if (taskTypes.includes('automacao') || taskTypes.includes('web')) return 600;\n  return 700;\n})();\n\nfunction estimateCostUSD(model) {\n  const p = prices[model];\n  if (!p) return Infinity;\n  return (inputTokensEst/1e6)*p.in + (outTokensEst/1e6)*p.out;\n}\n\n// Scores base\nlet scores = {\n  'gpt-4o-mini': 0,\n  'gpt-4.1-mini': 0,\n  'claude-haiku-3.5': 0,\n  'gpt-5-mini': 0,\n  'gpt-4o': 0,\n  'claude-sonnet-4.5': 0,\n  'gpt-5': 0,\n  'claude-opus-4.1': 0\n};\n\nconst lengthScores = getLengthScores(messageLength);\nfor (const m in scores) scores[m] += (lengthScores[m] || 0) * 1.0;\n\nfor (const t of taskTypes) {\n  const apt = getAptitudeScores(t);\n  for (const m in scores) scores[m] += (apt[m] || 0) * 2.0;\n}\n\nconst cx = getComplexityScores(complexity);\nfor (const m in scores) scores[m] += (cx[m] || 0) * 1.5;\n\nif (mcpOperation) {\n  const ms = getMcpScores(mcpOperation);\n  for (const m in scores) scores[m] += (ms[m] || 0) * 1.2;\n}\n\nconst costMod = getCostMultiplier(messageLength, complexity);\nfor (const m in scores) scores[m] *= costMod[m];\n\nif (isUrgent) scores = applyUrgencyMultiplier(scores, true);\nif (needsMultimodal) scores = applyMultimodalMultiplier(scores, true);\n\n// ---------- NOVO: sinal de ferramenta e boosts ----------\nconst toolTarget = detectSaaSTarget(messageLower);\nconst toolDepth = toolDepthFor(messageLower, toolTarget);\n\nif (toolTarget) {\n  if (toolDepth >= 3) {\n    scores['claude-sonnet-4.5'] += 12;\n    scores['gpt-4o'] += 10;\n    scores['gpt-4.1-mini'] += 2;\n    scores['gpt-4o-mini'] *= 0.65;\n    scores['claude-haiku-3.5'] *= 0.75;\n  } else if (toolDepth === 2) {\n    scores['gpt-4o'] += 8;\n    scores['claude-sonnet-4.5'] += 6;\n    scores['gpt-4o-mini'] *= 0.8;\n  }\n}\n\n// Seleção\nlet selectedModel = Object.keys(scores).reduce((a,b)=> scores[a]>scores[b]?a:b);\nif (scores[selectedModel] < 5) {\n  selectedModel = messageLength < 150 ? 'gpt-4o-mini' :\n                  messageLength < 500 ? 'gpt-4.1-mini' :\n                  'claude-sonnet-4.5';\n}\n\n// Desempate por custo (<20%)\nconst sorted = Object.keys(scores).sort((a,b)=>scores[b]-scores[a]);\nconst topScore = scores[sorted[0]];\nconst secondScore = scores[sorted[1]] ?? 0;\nif (topScore>0 && secondScore>0) {\n  const diffPct = ((topScore - secondScore)/topScore)*100;\n  if (diffPct < 20) {\n    const costs = { 'gpt-4o-mini':1, 'gpt-4.1-mini':2, 'claude-haiku-3.5':1.5, 'gpt-5-mini':3, 'gpt-4o':4, 'claude-sonnet-4.5':5, 'gpt-5':6, 'claude-opus-4.1':7 };\n    selectedModel = [sorted[0], sorted[1]].sort((a,b)=> (costs[a]||99)-(costs[b]||99))[0];\n  }\n}\n\n// Piso mínimo por profundidade de ferramenta\nfunction enforceMinModelFloor(current, floor) {\n  const order = ['gpt-4o-mini','gpt-4.1-mini','claude-haiku-3.5','gpt-5-mini','gpt-4o','claude-sonnet-4.5','gpt-5','claude-opus-4.1'];\n  return order.indexOf(current) >= order.indexOf(floor) ? current : floor;\n}\nif (toolTarget === 'clickup' && toolDepth >= 3) {\n  selectedModel = enforceMinModelFloor(selectedModel, 'claude-sonnet-4.5');\n} else if (toolTarget && toolDepth >= 2) {\n  selectedModel = enforceMinModelFloor(selectedModel, 'gpt-4o');\n}\n\n// Orçamento\nconst usdToCents = v => Math.round(v * 100);\nconst budget = Number(budgetCents);\nlet over_budget = false;\nlet route_reason = `tasks=${taskTypes.join('|')}, cx=${complexity}, urgent=${isUrgent}, tool=${toolTarget||'none'}(depth=${toolDepth}), inTok=${inputTokensEst}, outTok≈${outTokensEst}, deadline=${deadlineMs}ms, budget=${budget}c`;\n\nconst baseCostCents = usdToCents(estimateCostUSD(selectedModel));\nif (baseCostCents > budget && !(mcpOperation === 'critical')) {\n  const candidates = sorted.slice(0, 4);\n  let replacement = selectedModel;\n  for (const c of candidates) {\n    const cst = usdToCents(estimateCostUSD(c));\n    const floor = (toolTarget==='clickup' && toolDepth>=3) ? 'claude-sonnet-4.5' :\n                  (toolTarget && toolDepth>=2) ? 'gpt-4o' : null;\n    const passFloor = floor ? (enforceMinModelFloor(c, floor) === c) : true;\n    if (cst <= budget && passFloor) { replacement = c; break; }\n  }\n  if (replacement !== selectedModel) {\n    route_reason += ` | degrade_cost:${selectedModel}->${replacement}`;\n    selectedModel = replacement;\n  } else {\n    over_budget = true;\n    route_reason += ` | over_budget_est=${baseCostCents}c`;\n  }\n}\n\n// Temperatura\nfunction computeTemperature() {\n  let t =\n    (taskTypes.includes('criativo') || taskTypes.includes('explicacao')) ? 0.35 :\n    (taskTypes.includes('dados') || taskTypes.includes('automacao') || taskTypes.includes('web')) ? 0.12 :\n    (taskTypes.includes('codigo') || taskTypes.includes('raciocinio')) ? 0.18 :\n    0.12;\n\n  if (complexity > 14) t += 0.08; else if (complexity > 9) t += 0.04;\n  if (isUrgent) t -= 0.04;\n  if (toolTarget) t -= 0.03;\n  if (/se vira/.test(messageLower)) t -= 0.02;\n\n  // piso 0.10 para evitar modelo \"tijolo\"; teto 0.70\n  return Math.max(0.10, Math.min(0.70, Number(t.toFixed(2))));\n}\nconst temperature = computeTemperature();\n\n// TOP_P: sempre presente no output\nfunction computeTopP({ temperature, toolDepth, toolTarget, complexity, isUrgent }) {\n  let p =\n    temperature <= 0.15 ? 0.85 :\n    temperature <= 0.25 ? 0.90 :\n    temperature <= 0.45 ? 0.95 : 1.00;\n\n  if (toolTarget) p -= 0.05;\n  if (toolDepth >= 3) p -= 0.05;\n  if (isUrgent) p -= 0.05;\n  if (complexity > 14) p += 0.03;\n\n  p = Math.max(0.10, Math.min(1.00, p));\n  return Number(p.toFixed(2));\n}\nconst top_p = computeTopP({ temperature, toolDepth, toolTarget, complexity, isUrgent });\n\n// Máximo de resposta\nconst response_tokens_max =\n  taskTypes.includes('dados') || taskTypes.includes('automacao') ? 500 :\n  taskTypes.includes('criativo') || taskTypes.includes('explicacao') ? 1500 :\n  900;\n\n// Mapeamento p/ Model Selector\nconst providerMap = {\n  'gpt-4o-mini': {provider:'OpenAI', model:'gpt-4o-mini'},\n  'gpt-4.1-mini': {provider:'OpenAI', model:'gpt-4.1-mini'},\n  'gpt-4o': {provider:'OpenAI', model:'gpt-4o'},\n  'gpt-5-mini': {provider:'OpenAI', model:'o3-mini'},\n  'gpt-5': {provider:'OpenAI', model:'o3'},\n  'claude-haiku-3.5': {provider:'Anthropic', model:'claude-3.5-haiku'},\n  'claude-sonnet-4.5': {provider:'Anthropic', model:'claude-3.7-sonnet'},\n  'claude-opus-4.1': {provider:'Anthropic', model:'claude-3-opus'}\n};\nconst modelInfo = providerMap[selectedModel] || null;\n\n// Payload final (UM único return)\nreturn [{\n  json: {\n    selectedModel,\n    modelInfo,\n    features: { complexity, taskTypes, mcpOperation, isUrgent, needsMultimodal, toolTarget, toolDepth },\n    scores,\n    input_tokens_est: inputTokensEst,\n    output_tokens_est: outTokensEst,\n    prices_usd_per_million: prices,\n    est_cost_cents_selected: Math.round((estimateCostUSD(selectedModel) || 0) * 100),\n    budget_cents: budget,\n    deadline_ms: deadlineMs,\n\n    temperature,\n    top_p,                 // SEMPRE presente\n    response_tokens_max,\n    over_budget,\n    route_reason\n  }\n}];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[304,496],"id":"9a2dd9cc-0e91-41a8-8576-e6e328c2e20f","name":"Classificador + Seletor de Modelo"},{"parameters":{"jsCode":"// NÓ 1 — PARSER (Evolution API)\n\nconst body = $input.item.json.body || $json.body || $input.item.json || {};\nconst data = body.data || {};\nconst msg = data.message || {};\nconst key = data.key || {};\n\nfunction pickMessage(m) {\n  return (\n    m.conversation ||\n    m.extendedTextMessage?.text ||\n    m.imageMessage?.caption ||\n    m.videoMessage?.caption ||\n    m.documentMessage?.caption ||\n    m.ephemeralMessage?.message?.extendedTextMessage?.text ||\n    ''\n  );\n}\n\nfunction normalize(s) {\n  return String(s || '')\n    .replace(/\\u200B/g, '')      // zero-width\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\n// Ignora eco\nif (key.fromMe) {\n  return {\n    json: {\n      shouldProcess: false,\n      reason: 'Mensagem enviada pelo bot',\n      sender: key.remoteJid || ''\n    }\n  };\n}\n\nlet message = normalize(pickMessage(msg));\nif (!message) {\n  return {\n    json: {\n      shouldProcess: false,\n      reason: 'Mensagem vazia',\n      sender: key.remoteJid || ''\n    }\n  };\n}\n\nconst sender = key.remoteJid || data.remoteJid || '';\nconst senderName = data.pushName || 'Usuário';\nconst messageId = key.id || data.messageId || String(Date.now());\nconst instance = body.instance || data.instance || '';\nconst messageTimestamp = data.messageTimestamp || Date.now();\nconst serverUrl = body.server_url || body.serverUrl || '';\nconst apikey = body.apikey || body.apiKey || '';\nconst isGroup = /@g\\.us$/.test(sender);\nconst eventType = body.event || body.type || 'messages.upsert';\nconst idempotencyKey = [instance || 'inst', messageId].join(':');\n\nreturn {\n  json: {\n    shouldProcess: true,\n    message,\n    messageLength: message.length,\n    sender,\n    senderName,\n    messageId,\n    instance,\n    isGroup,\n    eventType,\n    messageTimestamp,\n    serverUrl,\n    apikey,\n    idempotencyKey,\n    webhookResponse: {\n      serverUrl,\n      apikey,\n      instance,\n      remoteJid: sender\n    }\n  }\n};\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[80,496],"id":"9603806b-5ed9-4873-a9e0-a6d05641083d","name":"Parser"},{"parameters":{"jsCode":"const arr = Array.isArray($json) ? $json : [$json];\nconst item = arr[0] || {};\nconst body = item.body || {};\nconst data = body.data || {};\nconst msg = data.message || {};\nconst key = data.key || {};\n\n// ignora se não for evento de mensagem\nif (body.event !== 'messages.upsert') {\n  return [{ drop: true, reason: 'not_message_event' }];\n}\n\n// ignora eco (mensagem enviada por você mesmo)\nif (key.fromMe === true) {\n  return [{ drop: true, reason: 'echo_message' }];\n}\n\n// id da mensagem (para deduplicar)\nconst messageId = key.id || Date.now().toString();\n\n// pega texto de diferentes campos\nlet text = '';\nif (data.messageType === 'conversation' && msg.conversation) {\n  text = msg.conversation;\n} else if (msg.extendedTextMessage?.text) {\n  text = msg.extendedTextMessage.text;\n} else {\n  text = '[texto_indisponivel]';\n}\n\nconst sender = body.sender || key.remoteJid || '';\nconst pushName = data.pushName || '';\n\nreturn [{\n  drop: false,\n  source: 'whatsapp',\n  text: String(text).trim(),\n  task: '',\n  risk_level: '',\n  deadline_ms: null,\n  budget_cents: null,\n  context: {\n    whatsapp: {\n      messageId,\n      sender,\n      pushName,\n      instance: body.instance || '',\n      instanceId: data.instanceId || '',\n      server_url: body.server_url || '',\n      apikey: body.apikey || ''\n    }\n  }\n}];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-144,720],"id":"64c4ae35-3421-410d-b440-ffde7615b27d","name":"Guard & Parse (ParseInput)"},{"parameters":{"jsCode":"const txt = ($json.text || '').toLowerCase();\n\nfunction guessIntent() {\n  if (/^oi$|^ol[aá]$|bom dia|boa tarde|boa noite/.test(txt)) return 'greeting';\n  if (/ajuda|help|como usar/.test(txt)) return 'help';\n  if (/clickup|task|tarefa|subtask/.test(txt)) return 'clickup_ops';\n  if (/meta\\s*ads|facebook\\s*ads|campanha/.test(txt)) {\n    if (/auditoria|diagn[oó]stico|estrat[ée]gia|hip[oó]tese/.test(txt)) return 'meta_strategy';\n    return 'meta_routine';\n  }\n  if (/email|e-mail|inbox|responder/.test(txt)) {\n    if (/classificar|priorizar|extrair/.test(txt)) return 'email_triage';\n    return 'email_compose';\n  }\n  return 'general';\n}\n\nfunction guessRisk(intent) {\n  if (intent === 'meta_strategy') return 'high';\n  if (intent === 'meta_routine' || intent === 'clickup_ops') return 'medium';\n  return 'low';\n}\n\nconst intent = guessIntent();\nconst risk = guessRisk(intent);\nconst inputTokensEst = Math.ceil(($json.text || '').length / 4) || 1;\n\nreturn [{\n  ...$json,\n  intent,\n  risk,\n  input_tokens_est: inputTokensEst,\n  deadline_ms: $json.deadline_ms ?? 3000,\n  budget_cents: $json.budget_cents ?? 5\n}];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[80,720],"id":"4115bd17-890f-467e-b4a7-0f5772e508e8","name":"ClassifyTask"},{"parameters":{"jsCode":"const intent = $json.intent;\nconst risk = $json.risk;\nconst n = $json.input_tokens_est;\nconst deadline = $json.deadline_ms;\nconst budget = $json.budget_cents;\n\n// IDs conforme você cadastrou no n8n/Anthropic\nconst MODELS = {\n  haiku:  'claude-haiku-3.5',   // ajuste para o ID que o seu node usa\n  sonnet: 'claude-sonnet-4.5',\n  opus:   'claude-opus-4.1'\n};\n\n// Preços por milhão (USD)\nconst price = {\n  haiku: { in: 0.80, out: 4.00 },\n  sonnet:{ in: 3.00, out: 15.00 },\n  opus:  { in: 15.00, out: 75.00 },\n};\n\n// Estimativa de saída\nconst outEst =\n  /compose|strategy|audit/.test(intent) ? 1200 :\n  /summary|triage|etl|routine/.test(intent) ? 300 :\n  700;\n\nfunction cost(model) {\n  const p = price[model];\n  return (n/1e6)*p.in + (outEst/1e6)*p.out; // USD\n}\n\nlet pick = null;\n\n// 1) Risco\nif (risk === 'high') pick = 'opus';\n\n// 2) Tipo\nif (!pick) {\n  if (['email_triage','etl_text'].includes(intent)) pick = 'haiku';\n  else if (['email_compose','clickup_ops','meta_routine','general','greeting','help'].includes(intent)) pick = 'sonnet';\n  else if (intent === 'meta_strategy') pick = 'opus';\n  else pick = 'sonnet';\n}\n\n// 3) Contexto grande\nif (n > 60000 && pick === 'haiku') pick = 'sonnet';\n\n// 4) Latência apertada\nif (deadline < 1500 && ['email_triage','etl_text','meta_routine'].includes(intent)) pick = 'haiku';\n\n// 5) Teto de custo (ex: 5 cents). Para risco alto, não rebaixa.\nconst usdToCents = v => Math.round(v*100);\nif (risk !== 'high' && usdToCents(cost(pick)) > budget) {\n  if (pick === 'opus') pick = 'sonnet';\n  else if (pick === 'sonnet') pick = 'haiku';\n}\n\n// Temperatura\nconst temperature =\n  /compose|strategy/.test(intent) ? 0.3 :\n  /triage|etl|routine/.test(intent) ? 0.1 : 0.2;\n\nreturn [{\n  ...$json,\n  model_chosen: pick,\n  model_id: MODELS[pick],\n  temperature,\n  route_reason: `intent=${intent}, risk=${risk}, tokens=${n}, deadline=${deadline}, budget_cents=${budget}`\n}];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[304,720],"id":"d8060361-7230-43b4-9714-1fddbf26505b","name":"Modelo"},{"parameters":{},"type":"n8n-nodes-zep-memory-community.memoryZep","typeVersion":4,"position":[848,672],"id":"21087630-4d95-4b37-8162-19a8689db28a","name":"Zep","credentials":{"zepApi":{"id":"CYZIZM4eAWIC77uj","name":"Zep Api account"}}},{"parameters":{"options":{}},"type":"@n8n/n8n-nodes-langchain.chatTrigger","typeVersion":1.3,"position":[-144,272],"id":"5d7f94f3-eeed-4db3-a915-eaa6f565cbee","name":"When chat message received","webhookId":"7f005c09-8a9a-40e2-94f4-5e2de0a50b64"},{"parameters":{"assignments":{"assignments":[{"id":"85ae4257-74ff-4b0b-9fee-d56646c55a61","name":"selectedModel","value":"={{ $json.selectedModel }}","type":"string"},{"id":"21757135-68ad-4380-b6c4-24e4898da670","name":"temperature","value":"={{ $json.temperature }}","type":"number"},{"id":"d0983124-4511-4a0e-8d1d-ab4aa834b616","name":"message","value":"={{ $('Parser').item.json.message }}","type":"string"},{"id":"92d96745-8eb3-476b-8737-e34007d4b88f","name":"remetente","value":"={{ $('Parser').item.json.sender }}","type":"string"},{"id":"941ba92e-b023-48ac-969b-93dbba1bc00c","name":"top_p","value":"={{ $json.top_p }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[528,496],"id":"734b2ba1-8c5c-45ee-b54d-7