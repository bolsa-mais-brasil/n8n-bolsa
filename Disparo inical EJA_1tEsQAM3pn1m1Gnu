\n  // String limpa, remove prefixos tipo \"p:\" ou \"tel:\"\n  let s = String(raw).trim().replace(/^[a-zA-Z]+:/, '');\n\n  // Mantém apenas dígitos e o primeiro '+' (se existir)\n  if (s.startsWith('+')) {\n    s = '+' + s.slice(1).replace(/\\D/g, '');\n  } else {\n    s = s.replace(/\\D/g, '');\n  }\n\n  // Remove o '+', normaliza zeros e repetições de 55\n  let d = s.replace(/^\\+/, '');\n  d = d.replace(/^0+/, '');\n  d = d.replace(/^(55)+/, '55');\n\n  // Se já começa com 55\n  if (d.startsWith('55')) {\n    if (d.length === 12 || d.length === 13) return `+${d}`;      // 55 + 10 ou 11 dígitos\n    if (d.length > 13) return `+${d.slice(0, 13)}`;               // corta excesso\n    return '';\n  }\n\n  // Sem 55: tenta montar\n  if (d.length === 10 || d.length === 11) return `+55${d}`;\n  if (d.length > 11) return `+55${d.slice(-11)}`;                 // pega os 11 finais\n  return '';\n}\n\n// Pega do campo certo (e alguns alternativos porque a vida é caos)\nconst rawPhone =\n  $json[\"Insira somente números sem espaço\"] ??\n  $json.phone_number ??\n  $json.phone ??\n  $json.whatsapp ??\n  $json.telefone ??\n  null;\n\nreturn {\n  json: {\n    ...$json,\n    phone_number_formatado: formatBR(rawPhone)\n  }\n};\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[656,496],"id":"6d1fc251-e536-4ed8-874c-fd8c28fb6280","name":"formatar numeros"},{"parameters":{"amount":30},"type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[1072,736],"id":"cd7f90b4-83e2-4ba7-94ef-4198ce5d7af4","name":"Wait1","webhookId":"3d2350cf-a08f-4136-8a02-0478ea3878cc","executeOnce":true}],"connections":{"Criar lead":{"main":[[{"node":"custom_attributes","type":"main","index":0}]]},"Wait3":{"main":[[{"node":"buscar contato2","type":"main","index":0}]]},"custom_attributes":{"main":[[{"node":"Mudar Status","type":"main","index":0}]]},"atualizar status planilha":{"main":[[{"node":"Wait2","type":"main","index":0}]]},"gerar mensagem inicial":{"main":[[{"node":"Check phone number is re