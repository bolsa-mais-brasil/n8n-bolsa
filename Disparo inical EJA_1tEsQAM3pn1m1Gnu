ew Date()),\n      10\n    );\n    if (hour < 12) return 'bom dia 👋';\n    if (hour < 18) return 'boa tarde 👋';\n    return 'boa noite 👋';\n  } catch {\n    const h = new Date().getHours();\n    if (h < 12) return 'bom dia 👋';\n    if (h < 18) return 'boa tarde 👋';\n    return 'boa noite 👋';\n  }\n}\n\n// Interpolador simples: substitui {{chave}} pelo valor no contexto\nfunction fillTemplate(str, ctx) {\n  return String(str).replace(/\\{\\{\\s*(\\w+)\\s*\\}\\}/g, (_, k) => {\n    return Object.prototype.hasOwnProperty.call(ctx, k) ? String(ctx[k] ?? '') : '';\n  });\n}\n\n// ===== Campos extraídos =====\nconst nome = firstNameClean(input['full_name']);\nconst telefone = safeStr(input['phone_number']);\nconst email = safeStr(input['email']);\nconst cidade = safeStr(input['em_qual_cidade_gostaria_de_estudar?']) || 'sua cidade';\nconst conheciaPrograma = safeStr(input['você_já_conhecia_o_programa_bolsa_mais_brasil_?']);\nconst saudacao = saudacaoSP();\n\n// ===== NOVAS MENSAGENS DO CLIENTE =====\nconst NOVAS_MENSAGENS = [\n`Oi 👋🏽 {{nome}}\nSou a Camila, do Bolsa Mais Brasil. Tudo bem?\nAqui nosso atendimento é 100% humano, feito com cuidado mesmo — eu e nossa equipe vamos te acompanhar em cada etapa 💛\nVi que você tem interesse em concluir o Ensino Médio pelo EJA, com possibilidade de finalização a partir de 6 meses.\nMe diz uma coisa rapidinho: você já tem 18 anos completos?`,\n\n`Oi 👋 {{nome}}\nCamila aqui, do Bolsa Mais Brasil. Como você está hoje?\nSó para você saber: nosso atendimento é feito por pessoas de verdade — eu e a equipe estaremos ao seu lado durante todo o processo 🤝\nPercebi que você quer concluir o Ensino Médio pelo EJA, e isso pode ser feito em cerca de 6 meses dependendo do ritmo.\nPra eu te orientar certinho, responde pra mim: você já tem 18 anos ou mais?`,\n\n// ... resto das mensagens igual ao que você já tinha ...\n`Olá 😊 {{nome}}\nAqui é a Camila, do Bolsa Mais Brasil, tudo bem?\nSó para você saber: nosso atendimento é feito por pessoas, nada automático — eu e nossa equipe estaremos com você em todo o processo 💛\nVi que você está interessado em concluir o Ensino Médio pelo EJA, e com nossas Bolsas de Estudo é possível finalizar em cerca de 6 meses, dependendo da sua rotina.\nAntes de seguirmos, apenas me diga: você já completou 18 anos?`,\n];\n\n// ===== Escolha aleatória + interpolação =====\nconst BASE = NOVAS_MENSAGENS;\nconst idx = randIndex(BASE.length);\nconst contexto = { nome, cidade, saudacao };\nconst mensagem = fillTemplate(BASE[idx], contexto);\n\n// ===== Saída =====\nreturn [\n  {\n    json: {\n      mensagem,\n      nome,\n      cidade,\n      telefone,\n      email,\n      conheciaPrograma,\n      saudacao,\n      modeloIndex: idx,\n      totalTemplatesDisponiveis: BASE.length,\n      origem: \"Meta Lead Ads - EJA\"\n    },\n  },\n];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1776,480],"id":"9ad29616-ddfe-4c07-bc9a-89857ff1900a","name":"gerar mensagem inicial1"},{"parameters":{"options":{}},"type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[432,496],"id":"afc98c58-f109-484a-8329-8b25155648c5","name":"Loop Over Items"},{"parameters":{"amount":10},"type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[2576,736],"id":"b2ead002-ac84-42ae-bdae-ccc6c0ed842a","name":"Wait4","webhookId":"b70ce41e-4406-4500-8061-dc961e30302f"},{"parameters":{"url":"https://chat.bmbr.com.br/api/v1/accounts/1/contacts/search","sendHeaders":true,"headerParameters":{"parameters":[{"name":"api_access_token","value":"JSBsA94Gi8CmaKhrT3SBMDEK"}]},"sendBody":true,"bodyParameters":{"parameters":[{"name":"q","value":"={{ $('formatar numeros').item.json.phone_number_formatado.slice(-8) }}"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1264,736],"id":"a9f72066-8070-4101-9c99-c31e458fb505","name":"buscar contato","onError":"continueRegularOutput"},{"parameters":{"url":"=https://chat.bmbr.com.br/api/v1/accounts/1/contacts/{{ $json.payload[0].id }}/convers