);\n\n  // remove \"00\" internacional no começo\n  s = s.replace(/^\\+?00+/, '');\n\n  // trabalha só com dígitos, guardando se tinha '+'\n  const hadPlus = s.startsWith('+');\n  let d = s.replace(/^\\+/, '');\n\n  // remove zeros à esquerda que não fazem parte do país\n  d = d.replace(/^0+/, '');\n\n  // Não \"achatar\" 5555 em 55. Isso quebra DDD 55.\n  // Regras de decisão:\n  // 1) Já tem país 55 e tamanho certo\n  if (d.startsWith('55')) {\n    if (d.length === 12 || d.length === 13) return `+${d}`;\n    if (d.length > 13) return `+${d.slice(0, 13)}`;\n    // se veio +55 mas curto, tenta completar não dá. Invalida.\n    // cai para outras heurísticas só se não tinha 55.\n  }\n\n  // 2) Sem país: 10 ou 11 dígitos válidos\n  if (!d.startsWith('55')) {\n    if (d.length === 11) return `+55${d}`;\n    if (d.length === 10) return `+55${d}`;\n    if (d.length > 11) return `+55${d.slice(-11)}`;\n  }\n\n  // 3) Caso exótico: tinha '+', não é BR, mas tem 8–15 dígitos. Não forçamos país estranho.\n  if (hadPlus && d.length >= 8 && d.length <= 15) {\n    // Se for outro país, você que lute; mas vamos retornar com '+'\n    return `+${d}`;\n  }\n\n  // 4) Último suspiro: se sobrou 12–13 começando com 55 após zeros\n  if (d.startsWith('55') && (d.length === 12 || d.length === 13)) return `+${d}`;\n\n  // 5) Último de verdade: se tem pelo menos 10 dígitos, tenta BR\n  if (d.length >= 10) {\n    if (d.length >= 11) return `+55${d.slice(-11)}`;\n    return `+55${d}`; // 10 dígitos\n  }\n\n  return '';\n}\n\nfunction bestCandidateFromText(s) {\n  const cands = splitCandidates(toStringSafe(s));\n  if (cands.length === 0) return '';\n\n  // normaliza e pontua\n  const scored = cands.map(raw => {\n    const cleaned = normalizeBR(raw);\n    // pontuação: menor é melhor\n    // 0: +55 com 12/13\n    // 1: começa 55 com 12/13 (já convertido pela normalizeBR)\n    // 2: +55 de 10/11 (montado)\n    // 3: qualquer +country 8–15\n    // 4: fallback\n    let score = 4;\n    if (/^\\+55\\d