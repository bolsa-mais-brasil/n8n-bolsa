n        var(--bg);\n      min-height: 100vh;\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      padding: 28px 16px;\n    }\n\n    .card{\n      width: min(820px, 100%);\n      background: linear-gradient(180deg, var(--card), rgba(255,255,255,.06));\n      border: 1px solid var(--border);\n      border-radius: var(--radius);\n      box-shadow: var(--shadow);\n      overflow:hidden;\n    }\n\n    .header{\n      padding: 18px 18px 12px;\n      border-bottom: 1px solid rgba(255,255,255,.10);\n    }\n\n    h1{\n      font-size: 18px;\n      margin: 0;\n      letter-spacing: .2px;\n    }\n    .sub{\n      margin: 8px 0 0;\n      color: var(--muted);\n      font-size: 13.5px;\n      line-height: 1.35;\n    }\n\n    .body{ padding: 18px; }\n\n    .field{\n      display:flex;\n      flex-direction:column;\n      gap: 8px;\n      margin-bottom: 14px;\n    }\n    label{\n      font-size: 13px;\n      color: rgba(255,255,255,.86);\n    }\n\n    input, select{\n      width:100%;\n      background: rgba(255,255,255,.06);\n      border: 1px solid rgba(255,255,255,.14);\n      border-radius: var(--radius-sm);\n      padding: 12px 12px;\n      color: var(--text);\n      outline: none;\n      transition: border-color .15s ease, box-shadow .15s ease;\n      font-size: 14px;\n    }\n\n    input:focus, select:focus{\n      border-color: rgba(96,165,250,.7);\n      box-shadow: var(--focus);\n    }\n\n    select option{ color: #0b1220; }\n\n    .hint{\n      font-size: 12px;\n      color: var(--muted);\n      line-height: 1.35;\n    }\n\n    /* Chips (multi-números estilo email) */\n    .chips{\n      display:flex;\n      flex-wrap: wrap;\n      gap: 8px;\n      align-items:center;\n      background: rgba(255,255,255,.06);\n      border: 1px solid rgba(255,255,255,.14);\n      border-radius: var(--radius-sm);\n      padding: 10px 10px;\n      min-height: 48px;\n      transition: border-color .15s ease, box-shadow .15s ease;\n    }\n    .chips:focus-within{\n      border-color: rgba(96,165,250,.7);\n      box-shadow: var(--focus);\n    }\n    .chip{\n      display:inline-flex;\n      align-items:center;\n      gap: 8px;\n      padding: 6px 10px;\n      border-radius: 999px;\n      border: 1px solid rgba(255,255,255,.14);\n      background: rgba(255,255,255,.08);\n      font-size: 13px;\n      white-space: nowrap;\n    }\n    .chip .xchip{\n      border:none;\n      background: transparent;\n      color: rgba(255,255,255,.75);\n      cursor:pointer;\n      font-size: 16px;\n      line-height: 1;\n      padding: 0 4px;\n      border-radius: 8px;\n    }\n    .chip .xchip:hover{ background: rgba(255,255,255,.10); }\n    .chips-input{\n      flex: 1;\n      min-width: 220px;\n      border: none !important;\n      background: transparent !important;\n      box-shadow: none !important;\n      padding: 8px 8px;\n      outline: none;\n      color: var(--text);\n      font-size: 14px;\n    }\n    .chips-input::placeholder{ color: rgba(255,255,255,.45); }\n\n    /* Checklist */\n    .checklist{\n      display:grid;\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 10px;\n    }\n    @media (min-width: 720px){\n      .checklist{ grid-template-columns: repeat(3, minmax(0, 1fr)); }\n    }\n    .checkitem{\n      display:flex;\n      align-items:center;\n      gap: 10px;\n      padding: 10px 12px;\n      border: 1px solid rgba(255,255,255,.14);\n      background: rgba(255,255,255,.06);\n      border-radius: 14px;\n      user-select:none;\n    }\n    .checkitem input[type=\"checkbox\"]{\n      width: 18px;\n      height: 18px;\n      accent-color: var(--accent);\n      flex: 0 0 auto;\n    }\n    .checkitem span{\n      font-size: 13.5px;\n      color: rgba(255,255,255,.92);\n    }\n\n    .actions{\n      display:flex;\n      gap: 12px;\n      align-items:center;\n      margin-top: 10px;\n      flex-wrap: wrap;\n    }\n\n    .btn{\n      appearance:none;\n      border: 1px solid rgba(255,255,255,.14);\n      background: rgba(255,255,255,.08);\n      color: var(--text);\n      padding: 12px 14px;\n      border-radius: 14px;\n      cursor:pointer;\n      font-weight: 600;\n      transition: transform .05s ease, background .15s ease, border-color .15s ease, opacity .15s ease;\n      display:inline-flex;\n      align-items:center;\n      gap: 10px;\n      user-select:none;\n    }\n    .btn:hover{ background: rgba(255,255,255,.12); }\n    .btn:active{ transform: translateY(1px); }\n    .btn:disabled{ opacity:.55; cursor:not-allowed; }\n\n    .btn-primary{\n      border-color: rgba(49,196,141,.35);\n      background: rgba(49,196,141,.16);\n    }\n    .btn-primary:hover{\n      background: rgba(49,196,141,.22);\n      border-color: rgba(49,196,141,.55);\n    }\n\n    .btn-ghost{ background: transparent; }\n\n    .spinner{\n      width: 16px; height: 16px;\n      border-radius: 50%;\n      border: 2px solid rgba(255,255,255,.28);\n      border-top-color: rgba(255,255,255,.85);\n      animation: spin .8s linear infinite;\n      display:none;\n    }\n    .btn.loading .spinner{ display:inline-block; }\n    @keyframes spin { to{ transform: rotate(360deg); } }\n\n    .toast{\n      font-size: 12px;\n      color: rgba(255,255,255,.78);\n      margin-top: 10px;\n      min-height: 16px;\n    }\n    .toast.error{ color: rgba(251,113,133,.95); }\n\n    /* modal */\n    .modal-backdrop{\n      position: fixed;\n      inset: 0;\n      background: rgba(0,0,0,.55);\n      display:none;\n      align-items:center;\n      justify-content:center;\n      padding: 18px;\n    }\n    .modal-backdrop.show{ display:flex; }\n\n    .modal{\n      width: min(620px, 100%);\n      background: rgba(15,23,42,.92);\n      border: 1px solid rgba(255,255,255,.14);\n      border-radius: 18px;\n      box-shadow: var(--shadow);\n      overflow:hidden;\n      transform: translateY(6px);\n      animation: pop .14s ease-out forwards;\n    }\n    @keyframes pop { to { transform: translateY(0); } }\n\n    .modal-head{\n      padding: 14px 16px;\n      border-bottom: 1px solid rgba(255,255,255,.10);\n      display:flex;\n      align-items:center;\n      justify-content:space-between;\n      gap: 10px;\n    }\n    .modal-title{\n      margin:0;\n      font-size: 14px;\n      letter-spacing: .2px;\n    }\n    .x{\n      border:none;\n      background: transparent;\n      color: rgba(255,255,255,.75);\n      cursor:pointer;\n      font-size: 18px;\n      line-height: 1;\n      padding: 6px 8px;\n      border-radius: 10px;\n    }\n    .x:hover{ background: rgba(255,255,255,.08); }\n\n    .modal-body{ padding: 16px; }\n    .modal-msg{\n      margin: 0 0 12px;\n      color: rgba(255,255,255,.88);\n      line-height: 1.45;\n      font-size: 14px;\n      white-space: pre-wrap;\n      word-break: break-word;\n    }\n    .linkbox{\n      display:none;\n      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;\n      font-size: 12px;\n      color: rgba(255,255,255,.78);\n      background: rgba(0,0,0,.22);\n      border: 1px solid rgba(255,255,255,.10);\n      padding: 10px;\n      border-radius: 14px;\n      overflow:auto;\n    }\n    .modal-actions{\n      padding: 0 16px 16px;\n      display:flex;\n      gap: 10px;\n      justify-content:flex-end;\n      flex-wrap: wrap;\n    }\n  </style>\n</head>\n<body>\n  <section class=\"card\">\n    <header class=\"header\">\n      <h1>Criar grupos</h1>\n      <p class=\"sub\">\n        Selecione a origem, informe os números da unidade a serem adicionados, e selecione as pessoas do time B+B a serem adicionadas\n      </p>\n    </header>\n\n    <div class=\"body\">\n      <form id=\"form\">\n        <div class=\"field\">\n          <label for=\"sessaoSelect\">Adicionar a partir de</label>\n          <select id=\"sessaoSelect\" required>\n            <option value=\"\" disabled selected>Carregando opções...</option>\n          </select>\n          <div class=\"hint\">Escolha o número/origem que vai adicionar as pessoas no grupo.</div>\n        </div>\n\n        <div class=\"field\">\n          <label for=\"nomeGrupo\">Nome do Grupo</label>\n          <input\n            id=\"nomeGrupo\"\n            name=\"nomeGrupo\"\n            type=\"text\"\n            placeholder=\"Ex.: Unidade BH - Time B+B\"\n            autocomplete=\"off\"\n            required\n          />\n          <div class=\"hint\">Defina o nome do grupo que será criado/atualizado.</div>\n        </div>\n\n        <!-- NOVO CAMPO: Captador -->\n        <div class=\"field\">\n          <label for=\"captadorSelect\">Captador</label>\n          <select id=\"captadorSelect\" required>\n            <option value=\"\" disabled selected>Selecione uma opção</option>\n            <option value=\"Andrina\">Andrina</option>\n            <option value=\"Giulia\">Giulia</option>\n          </select>\n          <div class=\"hint\">Escolha apenas um captador.</div>\n        </div>\n\n        <!-- NOVO CAMPO: Nível -->\n        <div class=\"field\">\n          <label for=\"nivelSelect\">Nível</label>\n          <select id=\"nivelSelect\" required>\n            <option value=\"\" disabled selected>Selecione uma opção</option>\n            <option value=\"Bronze\">Bronze</option>\n            <option value=\"Prata\">Prata</option>\n            <option value=\"Ouro\">Ouro</option>\n          </select>\n          <div class=\"hint\">Escolha apenas um nível.</div>\n        </div>\n\n        <div class=\"field\">\n          <label for=\"numeroInput\">Números da unidade</label>\n\n          <div class=\"chips\" id=\"chips\" aria-label=\"Lista de números\">\n            <input\n              id=\"numeroInput\"\n              class=\"chips-input\"\n              type=\"tel\"\n              inputmode=\"tel\"\n              autocomplete=\"tel\"\n              placeholder=\"Digite o número e pressione Enter ou Espaço (ou cole vários)\"\n            />\n          </div>\n\n          <div class=\"hint\">Use DDI + DDD + número (somente números). Separe com Enter, espaço ou vírgula.</div>\n        </div>\n\n        <div class=\"field\">\n          <label>Pessoas a serem adicionadas</label>\n          <div class=\"checklist\" id=\"checklist\"></div>\n          <div class=\"hint\">Selecione uma ou mais pessoas.</div>\n        </div>\n\n        <div class=\"actions\">\n          <button id=\"btnEnviar\" class=\"btn btn-primary\" type=\"submit\">\n            <span class=\"spinner\" aria-hidden=\"true\"></span>\n            <span>Criar grupos</span>\n          </button>\n          <button class=\"btn btn-ghost\" type=\"button\" id=\"btnLimpar\">Limpar</button>\n        </div>\n\n        <div id=\"toast\" class=\"toast\" aria-live=\"polite\"></div>\n      </form>\n    </div>\n  </section>\n\n  <!-- Modal -->\n  <div class=\"modal-backdrop\" id=\"modalBackdrop\" role=\"dialog\" aria-modal=\"true\" aria-hidden=\"true\">\n    <div class=\"modal\" role=\"document\">\n      <div class=\"modal-head\">\n        <h2 class=\"modal-title\" id=\"modalTitle\">Aviso</h2>\n        <button class=\"x\" id=\"modalClose\" aria-label=\"Fechar\">×</button>\n      </div>\n      <div class=\"modal-body\">\n        <p class=\"modal-msg\" id=\"modalMsg\"></p>\n        <div class=\"linkbox\" id=\"modalLinkBox\"></div>\n      </div>\n      <div class=\"modal-actions\">\n        <button class=\"btn btn-ghost\" id=\"btnCopiar\" type=\"button\" style=\"display:none;\">Copiar link</button>\n        <button class=\"btn btn-primary\" id=\"btnAbrir\" type=\"button\" style=\"display:none;\">Abrir Chatwoot</button>\n        <button class=\"btn\" id=\"btnOk\" type=\"button\">OK</button>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    // WEBHOOKS NOVOS\n    const ENDPOINT_SESSOES = \"https://webhookbolsa.bmbr.com.br/webhook/44d246ef-0f44-46cb-a554-d0136fd153fe\";\n    const ENDPOINT_ENVIO   = \"https://webhookbolsa.bmbr.com.br/webhook/01df8ec1-9633-4ee4-b113-1bf170193836\";\n\n    const PESSOAS = [\n      \"Rosa\",\n      \"Matheus\",\n      \"Lucas\",\n      \"Andrina\",\n      \"Giulia\",\n      \"Lorena\",\n      \"Juliana\",\n      \"Joanna\",\n      \"Francielle\",\n      \"Carol\",\n    ];\n\n    const $ = (sel) => document.querySelector(sel);\n\n    const form = $(\"#form\");\n    const sessaoSelect = $(\"#sessaoSelect\");\n    const nomeGrupoInput = $(\"#nomeGrupo\");\n    const captadorSelect = $(\"#captadorSelect\");\n    const nivelSelect = $(\"#nivelSelect\");\n    const toast = $(\"#toast\");\n    const btnEnviar = $(\"#btnEnviar\");\n    const btnLimpar = $(\"#btnLimpar\");\n\n    // Chips\n    const chips = $(\"#chips\");\n    const numeroInput = $(\"#numeroInput\");\n    let numeros = [];\n\n    // Checklist\n    const checklist = $(\"#checklist\");\n\n    // Modal\n    const modalBackdrop = $(\"#modalBackdrop\");\n    const modalTitle = $(\"#modalTitle\");\n    const modalMsg = $(\"#modalMsg\");\n    const modalClose = $(\"#modalClose\");\n    const btnOk = $(\"#btnOk\");\n    const btnAbrir = $(\"#btnAbrir\");\n    const btnCopiar = $(\"#btnCopiar\");\n    const modalLinkBox = $(\"#modalLinkBox\");\n\n    function setLoading(isLoading){\n      btnEnviar.disabled = isLoading;\n      btnEnviar.classList.toggle(\"loading\", isLoading);\n      btnLimpar.disabled = isLoading;\n      sessaoSelect.disabled = isLoading || sessaoSelect.dataset.locked === \"1\";\n      nomeGrupoInput.disabled = isLoading;\n      captadorSelect.disabled = isLoading;\n      nivelSelect.disabled = isLoading;\n      numeroInput.disabled = isLoading;\n      checklist.querySelectorAll(\"input[type='checkbox']\").forEach(cb => cb.disabled = isLoading);\n    }\n\n    function lockSessaoSelect(locked){\n      sessaoSelect.dataset.locked = locked ? \"1\" : \"0\";\n      sessaoSelect.disabled = locked;\n    }\n\n    function showToast(text, isError=false){\n      toast.textContent = text || \"\";\n      toast.classList.toggle(\"error\", !!isError);\n    }\n\n    function openModal({ title=\"Aviso\", message=\"\", link=null }){\n      modalTitle.textContent = title;\n      modalMsg.textContent = message;\n\n      if (link){\n        modalLinkBox.style.display = \"block\";\n        modalLinkBox.textContent = link;\n\n        btnAbrir.style.display = \"inline-flex\";\n        btnCopiar.style.display = \"inline-flex\";\n\n        btnAbrir.onclick = () => window.open(link, \"_blank\", \"noopener,noreferrer\");\n        btnCopiar.onclick = async () => {\n          try{\n            await navigator.clipboard.writeText(link);\n            showToast(\"Link copiado.\", false);\n          }catch(e){\n            showToast(\"Não foi possível copiar automaticamente. Copie manualmente.\", true);\n          }\n        };\n      }else{\n        modalLinkBox.style.display = \"none\";\n        modalLinkBox.textContent = \"\";\n        btnAbrir.style.display = \"none\";\n        btnCopiar.style.display = \"none\";\n        btnAbrir.onclick = null;\n        btnCopiar.onclick = null;\n      }\n\n      modalBackdrop.classList.add(\"show\");\n      modalBackdrop.setAttribute(\"aria-hidden\", \"false\");\n      btnOk.focus();\n    }\n\n    function closeModal(){\n      modalBackdrop.classList.remove(\"show\");\n      modalBackdrop.setAttribute(\"aria-hidden\", \"true\");\n    }\n\n    modalClose.addEventListener(\"click\", closeModal);\n    btnOk.addEventListener(\"click\", closeModal);\n    modalBackdrop.addEventListener(\"click\", (e) => {\n      if (e.target === modalBackdrop) closeModal();\n    });\n    document.addEventListener(\"keydown\", (e) => {\n      if (e.key === \"Escape\" && modalBackdrop.classList.contains(\"show\")) closeModal();\n    });\n\n    function normalizePhone(raw){\n      return (raw || \"\").replace(/\\D/g, \"\");\n    }\n\n    function isValidPhone(digits){\n      return digits.length >= 10 && digits.length <= 15;\n    }\n\n    function renderNumeros(){\n      chips.querySelectorAll(\".chip\").forEach(el => el.remove());\n\n      numeros.forEach((n) => {\n        const chip = document.createElement(\"div\");\n        chip.className = \"chip\";\n        chip.dataset.value = n;\n\n        const text = document.createElement(\"span\");\n        text.textContent = n;\n\n        const btn = document.createElement(\"button\");\n        btn.type = \"button\";\n        btn.className = \"xchip\";\n        btn.setAttribute(\"aria-label\", \"Remover número\");\n        btn.textContent = \"×\";\n        btn.onclick = () => {\n          numeros = numeros.filter(x => x !== n);\n          renderNumeros();\n          numeroInput.focus();\n        };\n\n        chip.appendChild(text);\n        chip.appendChild(btn);\n        chips.insertBefore(chip, numeroInput);\n      });\n    }\n\n    function addNumero(raw){\n      const digits = normalizePhone(raw);\n      if (!digits) return false;\n\n      if (!isValidPhone(digits)){\n        openModal({ title: \"Erro\", message: \"Número inválido. Use DDI + DDD + número (somente números).\" });\n        return false;\n      }\n\n      if (numeros.includes(digits)) return true;\n      numeros.push(digits);\n      renderNumeros();\n      return true;\n    }\n\n    function addFromBuffer(buffer){\n      const parts = String(buffer || \"\")\n        .split(/[\\s,;\\n\\r\\t]+/g)\n        .map(s => s.trim())\n        .filter(Boolean);\n\n      let added = 0;\n      for (const p of parts){\n        if (addNumero(p)) added++;\n      }\n      return added;\n    }\n\n    numeroInput.addEventListener(\"keydown\", (e) => {\n      if (e.key === \"Enter\" || e.key === \" \" || e.key === \",\" || e.key === \"Tab\"){\n        const val = numeroInput.value.trim();\n        if (val){\n          e.preventDefault();\n          addFromBuffer(val);\n          numeroInput.value = \"\";\n        } else if (e.key === \"Tab\") {\n          // tab normal quando vazio\n        } else {\n          e.preventDefault();\n        }\n      } else if (e.key === \"Backspace\" && !numeroInput.value){\n        if (numeros.length){\n          numeros.pop();\n          renderNumeros();\n        }\n      }\n    });\n\n    numeroInput.addEventListener(\"blur\", () => {\n      const val = numeroInput.value.trim();\n      if (val){\n        addFromBuffer(val);\n        numeroInput.value = \"\";\n      }\n    });\n\n    numeroInput.addEventListener(\"paste\", (e) => {\n      const text = (e.clipboardData || window.clipboardData).getData(\"text\");\n      if (text && /[\\s,;\\n\\r\\t]/.test(text)){\n        e.preventDefault();\n        addFromBuffer(text);\n      }\n    });\n\n    chips.addEventListener(\"click\", () => numeroInput.focus());\n\n    function buildChecklist(){\n      checklist.innerHTML = \"\";\n      for (const nome of PESSOAS){\n        const label = document.createElement(\"label\");\n        label.className = \"checkitem\";\n\n        const cb = document.createElement(\"input\");\n        cb.type = \"checkbox\";\n        cb.value = nome;\n        cb.name = \"pessoas\";\n\n        const span = document.createElement(\"span\");\n        span.textContent = nome;\n\n        label.appendChild(cb);\n        label.appendChild(span);\n        checklist.appendChild(label);\n      }\n    }\n\n    function getSelectedPeople(){\n      return Array.from(checklist.querySelectorAll(\"input[type='checkbox']:checked\"))\n        .map(cb => cb.value);\n    }\n\n    async function carregarSessoes(){\n      lockSessaoSelect(true);\n      sessaoSelect.innerHTML = `<option value=\"\" disabled selected>Carregando opções...</option>`;\n      showToast(\"Carregando opções...\");\n\n      try{\n        const resp = await fetch(ENDPOINT_SESSOES, {\n          method: \"POST\",\n          headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify({})\n        });\n\n        const data = await resp.json();\n\n        if (!Array.isArray(data) || data.length === 0) throw new Error(\"Lista vazia\");\n\n        sessaoSelect.innerHTML = `<option value=\"\" disabled selected>Selecione uma opção</option>`;\n\n        for (const item of data){\n          const value = (item?.sessao ?? \"\").trim();\n          const label = (item?.display ?? value).trim();\n          if (!value) continue;\n\n          const opt = document.createElement(\"option\");\n          opt.value = value;\n          opt.textContent = label;\n          sessaoSelect.appendChild(opt);\n        }\n\n        if (sessaoSelect.options.length <= 1) throw new Error(\"Sem opções válidas\");\n\n        lockSessaoSelect(false);\n        showToast(\"\");\n      }catch(e){\n        sessaoSelect.innerHTML = `<option value=\"\" disabled selected>Não foi possível carregar</option>`;\n        lockSessaoSelect(true);\n        showToast(\"Não foi possível carregar as opções.\", true);\n        openModal({\n          title: \"Atenção\",\n          message: \"Não foi possível carregar os números disponíveis. Recarregue a página e tente novamente.\"\n        });\n      }\n    }\n\n    form.addEventListener(\"submit\", async (e) => {\n      e.preventDefault();\n      showToast(\"\");\n\n      const sessaoVal = (sessaoSelect.value || \"\").trim();\n      const nomeGrupo = (nomeGrupoInput.value || \"\").trim();\n      const captador = (captadorSelect.value || \"\").trim();\n      const nivel = (nivelSelect.value || \"\").trim();\n      const pessoas = getSelectedPeople();\n\n      // confirma número pendente digitado\n      const pending = numeroInput.value.trim();\n      if (pending){\n        addFromBuffer(pending);\n        numeroInput.value = \"\";\n      }\n\n      if (!sessaoVal){\n        openModal({ title: \"Erro\", message: \"Selecione por qual número a ação será feita.\" });\n        return;\n      }\n      if (!nomeGrupo){\n        openModal({ title: \"Erro\", message: \"Informe o nome do grupo.\" });\n        return;\n      }\n      if (!captador){\n        openModal({ title: \"Erro\", message: \"Selecione um captador.\" });\n        return;\n      }\n      if (!nivel){\n        openModal({ title: \"Erro\", message: \"Selecione um nível (Bronze, Prata ou Ouro).\" });\n        return;\n      }\n      if (!numeros.length){\n        openModal({ title: \"Erro\", message: \"Informe ao menos um número da unidade.\" });\n        return;\n      }\n      if (!pessoas.length){\n        openModal({ title: \"Erro\", message: \"Selecione ao menos uma pessoa a ser adicionada.\" });\n        return;\n      }\n\n      setLoading(true);\n      showToast(\"Enviando...\");\n\n      try{\n        const resp = await fetch(ENDPOINT_ENVIO, {\n          method: \"POST\",\n          headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify({\n            sessao: sessaoVal,\n            nomeGrupo: nomeGrupo,\n            captador: captador,\n            nivel: nivel,\n            numeros: numeros,\n            pessoas: pessoas\n          })\n        });\n\n        const data = await resp.json();\n        const status = !!data?.status;\n        const link = data?.link ?? null;\n\n        if (!status || !link){\n          openModal({ title: \"Falha\", message: \"Não foi possível concluir a ação com os dados informados.\", link: null });\n          showToast(\"Falha na solicitação.\", true);\n        } else {\n          openModal({\n            title: \"Sucesso\",\n            message: \"Grupos criados/atualizados com sucesso. Segue o link abaixo.\",\n            link\n          });\n          showToast(\"Solicitação enviada.\");\n        }\n      }catch(err){\n        openModal({\n          title: \"Não foi possível enviar\",\n          message: \"Tivemos um problema ao enviar sua solicitação. Tente novamente em instantes.\"\n        });\n        showToast(\"Erro ao enviar.\", true);\n      }finally{\n        setLoading(false);\n      }\n    });\n\n    btnLimpar.addEventListener(\"click\", () => {\n      form.reset();\n      numeros = [];\n      renderNumeros();\n      numeroInput.value = \"\";\n      checklist.querySelectorAll(\"input[type='checkbox']\").forEach(cb => cb.checked = false);\n      showToast(\"\");\n      if (sessaoSelect.options.length > 0) sessaoSelect.selectedIndex = 0;\n      if (captadorSelect.options.length > 0) captadorSelect.selectedIndex = 0;\n      if (nivelSelect.options.length > 0) nivelSelect.selectedIndex = 0;\n      nomeGrupoInput.focus();\n    });\n\n    // init\n    buildChecklist();\n    carregarSessoes();\n    renderNumeros();\n  </script>\n</body>\n</html>\n"},"type":"n8n-nodes-base.html","typeVersion":1.2,"position":[192,656],"id":"03fa4032-57bf-47ef-9015-66b73bb39f76","name":"HTML"},{"parameters":{"respondWith":"text","responseBody":"={{ $json.html }}","options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[384,656],"id":"d6096a22-71e8-4230-aa77-422aaf9193ae","name":"Respond to Webhook"},{"parameters":{"resource":"Sessions","operation":"List","all":true,"requestOptions":{}},"type":"n8n-nodes-waha.WAHA","typeVersion":202411,"position":[192,0],"id":"3fd030e3-de71-4677-b3b1-46fee516b5d9","name":"List all sessions1","credentials":{"wahaApi":{"id":"ZSKOfTrheV9bZb7M","name":"WAHA account"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"dfdb218b-654d-440d-b3ac-1fa5b1143fa6","leftValue":"={{ $json.status }}","rightValue":"WORKING","operator":{"type":"string","operation":"equals"}},{"id":"3cb85bc8-5530-4b19-8f33-b3ad8510d4bf","leftValue":"={{ $json.name }}","rightValue":"ag_imoveis","operator":{"type":"string","operation":"notEquals"}},{"id":"94a3c53a-886b-4bda-af27-8084efbf7d8d","leftValue":"={{ $json.name }}","rightValue":"unidade","operator":{"type":"string","operation":"notContains"}},{"id":"0ec7fd99-904d-4441-a739-fc15218d4df2","leftValue":"={{ $json.name }}","rightValue":"caio-imaizumi","operator":{"type":"string","operation":"notEquals"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.filter","typeVersion":2.3,"position":[384,0],"id":"9f2ed4c5-603