;\n\n  const rest = d.slice(2);\n  if (rest.length < 10) return null;\n\n  const ddd = rest.slice(0, 2);\n  let subscriber = rest.slice(2);\n\n  if (subscriber.length >= 9) subscriber = subscriber.slice(-9);\n  else subscriber = \"9\" + subscriber.slice(-8);\n\n  if (!subscriber.startsWith(\"9\")) subscriber = \"9\" + subscriber.slice(-8);\n\n  return \"55\" + ddd + subscriber;\n}\n\nconst numerosFormatados = numeros.map(toBRMobile13).filter(Boolean);\n\n// OUTPUT: apenas os números formatados\nreturn [{ json: { numerosFormatados } }];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[768,320],"id":"605f27e2-8938-4040-ba0e-7509c987e70d","name":"Formatar Números"},{"parameters":{"jsCode":"const items = $input.all();\nconst pick = items[Math.floor(Math.random() * items.length)];\nreturn [pick];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[576,320],"id":"e4e09ac1-3793-41be-a9ca-11cee75190e5","name":"Selecionar instância aleatoriamente"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"dfdb218b-654d-440d-b3ac-1fa5b1143fa6","leftValue":"={{ $json.status }}","rightValue":"WORKING","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.filter","typeVersion":2.3,"position":[384,320],"id":"c3339c47-1700-49b8-8756-c6f5a3a369e2","name":"Filtrar ativas"},{"parameters":{"resource":"Sessions","operation":"List","all":true,"requestOptions":{}},"type":"n8n-nodes-waha.WAHA","typeVersion":202411,"position":[192,320],"id":"92363d6d-691e-43e6-98ad-b9e62b69ead5","name":"Listar seções","credentials":{"wahaApi":{"id":"ZSKOfTrheV9bZb7M","name":"WAHA account"}}},{"parameters":{"httpMethod":"POST","path":"01df8ec1-9633-4ee4-b113-1bf170193836","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,320],"id":"e818a228-58b7-4018-a20f-36f6d88f5360","name":"Webhook1","webhookId":