s\":\n// 1) números em \"numeros unidades\"\n// 2) o número correspondente ao campo \"instancia\" dentro de \"lista de numeros instancias\" (string JSON)\n//\n// Entrada:\n// item.json.participantes = [{id:\"...@c.us\"}, ...]\n// item.json[\"numeros unidades\"] = [\"55...\", ...]\n// item.json.instancia = \"matheus\" (nome)\n// item.json[\"lista de numeros instancias\"] = \"{...}\" (JSON string)\n//\n// Saída: { participantes: [...] } sem números de unidade e sem número da instância\n\nfunction digitsOnly(v) {\n  return String(v ?? \"\").replace(/\\D/g, \"\");\n}\n\n// Variações BR com/sem o '9' após o DDD\nfunction brVariants(value) {\n  const d = digitsOnly(value);\n  const out = new Set();\n  if (!d) return out;\n\n  out.add(d);\n\n  // Se for BR e tiver 13 dígitos (55 + DDD + 9 + XXXXXXXX)\n  if (d.startsWith(\"55\") && d.length === 13 && d[4] === \"9\") {\n    out.add(d.slice(0, 4) + d.slice(5)); // remove o 9 (posição 4)\n  }\n\n  // Se for BR e tiver 12 dígitos (sem o 9), cria versão com 9\n  if (d.startsWith(\"55\") && d.length === 12) {\n    out.add(d.slice(0, 4) + \"9\" + d.slice(4)); // insere o 9\n  }\n\n  return out;\n}\n\nfunction safeParseJson(str) {\n  if (typeof str !== \"string\") return null;\n  try { return JSON.parse(str); } catch { return null; }\n}\n\nconst allItems = $input.all();\n\n// 1) montar set de números proibidos (unidades + instância)\nconst banned = new Set();\n\n// 1a) números unidades\nfor (const item of allItems) {\n  const nums =\n    item.json[\"numeros unidades\"] ||\n    item.json.numerosUnidades ||\n    item.json[\"Numeros Unidades\"] ||\n    [];\n\n  for (const n of nums) {\n    for (const v of brVariants(n)) banned.add(v);\n  }\n}\n\n// 1b) número da instância selecionada (nome -> telefone)\nfor (const item of allItems) {\n  const instanciaNomeRaw = item.json.instancia;\n  const instanciaNome = String(instanciaNomeRaw ?? \"\").trim();\n  if (!instanciaNome) continue;\n\n  const mapaStr = item.json[\"lista de numeros instancias\"];\n  const mapa = safeParseJson(mapaStr);\n\n  if (mapa && typeof mapa === \"object\") {\n    // tenta achar com várias capitalizações (matheus vs Matheus etc.)\n    const keys = Object.keys(mapa);\n    const matchKey = keys.find(k => String(k).trim().toLowerCase() === instanciaNome.toLowerCase());\n\n    if (matchKey) {\n      const phone = mapa[matchKey];\n      for (const v of brVariants(phone)) banned.add(v);\n    }\n  }\n}\n\n// 2) filtrar participantes\nconst participantesFiltrados = [];\n\nfor (const item of allItems) {\n  const participantes = item.json.participantes || [];\n\n  for (const p of participantes) {\n    const id = p?.id ?? \"\";\n    const vars = brVariants(id);\n\n    let deveRemover = false;\n    for (const v of vars) {\n      if (banned.has(v)) {\n        deveRemover = true;\n        break;\n      }\n    }\n\n    if (!deveRemover) {\n      participantesFiltrados.push({ id }); // mantém o formato {id:\"...\"}\n    }\n  }\n}\n\nreturn [\n  {\n    json: {\n      participantes: participantesFiltrados\n    }\n  }\n];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2304,320],"id":"95213de0-bc5a-47d5-b004-48612bd4d149","name":"Id Administradores"},{"parameters":{"assignments":{"assignments":[{"id":"f9240b7c-4d42-4de8-b9b7-f08a4825c578","name":"participantes","value":"={{ $('Organizar Participantes').item.json.participants }}","type":"array"},{"id":"fcad9d14-8510-4ab4-ae7d-790a7156684e","name":"numeros unidades","value":"={{ $('Buscar Chat IDs').item.json.numerosUnidades }}","type":"array"},{"id":"2c3e861e-aca5-405a-97a0-88fbecbaa657","name":"instancia","value":"={{ $('Webhook1').item.json.body.sessao }}","type":"string"},{"id":"7d87a4c4-4b6d-4567-93a2-c51536a7f5f7","name":"lista de numeros instancias","value":"={{ $('Lista de números').item.json }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[2112,320],"id":"160c9d04-1c5f-41ae-af3a-4cdfa514f792","name":"Separar Dados"},{"parameters":{"resource":"Groups","operation":"Set Description","session":"={{ $('Webhook1').item.json.body.sessao }}","id":"={{ $('Criar o grupo').item.json.JID }}","description":"=Olá, Unidade \n\nQueremos informar que o drive com as imagens para as redes sociais está disponível para vocês. Essas imagens foram especialmente selecionadas para ajudar na divulgação dos nossos cursos e bolsas de desconto. 🌟\n\nhttps://drivedobolsa.com.br/ \n\n⚠ Importante: Por favor, não utilizem imagens dos artistas que estão na página oficial do Bolsa Mais Brasil e EJA Mais Brasil, assim como em nosso site, YouTube, TikTok ou qualquer outro canal. Essas imagens são exclusivas e devem ser usadas apenas pelos nossos canais oficiais.\n\nAgradecemos pela compreensão e pela colaboração de todos! \nSe precisarem de algo mais, estamos à disposição.","requestOptions":{}},"type":"n8n-nodes-waha.WAHA","typeVersion":202411,"position":[1920,320],"id":"7310c899-6ed2-4054-9aaa-a5193d1234e9","name":"Atualizar Descrição do Grupo","credentials":{"wahaApi":{"id":"ZSKOfTrheV9bZb7M","name":"WAHA account"}}},{"parameters":{"resource":"Groups","operation":"Set Info Admin Only","session":"={{ $('Webhook1').item.json.body.sessao }}","id":"={{ $json.JID }}","requestOptions":{}},"type":"n8n-nodes-waha.WAHA","typeVersion":202411,"position":[1728,320],"id":"94c94929-3367-4978-836b-c4d13dcff5c7","name":"Definir apenas admins alterar dados","credentials":{"wahaApi":{"id":"ZSKOfTrheV9bZb7M","name":"WAHA account"}}},{"parameters":{"resource":"Groups","operation":"Create Group","session":"={{ $('Webhook1').item.json.body.sessao }}","name":"={{ $('Webhook1').item.json.body.nomeGrupo }}","participants":"={{ $json.participants.toJsonString() }}","requestOptions":{}},"type":"n8n-nodes-waha.WAHA","typeVersion":202411,"position":[1536,320],"id":"65e12b6d-a2f8-418d-b697-eabe655dd93d","name":"Criar o grupo","credentials":{"wahaApi":{"id":"ZSKOfTrheV9bZb7M","name":"WAHA account"}}},{"parameters":{"jsCode":"const set = new Set();\n\nfor (const item of $input.all()) {\n  const ids = item.json.chatIds || [];\n  for (const id of ids) if (id) set.add(id);\n}\n\nreturn [\n  {\n    json: {\n      participants: [...set].map(id => ({ id })),\n    },\n  },\n];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1344,320],"id":"c743cac8-df37-4885-912d-5323c60d096d","name":"Organizar Participantes"},{"parameters":{"jsCode":"// n8n Code Node (Run Once for All Items)\n// Retorna chatIds únicos contendo: pessoas (Números a serem conectados) + números da unidade (Numeros Unidades)\n\n// Config WAHA (hardcoded porque você pediu)\nconst BASE_URL = 'http://waha.bmbr.com.br'.replace(/\\/+$/, '');\nconst API_KEY = '7cf698ac74c6bc3cb3fe34a3131a3927';\n\nfunction digitsOnly(value) {\n  return String(value ?? '').replace(/\\D/g, '');\n}\n\nfunction safeJsonParseArray(maybe) {\n  if (Array.isArray(maybe)) return maybe;\n  if (typeof maybe !== 'string') return [];\n  try {\n    const parsed = JSON.parse(maybe);\n    return Array.isArray(parsed) ? parsed : [];\n  } catch {\n    // fallback: \"5531...,5531...\" => [\"5531...\",\"5531...\"]\n    return maybe.split(',').map(s => s.trim()).filter(Boolean);\n  }\n}\n\nasync function wahaCheckExists(phoneDigits, session) {\n  const url =\n    `${BASE_URL}/api/contacts/check-exists` +\n    `?phone=${encodeURIComponent(phoneDigits)}` +\n    `&session=${encodeURIComponent(session)}`;\n\n  return await this.helpers.httpRequest({\n    method: 'GET',\n    url,\n    headers: {\n      Accept: 'application/json',\n      'X-Api-Key': API_KEY,\n    },\n    json: true,\n    timeout: 60_000,\n  });\n}\n\nasync function mapLimit(list, limit, mapper) {\n  const results = new Array(list.length);\n  let idx = 0;\n\n  async function worker() {\n    while (idx < list.length) {\n      const current = idx++;\n      results[current] = await mapper(list[current], current);\n    }\n  }\n\n  const workers = Array.from({ length: Math.max(1, limit) }, () => worker());\n  await Promise.all(workers);\n  return results;\n}\n\nconst output = [];\n\nfor (const item of items) {\n  const data = item.json ?? {};\n\n  const session =\n    data['Instância'] ||\n    data['Instancia'] ||\n    data['session'] ||\n    data['Session'];\n\n  if (!session) throw new Error('Campo \"Instância\" (session) não encontrado no input.');\n\n  const nomes =\n    data['Números a serem conectados'] ||\n    data['Numeros a serem conectados'] ||\n    data['numbersToConnect'] ||\n    [];\n\n  if (!Array.isArray(nomes)) {\n    throw new Error('Campo \"Números a serem conectados\" precisa ser um array de nomes.');\n  }\n\n  const numerosUnidades = safeJsonParseArray(\n    data['Numeros Unidades'] ?? data['Números Unidades'] ?? data['NumerosUnidades']\n  );\n\n  // Pessoas (nomes -> telefone no objeto)\n  const tasksPeople = nomes.map((nome) => {\n    const phoneRaw = data[nome];\n    return {\n      tipo: 'pessoa',\n      nome,\n      phoneRaw: phoneRaw ?? null,\n      phoneDigits: digitsOnly(phoneRaw),\n    };\n  });\n\n  // Unidades (telefones diretos)\n  const tasksUnits = (numerosUnidades || []).map((num, i) => ({\n    tipo: 'unidade',\n    nome: `Unidade_${i + 1}`,\n    phoneRaw: num ?? null,\n    phoneDigits: digitsOnly(num),\n  }));\n\n  const semTelefonePessoas = tasksPeople.filter(t => !t.phoneDigits);\n  const semTelefoneUnidades = tasksUnits.filter(t => !t.phoneDigits);\n\n  const validTasks = [...tasksPeople, ...tasksUnits].filter(t => t.phoneDigits);\n\n  const concurrency = 3;\n\n  const results = await mapLimit(\n    validTasks,\n    concurrency,\n    async (t) => {\n      try {\n        const resp = await wahaCheckExists.call(this, t.phoneDigits, session);\n        return {\n          tipo: t.tipo,\n          nome: t.nome,\n          phoneOriginal: t.phoneRaw,\n          phoneDigits: t.phoneDigits,\n          numberExists: Boolean(resp?.numberExists),\n          chatId: resp?.chatId ?? null,\n        };\n      } catch (err) {\n        return {\n          tipo: t.tipo,\n          nome: t.nome,\n          phoneOriginal: t.phoneRaw,\n          phoneDigits: t.phoneDigits,\n          numberExists: false,\n          chatId: null,\n          error: err?.message || String(err),\n        };\n      }\n    }\n  );\n\n  // UMA lista só: pessoas + unidades, únicos\n  const chatIds = Array.from(\n    new Set(results.filter(r => r.numberExists && r.chatId).map(r => r.chatId))\n  );\n\n  output.push({\n    json: {\n      instancia: session,\n      numerosUnidades,\n      chatIds, // <- tudo junto aqui\n      detalhes: results, // inclui tipo: pessoa/unidade\n      nomesSemTelefoneMapeado: semTelefonePessoas.map(m => ({ nome: m.nome, phoneOriginal: m.phoneRaw })),\n      unidadesSemTelefoneMapeado: semTelefoneUnidades.map(m => ({ nome: m.nome, phoneOriginal: m.phoneRaw })),\n      notRegistered: results\n        .filter(r => !r.numberExists)\n        .map(r => ({ tipo: r.tipo, nome: r.nome, phoneDigits: r.phoneDigits, error: r.error ?? null })),\n    },\n  });\n}\n\nreturn output;\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1152,320],"id":"9e88db4f-6925-47e0-a653-e828729107f0","name":"Buscar Chat IDs"},{"parameters":{"assignments":{"assignments":[{"id":"ffc101ff-b57f-4f52-a57b-2d44e9245d34","name":"Andrina","value":"+5531984596702","type":"string"},{"id":"bc14ff18-395b-497e-b509-ccca627d496c","name":"Carol","value":"+551151989608","type":"string"},{"id":"f5f974f8-cb05-42c9-b743-948544195a34","name":"Francielle","value":"+5531993326322","type":"string"},{"id":"ddf71dd0-535e-41ee-a490-c2c8ca9144c3","name":"Giulia","value":"+5531982042496","type":"string"},{"id":"cf8c04bf-d44c-4295-80be-4611bebc5dc7","name":"Joanna","value":"+5511918921016","type":"string"},{"id":"2bebde75-cb15-4573-9412-5c3739c80fc5","name":"Juliana","value":"+5531990699106","type":"string"},{"id":"f02a290e-27bf-4c07-b764-64073eeea847","name":"Lorena","value":"+5531984020750","type":"string"},{"id":"b6ac8882-faa9-42a4-a3b7-0d6c73208fdf","name":"lucas_araujo","value":"+55