8-836b-c4d13dcff5c7","name":"Definir apenas admins alterar dados","credentials":{"wahaApi":{"id":"ZSKOfTrheV9bZb7M","name":"WAHA account"}}},{"parameters":{"resource":"Groups","operation":"Create Group","session":"={{ $('Webhook1').item.json.body.sessao }}","name":"={{ $('Webhook1').item.json.body.nomeGrupo }}","participants":"={{ $json.participants.toJsonString() }}","requestOptions":{}},"type":"n8n-nodes-waha.WAHA","typeVersion":202411,"position":[1536,320],"id":"65e12b6d-a2f8-418d-b697-eabe655dd93d","name":"Criar o grupo","credentials":{"wahaApi":{"id":"ZSKOfTrheV9bZb7M","name":"WAHA account"}}},{"parameters":{"jsCode":"const set = new Set();\n\nfor (const item of $input.all()) {\n  const ids = item.json.chatIds || [];\n  for (const id of ids) if (id) set.add(id);\n}\n\nreturn [\n  {\n    json: {\n      participants: [...set].map(id => ({ id })),\n    },\n  },\n];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1344,320],"id":"c743cac8-df37-4885-912d-5323c60d096d","name":"Organizar Participantes"},{"parameters":{"jsCode":"// n8n Code Node (Run Once for All Items)\n// Retorna chatIds únicos contendo: pessoas (Números a serem conectados) + números da unidade (Numeros Unidades)\n\n// Config WAHA (hardcoded porque você pediu)\nconst BASE_URL = 'http://waha.bmbr.com.br'.replace(/\\/+$/, '');\nconst API_KEY = '7cf698ac74c6bc3cb3fe34a3131a3927';\n\nfunction digitsOnly(value) {\n  return String(value ?? '').replace(/\\D/g, '');\n}\n\nfunction safeJsonParseArray(maybe) {\n  if (Array.isArray(maybe)) return maybe;\n  if (typeof maybe !== 'string') return [];\n  try {\n    const parsed = JSON.parse(maybe);\n    return Array.isArray(parsed) ? parsed : [];\n  } catch {\n    // fallback: \"5531...,5531...\" => [\"5531...\",\"5531...\"]\n    return maybe.split(',').map(s => s.trim()).filter(Boolean);\n  }\n}\n\nasync function wahaCheckExists(phoneDigits, session) {\n  const url =\n    `${BASE_URL}/api/contacts/check-exists` +\n    `?phone=${encodeURIComponent(phoneDigits)}` +\n    `&session=${encodeURIComponent(session)}`;\n\n  return await this.helpers.httpRequest({\n    method: 'GET',\n    url,\n    headers: {\n      Accept: 'application/json',\n      'X-Api-Key': API_KEY,\n    },\n    json: true,\n    timeout: 60_000,\n  });\n}\n\nasync function mapLimit(list, limit, mapper) {\n  const results = new Array(list.length);\n  let idx = 0;\n\n  async function worker() {\n    while (idx < list.length) {\n      const current = idx++;\n      results[current] = await mapper(list[current], current);\n    }\n  }\n\n  const workers = Array.from({ length: Math.max(1, limit) }, () => worker());\n  await Promise.all(workers);\n  return results;\n}\n\nconst output = [];\n\nfor (const item of items) {\n  const data = item.json ?? {};\n\n  const session =\n    data['Instância'] ||\n    data['Instancia'] ||\n    data['session'] ||\n    data['Session'];\n\n  if (!session) throw new Error('Campo \"Instância\" (session) não encontrado no input.');\n\n  const nomes =\n    data['Números a serem conectados'] ||\n    data['Numeros a serem conectados'] ||\n    data['numbersToConnect'] ||\n    [];\n\n  if (!Array.isArray(nomes)) {\n    throw new Error('Campo \"Números a serem conectados\" precisa ser um array de nomes.');\n  }\n\n  const numerosUnidades = safeJsonParseArray(\n    data['Numeros Unidades'] ?? data['Números Unidades'] ?? data['NumerosUnidades']\n  );\n\n  // Pessoas (nomes -> telefone no objeto)\n  const tasksPeople = nomes.map((nome) => {\n    const phoneRaw = data[nome];\n    return {\n      tipo: 'pessoa',\n      nome,\n      phoneRaw: phoneRaw ?? null,\n      phoneDigits: digitsOnly(phoneRaw),\n    };\n  });\n\n  // Unidades (telefones diretos)\n  const tasksUnits = (numerosUnidades || []).map((num, i) => ({\n    tipo: 'unidade',\n    nome: `Unidade_${i + 1}`,\n    phoneRaw: num ?? null,\n    phoneDigits: digitsOnly(num),\n  }));\n\n  const semTelefonePessoas = tasksPeople.filter(t => !t.phoneDigits);\n  const semTelefoneUnidades = tasksUnits.filter(t => !t.phoneDigits);\n\n  const validTasks = [...tasksPeople, ...tasksUnits].filter(t => t.phoneDigits);\n\n  const concurrency = 3;\n\n  const results = await mapLimit(\n    validTasks,\n    concurrency,\n    async (t) => {\n      try {\n        const resp = await wahaCheckExists.call(this, t.phoneDigits, session);\n        return {\n          tipo: t.tipo,\n          nome: t.nome,\n          phoneOriginal: t.phoneRaw,\n          phoneDigits: t.phoneDigits,\n          numberExists: Boolean(resp?.numberExists),\n          chatId: resp?.chatId ?? null,\n        };\n      } catch (err) {\n        return {\n          tipo: t.tipo,\n          nome: t.nome,\n          phoneOriginal: t.phoneRaw,\n          phoneDigits: t.phoneDigits,\n          numberExists: false,\n          chatId: null,\n          error: err?.message || String(err),\n        };\n      }\n    }\n  );\n\n  // UMA lista só: pessoas + unidades, únicos\n  const chatIds = Array.from(\n    new Set(results.filter(r => r.numberExists && r.chatId).map(r => r.chatId))\n  );\n\n  output.push({\n    json: {\n      instancia: session,\n      numerosUnidades,\n      chatIds, // <- tudo junto aqui\n      detalhes: results, // inclui tipo: pessoa/unidade\n      nomesSemTelefoneMapeado: semTelefonePessoas.map(m => ({ nome: m.nome, phoneOriginal: m.phoneRaw })),\n      unidadesSemTelefoneMapeado: semTelefoneUnidades.map(m => ({ nome: m.nome, phoneOriginal: m.phoneRaw })),\n      notRegistered: results\n        .filter(r => !r.numberExists)\n        .map(r => ({ tipo: r.tipo, nome: r.nome, phoneDigits: r.phoneDigits, error: r.error ?? null })),\n    },\n  });\n}\n\nreturn output;\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1152,320],"id":"9e88db4f-6925-47e0-a653-e828729107f0","name":"Buscar Chat IDs"},{"parameters":{"assignments":{"assignments":[{"id":"ffc101ff-b57f-4f52-a57b-2d44e9245d34","name":"Andrina","value":"+5531984596702","type":"string"},{"id":"bc14ff18-395b-497e-b509-ccca627d