&& ts !== null) {\n    if (checkoutMaisRecente.ts === null || ts > checkoutMaisRecente.ts) {\n      checkoutMaisRecente = {\n        ts,\n        id: checkoutId,\n      };\n    }\n  }\n\n  // Coleta todos os telefones dessas colunas\n  for (const campo of camposTel) {\n    const raw = row[campo];\n    if (!raw) continue;\n\n    const numeroLimpo = String(raw).replace(/[^0-9]/g, \"\");\n    if (!numeroLimpo) continue;\n\n    if (!numerosMap[numeroLimpo]) {\n      numerosMap[numeroLimpo] = {\n        numero: numeroLimpo,\n        firstIndex: index, // guarda de qual item de entrada veio primeiro\n      };\n    }\n  }\n});\n\n// 2) Monta saída final: um objeto por número, com pairedItem\nconst checkoutFinal = checkoutMaisRecente.id || null;\n\nconst out = Object.values(numerosMap).map(({ numero, firstIndex }) => ({\n  json: {\n    numero,\n    CHECKOUT_ID: checkoutFinal,\n  },\n  pairedItem: {\n    item: firstIndex,\n  },\n}));\n\nreturn out;\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2480,1264],"id":"f3579552-84f5-45de-a110-d04e4c7c46d4","name":"separar numeros","executeOnce":true},{"parameters":{"operation":"getAll","team":"9014888338","space":"90144259980","folder":"90147250280","list":"901412964765","filters":{"statuses":["aguardando"]}},"type":"n8n-nodes-base.clickUp","typeVersion":1,"position":[672,464],"id":"56310956-a91b-4c89-b36a-f5a9023952aa","name":"buscar todas as tasks","credentials":{"clickUpApi":{"id":"74vuorPFMovlnboz","name":"Bolsa"}}},{"parameters":{"jsCode":"// Este node recebe \"items\" do n8n e transforma cada um\n// em um objeto com os campos desejados.\n\nreturn items.map(item => {\n  const json = item.json || {};\n  const body = json.body || {};\n  const message = body.message || {};\n  const headers = json.headers || {};\n  \n  const call = message.call || {};\n  const analysis = message.analysis || {};\n  const artifact = message.artifact || {};\n  const phoneNumberObj = message.phoneNumber || {};\n  const customerMsg = messa