tus_option_id_nao_iniciado: byName['Não Iniciado'] || null,\n    status_option_id_pendente:     byName['Pendente']     || null,\n    status_option_id_tentando:     byName['Tentando']     || null,\n    status_option_id_atendeu:      byName['Atendeu']      || null,\n    status_option_id_erro:         byName['Erro']         || null,\n    status_option_id_caixa_postal: byName['Caixa Postal'] || null,\n    status_option_id_queda:        byName['Queda']        || null,\n  } : null;\n\n  return { byName, flat };\n};\n\n// array nome/valor de TODOS os custom fields da task\nconst buildCustomFieldsNameValue = (fields = []) => {\n  const arr = [];\n\n  for (const cf of fields) {\n    let value = cf.value ?? null;\n\n    // tratar drop_down para pegar o NOME da opção (ex: \"0800: Sim\")\n    if (cf.type === 'drop_down') {\n      const opts = cf.type_config?.options || [];\n      let opt = null;\n\n      if (value != null) {\n        // tenta bater por id ou name direto\n        opt = opts.find(o => o.id === value || o.name === value);\n\n        // se não achou, tenta interpretar como índice / orderindex\n        if (!opt) {\n          const vNum = Number(value);\n          if (!Number.isNaN(vNum)) {\n            opt = opts.find(o => Number(o.orderindex) === vNum);\n          }\n        }\n      }\n\n      if (opt) {\n        value = opt.name;\n      }\n    }\n\n    arr.push({\n      name: cf.name || null,\n      value: value,\n    });\n  }\n\n  return arr;\n};\n\n// ====== CALL-ID DO NODE \"organizar dados\" ======\nlet incomingCallId = \"\";\ntry {\n  incomingCallId = String($(\"organizar dados\").first().json?.[\"call-id\"] || \"\").trim();\n} catch {}\nif (!incomingCallId) {\n  return [{\n    json: {\n      error: 'call-id ausente',\n      hint: 'Confirme o node \"organizar dados\" e a chave .json[\"call-id\"].'\n    }\n  }];\n}\n\n// ====== NORMALIZAÇÃO DE TASKS ======\nlet tasks = [];\n{\n  const first = $input.first()?.json;\n  if (Array.isArray(first) && first[0]?.custom_fields) {\n    tasks = first;\n  } else if (first && Array.isArray(first.tasks)) {\n    tasks = first.tasks;\n  } else {\n    tasks = $input.all().map(i => i.json).filter(t => t?.custom_fields);\n  }\n}\nif (!tasks.length) {\n  return [{ json: { error: 'Nenhuma task válida no input.' } }];\n}\n\n// ====== VARREDURA ======\nconst out = [];\n\nfor (const task of tasks) {\n  const fields = task.custom_fields || [];\n  let matched = null;\n\n  for (let n = 1; n <= 5; n++) {\n    const callIdField = pickCF(fields, `T${n}_CallID`);\n    const val = callIdField?.value ? String(callIdField.value) : null;\n    if (val && val === incomingCallId) {\n      const statusField = pickCF(fields, `T${n}_Status`);\n      const dataField   = pickCF(fields, `T${n}_Data`);\n      const { byName, flat } = buildStatusOptionMap(statusField);\n\n      const base = {\n        task_id: task.id,\n        task_name: task.name || null,\n        t_number: n,\n        t_key: `T${n}`,\n        status_field_id: statusField?.id || null,\n        data_field_id:   dataField?.id   || null,\n        callid_field_id: callIdField?.id || null,\n        status_option_ids: byName, // mapa compacto: \"rótulo\" -> \"id\"\n        // NOVO: array com todos os custom fields em nome/valor\n        custom_fields_name_value: buildCustomFieldsNameValue(fields),\n      };\n\n      matched = INCLUDE_FLAT_ALIASES ? { ...base, ...flat } : base;\n      break;\n    }\n  }\n\n  if (matched) out.push({ json: matched });\n}\n\nif (!out.length) {\n  return [{\n    json: {\n      info: 'Nenhum T{n}_CallID igual ao call-id informado.',\n      call_id_busca: incomingCallId,\n      dica: 'Verifique se o valor em \"organizar dados\" → [\"call-id\"] bate com algum Tn_CallID.value.'\n    }\n  }];\n}\n\nreturn out;\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[880,1280],"id":"e26fa66f-a96b-406b-b95c-132dd89a653b","name":"gerar ids de status"},{"parameters":{"documentId":{"__rl":true,"value":"1lfnRdSoul260YqC1NSbegHezMI