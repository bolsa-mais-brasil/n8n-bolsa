ll","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"Bearer 70bc1e8e-d277-4ebb-9015-8ad0ef9b04ab"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"assistantId\": \"{{$('dados para vapi').item.json.vapi.id.assistente}}\",\n  \"phoneNumberId\": \"{{$('dados para vapi').item.json.vapi.id.phone}}\",\n  \"customer\": {\n    \"number\": \"+{{$('dados para vapi').item.json.vapi.Telefone_13}}\",\n    \"name\": \"{{$('dados para vapi').item.json.vapi.name.slice(-40)}}\"\n  },\n  \"assistantOverrides\": {\n    \"variableValues\": {\n      \"nome\": \"{{$('dados para vapi').item.json.vapi.name.slice(-40)}}\",\n      \"curso\": \"{{$('dados para vapi').item.json.vapi.Curso_interesse}}\",\n      \"cidade\": \"{{$('dados para vapi').item.json.vapi.Cidade_interesse}}\",\n      \"task_id\": \"{{ $json.clickup.task_id }}\"\n    },\n    \"firstMessage\": \"Olá, aqui é o Leonardo. Estou falando com {{$('dados para vapi').item.json.vapi.name.split(' ')[0]}}?\"\n  }\n}\n","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2288,608],"id":"d5072474-b248-45ae-b3c1-f1ebb2d72ce7","name":"Solicitar ligacao 2"},{"parameters":{"url":"=https://api.vapi.ai/call/{{ $('Solicitar ligacao 1').item.json.id }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"Bearer fa43979b-cfcf-4791-81b9-93c44dca7943"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[3248,464],"id":"2791fcce-c604-4873-86ee-5c0680f1f65c","name":"Buscar status da ligacao 1"},{"parameters":{"amount":30},"type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[3024,752],"id":"5e0acb7f-0e73-46ed-a484-aa0e4da1e71a","name":"10s2","webhookId":"80465669-9387-481b-b70d-67b7173c4f6f"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"2f5c1373-c953-4492-9260-024dd9760f48","leftValue":"={{ $json.endedReason }}","rightValue":"erro","operator":{"type":"string","operation":"notContains"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[3456,464],"id":"dede3c7a-caa2-4a28-aeaf-e79c8ce9fbb1","name":"T1 ERRO? "},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"2f5c1373-c953-4492-9260-024dd9760f48","leftValue":"={{ $json.endedReason }}","rightValue":"erro","operator":{"type":"string","operation":"notContains"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[3472,608],"id":"5eb78aea-2ca9-4f36-a651-f4e5f0406050","name":"T2 ERRO? "},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"2f5c1373-c953-4492-9260-024dd9760f48","leftValue":"={{ $json.endedReason }}","rightValue":"erro","operator":{"type":"string","operation":"notContains"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[3456,752],"id":"711f2417-6359-4049-bd8e-b578bd523371","name":"T3 ERRO? "},{"parameters":{"jsCode":"// Pega a data atual em UTC\nconst nowUtc = new Date();\n\n// Ajusta para UTC-3\nconst offsetMs = -3 * 60 * 60 * 1000; \nconst now = new Date(nowUtc.getTime() + offsetMs);\n\n// Extrai hora, minuto e dia já ajustados\nconst hour = now.getUTCHours(); \nconst minute = now.getUTCMinutes();\nconst day = now.getUTCDay(); // 0=domingo, 1=segunda\n\n// Validação rigorosa de horário comercial (08h00 - 17h59)\nif (day >= 1 && day <= 5 && hour >= 8 && hour < 18) {\n  return [{\n    horario_valido: true,\n    hora_atual: hour,\n    minuto_atual: minute,\n    dia_semana: day,\n    timestamp: now.toISOString()\n  }];\n} else {\n  return [{\n    horario_valido: false,\n    motivo: `Fora do horário comercial - Dia: ${day}, Hora: ${hour}h${minute}m`,\n    timestamp: now.toISOString()\n  }];\n}\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[208,464],"id":"70fcb203-6c01-4bae-8602-5bae80b08918","name":"verifica horario"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"da9153c3-66ee-4cdb-900c-affbf7cb74bf","leftValue":"={{ $json.horario_valido }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[432,464],"id":"443c6f9c-ade0-481e-bdc7-505ade99947f","name":"horario comercial?"},{"parameters":{"jsCode":"// =======================\n// 1) NORMALIZAÇÃO DO INPUT\n// =======================\n\n// Pega todos os items do n8n\nconst items = $input.all();\n\n// Cada item.json pode ser uma task, um array de tasks ou um wrapper { tasks: [...] }\nlet tasks = items.map(i => i.json);\n\n// Se só veio 1 item, pode ser array ou { tasks: [...] }\nif (tasks.length === 1) {\n  const first = tasks[0];\n\n  // Caso: [ {task1}, {task2} ]\n  if (Array.isArray(first) && first[0]?.custom_fields) {\n    tasks = first;\n  }\n  // Caso: { tasks: [ {...}, {...} ] }\n  else if (first && Array.isArray(first.tasks)) {\n    tasks = first.tasks;\n  }\n  // Caso: uma única task \"solta\"\n  else if (first && first.custom_fields) {\n    tasks = [first];\n  }\n}\n\n// Garante que só fiquem tasks válidas\ntasks = tasks.filter(t => t && t.custom_fields);\n\nif (!tasks || tasks.length === 0) {\n  throw new Error('Nenhuma task encontrada no input.');\n}\n\n// =======================\n// 2) CONTROLE GLOBAL (tentativa atual / cursor)\n//    (se tiver node \"Extrair_Dados_Controle\", aproveitamos; senão default)\n// =======================\nconst controleData = (() => {\n  try { return $(\"Extrair_Dados_Controle\").first().json || {}; }\n  catch { return {}; }\n})();\n\nconst tentativaAtualGlobal = Number(controleData.tentativa_atual) || 1; // 1..5\nconst ultimoContatoId = controleData.ultimo_contato_id || null;\n\n// Nomes dos campos para a tentativa atual\nconst statusFieldName = `T${tentativaAtualGlobal}_Status`;\nconst dataFieldName   = `T${tentativaAtualGlobal}_Data`;\nconst callIdFieldName = `T${tentativaAtualGlobal}_CallID`;\n\n// =======================\n// 3) HELPERS COMPARTILHADOS\n// =======================\n\nfunction indexByName(customFields = []) {\n  return customFields.reduce((acc, f) => {\n    acc[f.name] = f;\n    return acc;\n  }, {});\n}\n\nfunction getDropdownLabel(field) {\n  if (!field) return null;\n  const optId = field.value;\n  if (!optId) return null;\n  const options = field.type_config?.options || [];\n  const opt = options.find(o => o.id === optId);\n  return opt ? opt.name : null;\n}\n\nfunction getRawValue(byName, name) {\n  const f = byName[name];\n  return f ? (f.value ?? null) : null;\n}\n\nfunction getValue(byName, name) {\n  const f = byName[name];\n  if (!f) return null;\n  if (f.type === 'drop_down') return getDropdownLabel(f);\n  return f.value ?? null;\n}\n\nfunction parseMaybeDate(v) {\n  if (v === null || v === undefined) return null;\n  if (typeof v === 'number') return new Date(v);\n  if (typeof v === 'string') {\n    if (/^\\d{10,13}$/.test(v)) {\n      const ms = v.length === 13 ? Number(v) : Number(v) * 1000;\n      return new Date(ms);\n    }\n    const d = new Date(v);\n    return isNaN(d.getTime()) ? null : d;\n  }\n  return null;\n}\n\nfunction toISODate(d) {\n  if (!d) return null;\n  return new Date(d).toISOString().split('T')[0];\n}\n\nfunction buildAttempt(byName, n) {\n  const id = getRawValue(byName, `T${n}_CallID`);\n  const dt = parseMaybeDate(getRawValue(byName, `T${n}_Data`));\n  const status = getValue(byName, `T${n}_Status`); // label do dropdown\n  return {\n    n,\n    callId: id || '',\n    date: dt,\n    dateISO: toISODate(dt),\n    status: status || ''\n  };\n}\n\nfunction pickCF(fields, name) {\n  return fields.find(f => f.name === name);\n}\n\nconst getTelefone = (fields = []) => {\n  const tel = pickCF(fields, 'Telefone')?.value;\n  if (tel) return String(tel);\n  const whats = pickCF(fields, 'Whatsapp')?.value;\n  if (whats) return String(whats).replace(/\\D+/g, '') || null;\n  return null;\n};\n\nconst getStatusOptionId = (statusField, targetName) => {\n  if (!statusField?.type_config?.options?.length) return null;\n  const tgt = String(targetName || '').toLowerCase();\n  const opt = statusField.type_config.options.find(\n    o => String(o.name || '').toLowerCase() === tgt\n  );\n  return opt?.id || null;\n};\n\n// =======================\n// 4) computeForTask -> dados de controle por task\n// =======================\nfunction computeForTask(task) {\n  const customFields = task.custom_fields || [];\n  const byName = indexByName(customFields);\n\n  const attempts = [1, 2, 3, 4, 5].map(n => buildAttempt(byName, n));\n\n  const touched = attempts.filter(a => a.callId || a.date || a.status);\n\n  const lastTouched = touched.length\n    ? touched.reduce((a, b) => {\n        if (a.date && b.date) return a.date > b.date ? a : b;\n        if (a.date && !b.date) return a;\n        if (!a.date && b.date) return b;\n        return a.n >= b.n ? a : b;\n      })\n    : null;\n\n  let tentativaAtual = lastTouched ? lastTouched.n : 1;\n\n  const anyAnswered = attempts.find(a => a.status === 'Atendeu');\n  const anyError = attempts.find(a => a.status === 'Erro');\n\n  let statusCiclo = 'em_andamento';\n  if (anyAnswered) {\n    statusCiclo = 'concluido';\n    tentativaAtual = anyAnswered.n;\n  } else if (touched.length === 5) {\n    statusCiclo = 'esgotado';\n  } else if (anyError) {\n    statusCiclo = 'erro';\n  }\n\n  let ultimoContato = '';\n  const withDate = attempts.filter(a => a.date && a.callId);\n  if (withDate.length) {\n    ultimoContato = withDate.reduce((a, b) => (a.date > b.date ? a : b)).callId || '';\n  } else if (lastTouched && lastTouched.callId) {\n    ultimoContato = lastTouched.callId || '';\n  }\n\n  let dataUltimaExecucao = null;\n  if (withDate.length) {\n    const lastDate = withDate.reduce((a, b) => (a.date > b.date ? a : b)).date;\n    dataUltimaExecucao = toISODate(lastDate);\n  }\n\n  const hoje = new Date().toISOString().split('T')[0];\n  const novoDia = dataUltimaExecucao ? dataUltimaExecucao !== hoje : true;\n\n  return {\n    control_task_id: task.id,\n    tentativa_atual: parseInt(tentativaAtual, 10),\n    ultimo_contato_id: ultimoContato || '',\n    data_ultima_execucao: dataUltimaExecucao || null,\n    status_ciclo: statusCiclo,\n    novo_dia: novoDia,\n    data_hoje: hoje\n  };\n}\n\n// Pré-calcula o controle de cada task em um map por id\nconst controlePorTaskId = {};\nfor (const t of tasks) {\n  controlePorTaskId[t.id] = computeForTask(t);\n}\n\n// =======================\n// 5) VARREDURA: escolhe até 5 contatos elegíveis\n// =======================\n\nfunction coletarContatos(tasks, ignorarCursor = false) {\n  let encontrouUltimo = ignorarCursor || !ultimoContatoId;\n  const contatos = [];\n  let semTelefone = 0;\n\n  for (const task of tasks) {\n    const fields = task.custom_fields || [];\n\n    // Usa Status_Final, se existir (senão assume \"ativo\")\n    const statusFinal = (pickCF(fields, 'Status_Final')?.value || 'ativo')\n      .toString()\n      .toLowerCase();\n    if (statusFinal !== 'ativo') continue;\n\n    // Se quiser, pode usar status_ciclo para já pular concluídos/esgotados:\n    const controle = controlePorTaskId[task.id];\n    if (controle && ['concluido', 'esgotado'].includes(controle.status_ciclo)) {\n      continue;\n    }\n\n    // Cursor\n    if (!encontrouUltimo) {\n      if (task.id === ultimoContatoId) encontrouUltimo = true;\n      continue;\n    }\n\n    // Campos da tentativa atual (global) T{n}\n    const statusField = pickCF(fields, statusFieldName);\n    const dataField   = pickCF(fields, dataFieldName);\n    const callIdField = pickCF(fields, callIdFieldName);\n\n    // Status da tentativa atual (default \"Não Iniciado\")\n    const raw = statusField?.value || 'Não Iniciado';\n    const statusTentativa = String(raw).trim();\n\n    // Só seguem \"Não Iniciado\", \"Pendente\" e \"Tentando\"\n    const elegivel = ['Não Iniciado', 'Pendente', 'Tentando'].includes(statusTentativa);\n    if (!elegivel) continue;\n\n    // IDs das opções do dropdown T{n}_Status\n    const tentandoOptionId = getStatusOptionId(statusField, 'Tentando');\n    const atendeuOptionId  = getStatusOptionId(statusField, 'Atendeu');\n    const erroOptionId     = getStatusOptionId(statusField, 'Erro');\n\n    // Telefone/WhatsApp\n    const telefone = getTelefone(fields);\n    if (!telefone) { semTelefone++; continue; }\n\n    // Dados de controle dessa task\n    const ctrl = controlePorTaskId[task.id] || null;\n\n    contatos.push({\n      json: {\n        // Dados básicos\n        task_id: task.id,\n        contact_name: task.name || null,\n        phone: telefone.replace(/\\D+/g, ''),\n\n        // Tentativa atual (global)\n        attempt_number: tentativaAtualGlobal,\n        attempt_key: `T${tentativaAtualGlobal}`,\n        attempt_status_current_name: statusTentativa,\n\n        // IDs dos campos da tentativa T{n}\n        attempt_status_field_id: statusField?.id || null,\n        attempt_data_field_id:   dataField?.id   || null,\n        attempt_callid_field_id: callIdField?.id || null,\n\n        // IDs das opções de status\n        attempt_status_option_id_tentando: tentandoOptionId || null,\n        attempt_status_option_id_atendeu:  atendeuOptionId  || null,\n        attempt_status_option_id_erro:     erroOptionId     || null,\n\n        // Sugestão de data em ms\n        attempt_data_timestamp_ms: Date.now(),\n\n        // CONTROLE DA TASK (funcão 2)\n        controle_task: ctrl\n      }\n    });\n\n    if (contatos.length >= 5) break;\n  }\n\n  return { contatos, semTelefone };\n}\n\n// Primeira passada: respeitando cursor\nlet { contatos: contatosValidos, semTelefone } = coletarContatos(tasks, false);\n\n// Fallback opcional: se não achou nada e tinha cursor, ignora cursor\nif (!contatosValidos.length && ultimoContatoId) {\n  const fallback = coletarContatos(tasks, true);\n  contatosValidos = fallback.contatos;\n  semTelefone = fallback.semTelefone;\n}\n\n// =======================\n// 6) SAÍDA\n// =======================\nif (!contatosValidos.length) {\n  return [{\n    json: {\n      info: \"Nenhum contato elegível para esta execução.\",\n      tentativa_atual_global: tentativaAtualGlobal,\n      cursor_usado: ultimoContatoId || null,\n      total_tasks_recebidas: tasks.length,\n      sem_telefone: semTelefone,\n      dica: 'Cheque Status_Final, tentativa_atual_global, cursor e se existe Telefone/Whatsapp.'\n    }\n  }];\n}\n\nreturn contatosValidos;\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[880,464],"id":"b759390f-f1e1-4e50-a7e3-2ac6fc953c78","name":"ciclo"},{"parameters":{"jsCode":"const results = [];\n\n// Formata telefone com ou sem o nono dígito (Brasil)\nfunction formatTelefone(value) {\n  if (value == null || value === \"\") return { tel12: value ?? null, tel13: value ?? null };\n\n  let digits = String(value).replace(/\\D/g, \"\");\n  if (!digits.startsWith(\"55\")) {\n    if (digits.length >= 10 && digits <= 13) digits = \"55\" + digits;\n    else return { tel12: digits, tel13: digits };\n  }\n\n  const country = \"55\";\n  const area = digits.slice(2, 4);\n  const local = digits.slice(4);\n\n  const tel13 = country + area + local;\n\n  let local12 = local;\n  if (local12.length === 9 && local12.startsWith(\"9\")) local12 = local12.slice(1);\n  if (local12.length > 8) local12 = local12.slice(-8);\n  const tel12 = country + area + local12;\n\n  return { tel12, tel13 };\n}\n\n// Converte epoch (ms ou string numérica) para YYYY-MM-DD\nfunction toISODate(value) {\n  if (value == null || value === \"\") return null;\n  const n = Number(value);\n  if (Number.isNaN(n)) return null;\n  const d = new Date(n);\n  return isNaN(d.getTime()) ? null : d.toISOString().slice(0, 10);\n}\n\n// Resolve valor de dropdown para o NOME da opção\nfunction resolveDropdown(value, options = []) {\n  if (value == null || value === \"\") return null;\n\n  if (typeof value === \"number\") {\n    const byIdx = options.find(o => o.orderindex === value);\n    return byIdx ? byIdx.name : String(value);\n  }\n  if (typeof value === \"string\") {\n    const byId = options.find(o => o.id === value);\n    if (byId) return byId.name;\n    const byName = options.find(o => o.name === value);\n    if (byName) return byName.name;\n    return value;\n  }\n  return String(value);\n}\n\n// Display de qualquer custom field (inclusive quando vazio)\nfunction getFieldDisplay(field) {\n  const { type, value, type_config } = field;\n\n  if (type === \"drop_down\") {\n    const opts = type_config?.options || [];\n    return resolveDropdown(value, opts);\n  }\n  if (type === \"date\") {\n    return toISODate(value);\n  }\n  // short_text, email, url, phone etc.\n  return value ?? null;\n}\n\n// Localiza o campo Follow-Up (se existir)\nfunction getFollowUpField(customFields) {\n  return customFields.find(f => f.name === \"Follow-Up\" && f.type === \"drop_down\");\n}\n\n// Calcula próximo Follow-Up com base nas opções reais do campo\nfunction computeNextFollowUp(customFields, followDisplay) {\n  const followField = getFollowUpField(customFields);\n  if (!followField) return null;\n  const opts = followField.type_config?.options || [];\n  const idx = opts.findIndex(o => o.name === followDisplay);\n  if (idx === -1) return null;\n  if (idx < opts.length - 1) return opts[idx + 1].name;\n  return followDisplay; // já está no último\n}\n\n// Suporta entrada tanto como `items` do n8n quanto array direto\nconst sourceItems = Array.isArray(items) ? items : (Array.isArray($input?.all()) ? $input.all() : []);\n\nfor (const it of sourceItems) {\n  const data = it.json || it;\n\n  const customFields = data.custom_fields || [];\n  const formattedObj = {};\n\n  // 1) Garanta TODOS os custom fields na saída, mesmo sem valor\n  for (const field of customFields) {\n    const display = getFieldDisplay(field);\n    // sempre inclui a chave do campo com o display (ou null)\n    formattedObj[field.name] = display ?? null;\n  }\n\n  // 2) Telefone derivado sempre presente (a partir do display do campo Telefone)\n  const telBase = formattedObj[\"Telefone\"];\n  const { tel12, tel13 } = formatTelefone(telBase);\n  formattedObj[\"Telefone_12\"] = tel12 ?? null;\n  formattedObj[\"Telefone_13\"] = tel13 ?? null;\n\n  // 3) Próximo Follow-Up baseado nas opções reais do campo\n  const followDisplay = formattedObj[\"Follow-Up\"]; // já resolvido para nome\n  const nextFollowUp = computeNextFollowUp(customFields, followDisplay);\n\n  // 4) Monte a saída. Se quiser mais campos top-level, adicione aqui sem drama.\n  results.push({\n    json: {\n      id: data.id,\n      name: data.name,\n      url: data.url ?? null,\n      status: data.status?.status ?? null,\n      date_created: toISODate(data.date_created),\n      date_updated: toISODate(data.date_updated),\n      start_date: toISODate(data.start_date),\n      ...formattedObj,\n      FollowUpNext: nextFollowUp ?? null\n    }\n  });\n}\n\nreturn results;\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1840,464],"id":"28913586-aa76-40f1-af6a-4017ce228cac","name":"formata dados"},{"parameters":{"operation":"setCustomField","task":"={{ $('dados para vapi').item.json.clickup.task_id }}","field":"={{ $('dados para vapi').item.json.clickup.id.status_id }}","value":"={{ $('dados para vapi').item.json.clickup.id.option_id_atendeu }}"},"type":"n8n-nodes-base.clickUp","typeVersion":1,"position":[4128,592],"id":"6e12c0a5-c424-44eb-a893-9bc22930f88d","name":"status","credentials":{"clickUpApi":{"id":"74vuorPFMovlnboz","name":"Bolsa"}}},{"parameters":{"url":"=https://api.vapi.ai/call/{{ $('Solicitar ligacao 3').item.json.id }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"Bearer fa43979b-cfcf-4791-8