anal|Unidade|Interesse)/i.test(chave)) {\n    return capitalizaFrase(v);\n  }\n\n  return v;\n}\n\nfunction montaDadosFormatados(campos) {\n  const ordem = [\n    \"Cidade/UF\",\n    \"Experiência em Educação\",\n    \"Papel Desejado\",\n    \"Dedicação\",\n    \"Área de Interesse\",\n    \"Canal\",\n    \"Observações\",\n  ];\n\n  const linhas = [];\n  for (const chave of ordem) {\n    if (campos[chave] != null && String(campos[chave]).trim() !== '') {\n      linhas.push(`- ${chave}: ${normalizaValor(chave, campos[chave])}`);\n    }\n  }\n\n  // Inclui demais campos que não estavam na ordem prevista\n  for (const [k, v] of Object.entries(campos)) {\n    if (!ordem.includes(k) && v != null && String(v).trim() !== '') {\n      linhas.push(`- ${k}: ${String(v).trim()}`);\n    }\n  }\n\n  return linhas.length ? linhas.join('\\n') : '- (sem detalhes informados)';\n}\n\nfunction fillTemplate(tpl, vars) {\n  return tpl.replace(/\\{(\\w+)\\}/g, (_, key) => {\n    const v = vars[key];\n    return v !== undefined && v !== null ? String(v) : '';\n  });\n}\n\nreturn items.map(item => {\n  const j = item.json || {};\n\n  const telefone = j.phone_number || j.telefone || '';\n  const link = j.link || '';\n  const dadosRaw = j.dados || '';\n\n  // Extrai campos do \"resumo\"\n  const extraidos = parseResumo(dadosRaw);\n\n  // Nome: explícito > dentro do resumo > fallback\n  const nomeDoResumo = extraidos['Nome'] || extraidos['Nome do Contato'] || extraidos['Contato'];\n  const nome = (j.nome || j.name || nomeDoResumo || 'Interessado(a)').toString().trim();\n\n  // Monta bloco organizadinho\n  const dados_formatados = montaDadosFormatados(extraidos);\n\n  // 20 VARIAÇÕES FOFINHAS (Estilo A: bloco organizado)\n  const templates = [\n\"Giuzinha, chegou uma pessoa no grupo temporário para sua avaliação. 💛\\n\\nContato\\n- Nome: {nome}\\n- Telefone: {telefone}\\n\\nDados\\n{dados_formatados}\\n\\nChat: {link}\\n\\nVocê é incrível; segue com carinho e atenção.\",\n\"Giuzinha, temos nova