.length > 0\n  ? (sourceItems[0].json ?? {})\n  : (items?.[0]?.json ?? {});\n\nconst input = Array.isArray(root) && root.length > 0 ? root[0] : root;\n\n// ===== Helpers =====\nfunction xorshift32(seed) {\n  let x = seed | 0;\n  x ^= x << 13;\n  x ^= x >>> 17;\n  x ^= x << 5;\n  return (x >>> 0);\n}\nfunction randIndex(n) {\n  let base = 0;\n  try {\n    if (typeof process !== 'undefined' && process.hrtime && process.hrtime.bigint) {\n      const ns = process.hrtime.bigint();\n      base = Number(ns & 0xffffffffn);\n    } else {\n      base = Date.now() >>> 0;\n    }\n  } catch (e) {\n    base = Date.now() >>> 0;\n  }\n  base ^= (Math.floor(Math.random() * 0xffffffff)) >>> 0;\n  let r = xorshift32(base);\n  r = xorshift32(r);\n  r = xorshift32(r);\n  return Math.floor((r / 0x100000000) * n);\n}\nfunction safeStr(v) {\n  return (v == null ? '' : String(v)).trim();\n}\nfunction firstNameClean(s) {\n  const noDigits = safeStr(s).replace(/\\d+/g, ' ').replace(/\\s+/g, ' ').trim();\n  return noDigits.split(' ')[0] || '';\n}\nfunction pickFirst(obj, keys) {\n  for (const k of keys) {\n    if (!k) continue;\n    if (k.includes('.')) {\n      const parts = k.split('.');\n      let cur = obj;\n      for (const p of parts) {\n        if (!cur || typeof cur !== 'object') { cur = null; break; }\n        cur = cur[p];\n      }\n      const v = safeStr(cur);\n      if (v) return v;\n    } else if (Object.prototype.hasOwnProperty.call(obj, k)) {\n      const v = safeStr(obj[k]);\n      if (v) return v;\n    }\n  }\n  return '';\n}\n\n// ===== Normalização de campos =====\nconst nomeRaw =\n  pickFirst(input, [\n    'full_name','nome','first_name','Name','name','contact.nome','contact.name'\n  ]) || '';\nconst nome = firstNameClean(nomeRaw) || 'Aluno';\n\nconst curso =\n  pickFirst(input, [\n    'qual_seria_o_curso_de_seu_interesse_?',\n    'curso_interesse','curso de interesse','Curso de interesse','curso','Curso'\n  ]) || 'seu curso';\n\nconst cidade =\n  pickFirst(input, [\n    '