,"typeValidation":"strict","version":3},"conditions":[{"id":"ee5f9a26-284f-4df5-ae5a-dec6bb87eee1","leftValue":"={{ $json.ends_next_48h }}","rightValue":true,"operator":{"type":"boolean","operation":"equals"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.3,"position":[608,-1136],"id":"4f59f878-ada8-48ba-829c-5cd7e8fe8216","name":"ending_next_48h ?"},{"parameters":{"aggregate":"aggregateAllItemData","destinationFieldName":"ended_14d_ago","options":{}},"type":"n8n-nodes-base.aggregate","typeVersion":1,"position":[848,-736],"id":"04e2a545-b413-48aa-abf4-67b663449728","name":"Report 6 - Ended 14d"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"ee5f9a26-284f-4df5-ae5a-dec6bb87eee1","leftValue":"={{ $json.is_active }}","rightValue":false,"operator":{"type":"boolean","operation":"equals"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.3,"position":[16,-1552],"id":"9771cea6-b594-41b2-a688-69719903eaea","name":"Active?"},{"parameters":{"graphApiVersion":"=v24.0","node":"={{ $('Edit Fields').item.json.ad_account_id }}","edge":"insights","options":{"queryParameters":{"parameter":[{"name":"date_preset","value":"yesterday"},{"name":"fields","value":"campaign_id,campaign_name,spend,impressions,clicks,reach,ctr,cpm,actions,cost_per_action_type,date_start,date_stop"},{"name":"level","value":"campaign"},{"name":"limit","value":"500"}]}}},"type":"n8n-nodes-base.facebookGraphApi","typeVersion":1,"position":[336,-1696],"id":"66970c8b-3e3f-4ce6-906c-29b62e650c07","name":"Insights Yesterday - Campaign Level","executeOnce":true,"credentials":{"facebookGraphApi":{"id":"eqR86ZmQxj7Mxsds","name":"Facebook Graph account"}}},{"parameters":{"jsCode":"/**\n * n8n Code node (JavaScript)\n * Entrada esperada:\n * - items[0].json.data = array de campanhas (como no exemplo)\n * - items[0].json.paging = opcional\n *\n * Saída:\n * - Um item por campanha, com tags/booleans adicionados.\n */\n\n// ---------- helpers ----------\nfunction parseOffsetMinutes(dateStr) {\n  // Espera algo tipo \"2026-01-24T12:11:00-0800\" ou \"...+0530\"\n  if (!dateStr) return null;\n  const m = String(dateStr).match(/([+-])(\\d{2})(\\d{2})$/);\n  if (!m) return null;\n  const sign = m[1] === '-' ? -1 : 1;\n  const hours = Number(m[2]);\n  const mins = Number(m[3]);\n  return sign * (hours * 60 + mins);\n}\n\nfunction dateInOffset(ms, offsetMin) {\n  // Converte \"agora\" para a data YYYY-MM-DD no fuso/offset do ad account (aprox.)\n  // Fazendo shift do timestamp antes de formatar como ISO (UTC).\n  const shifted = ms + (offsetMin || 0) * 60 * 1000;\n  return new Date(shifted).toISOString().slice(0, 10);\n}\n\nfunction safeParseMs(dateStr) {\n  if (!dateStr) return null;\n  const ms = Date.parse(dateStr);\n  return Number.isFinite(ms) ? ms : null;\n}\n\n// ---------- unwrap campaigns ----------\nconst root = items[0]?.json ?? {};\nconst paging = root.paging ?? null;\n\n// Alguns nodes já devolvem campanha por item; outros devolvem wrapper com data[]\nlet campaigns = [];\nif (Array.isArray(root.data)) {\n  campaigns = root.data;\n} else {\n  // fallback: se já vier 1 campanha por item\n  campaigns = items.map(i => i.json).filter(j => j && j.id);\n}\n\n// ---------- determine \"account offset\" ----------\nconst sampleTime =\n  campaigns.find(c => c.stop_time)?.stop_time ||\n  campaigns.find(c => c.start_time)?.start_time ||\n  null;\n\nconst accountOffsetMin = parseOffsetMinutes(sampleTime) ?? 0;\n\n// Datas de referência (se você tiver vindo de um Set anterior e preservou campos, usamos)\nconst nowMs = Date.now();\nconst next48Ms = root.next_48h_iso ? Date.parse(root.next_48h_iso) : (nowMs + 48 * 60 * 60 * 1000);\n\nconst todayStr = root.today || dateInOffset(nowMs, accountOffsetMin);\nconst minus14Start = root.minus_14d_start || dateInOffset(nowMs - 14 * 24 * 60 * 60 * 1000, accountOffsetMin);\n// janela de 24h só pra referência; para o \"14 dias atrás\" o mais seguro é igualdade por data\nconst minus14End = root.minus_14d_end || dateInOffset(nowMs - 13 * 24 * 60 * 60 * 1000, accountOffsetMin);\n\n// ---------- tag campaigns ----------\nconst out = campaigns.map((c) => {\n  const effective = c.effective_status || c.status || null;\n\n  const stopMs = safeParseMs(c.stop_time);\n  const stopDate = c.stop_time ? String(c.stop_time).slice(0, 10) : null;\n\n  const isActive = effective === 'ACTIVE';\n  const hasStop = stopMs !== null;\n\n  const endsNext48h = hasStop ? (stopMs >= nowMs && stopMs <= next48Ms) : false;\n\n  // \"Concluída há 14 dias\": melhor tratar como \"stop_date == (hoje-14)\" (no offset do ad account)\n  const ended14dAgo = !!stopDate && stopDate === minus14Start;\n\n  const tags = [];\n  if (isActive) tags.push('active');\n  if (endsNext48h) tags.push('ending_next_48h');\n  if (ended14dAgo) tags.push('ended_14d_ago');\n\n  return {\n    json: {\n      ...c,\n\n      // tags/booleans principais\n      is_active: isActive,\n      ends_next_48h: endsNext48h,\n      ended_14d_ago: ended14dAgo,\n      tags,\n\n      // campos auxiliares (úteis pra debug / filtros)\n      stop_time_ms: stopMs,\n      stop_date: stopDate,\n      _account_offset_minutes: accountOffsetMin,\n      _today: todayStr,\n      _minus_14d_start: minus14Start,\n      _minus_14d_end: minus14End,\n\n      // paging duplicado (se você precisar paginar depois)\n      _paging: paging,\n    }\n  };\n});\n\nreturn out;\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-208,-1152],"id":"de9cca65-e191-45c1-b834-404abcb0e40b","name":"Tag Campaigns"},{"parameters":{},"type":"n8n-nodes-base.merge","typeVersion":3.2,"position":[336,-1552],"id":"13e8409c-f89f-4906-812b-e1084832afce","name":"Merge"},{"parameters":{"jsCode":"/**\n * n8n Code node (Run Once for All Items)\n * Entrada: output do Merge (Append)\n * - 1 item com json.Insights_Yesterday = [{data:[...]}...]\n * - vários itens com json.id (campanhas), tags etc.\n *\n * Saída:\n * - 1 item por campanha (meta), com:\n *   - insights_yesterday (obj ou null)\n *   - métricas numéricas normalizadas\n *   - has_delivery_yesterday (impressions > 0)\n */\n\nfunction toInt(v) {\n  if (v === null || v === undefined || v === '') return 0;\n  const n = Number(String(v).replace(',', '.'));\n  return Number.isFinite(n) ? Math.trunc(n) : 0;\n}\n\nfunction toFloat(v) {\n  if (v === null || v === undefined || v === '') return 0;\n  const n = Number(String(v).replace(',', '.'));\n  return Number.isFinite(n) ? n : 0;\n}\n\nfunction flattenInsightsFromItem(itemJson) {\n  const rows = [];\n\n  // Caso padrão do seu Merge Append:\n  // { Insights_Yesterday: [ {data:[...]}, {data:[...]} ... ] }\n  if (Array.isArray(itemJson?.Insights_Yesterday)) {\n    for (const page of itemJson.Insights_Yesterday) {\n      // às vezes vem {data:[...]}\n      if (Array.isArray(page?.data)) {\n        for (const r of page.data) rows.push(r);\n      } else if (Array.isArray(page)) {\n        // fallback: se a página for array direto\n        for (const r of page) rows.push(r);\n      }\n    }\n  }\n\n  // fallback: se algum item vier como {data:[...]} direto\n  if (Array.isArray(itemJson?.data)) {\n    for (const r of itemJson.data) rows.push(r);\n  }\n\n  return rows;\n}\n\n// 1) Separar campanhas meta e coletar insights crus\nconst campaigns = [];\nconst rawInsights = [];\n\nfor (const it of items) {\n  const j = it.json ?? {};\n\n  // campanha meta: tem id (e não é o wrapper gigante de insights)\n  if (j.id && !j.Insights_Yesterday) {\n    campaigns.push(j);\n    continue;\n  }\n\n  // wrapper de insights (ou qualquer coisa que contenha insights)\n  const rows = flattenInsightsFromItem(j);\n  if (rows.length) rawInsights.push(...rows);\n}\n\n// 2) Deduplicar insights por campaign_id (se repetido, pega o “mais forte”)\nconst insightsMap = new Map();\n\nfor (const r of rawInsights) {\n  const cid = r?.campaign_id ? String(r.campaign_id) : null;\n  if (!cid) continue;\n\n  // normalizar números\n  const normalized = {\n    ...r,\n    campaign_id: cid,\n    spend_num: toFloat(r.spend),\n    impressions_num: toInt(r.impressions),\n    clicks_num: toInt(r.clicks),\n    reach_num: toInt(r.reach),\n    ctr_num: toFloat(r.ctr),\n    cpm_num: toFloat(r.cpm),\n  };\n\n  const prev = insightsMap.get(cid);\n\n  if (!prev) {\n    insightsMap.set(cid, normalized);\n    continue;\n  }\n\n  // Se duplicado, escolhe o que tem maior spend/impressions (normalmente são idênticos)\n  const scorePrev = (prev.spend_num * 1000000) + prev.impressions_num;\n  const scoreNew = (normalized.spend_num * 1000000) + normalized.impressions_num;\n\n  if (scoreNew > scorePrev) {\n    insightsMap.set(cid, normalized);\n  }\n}\n\n// 3) Montar saída: 1 item por campanha meta, anexando insights\nconst out = campaigns.map((c) => {\n  const id = String(c.id);\n  const ins = insightsMap.get(id) || null;\n\n  const impressions = ins ? ins.impressions_num : 0;\n\n  return {\n    json: {\n      ...c,\n\n      // insights anexado (ontem)\n      insights_yesterday: ins,\n\n      // atalho útil para filtros\n      has_delivery_yesterday: impressions > 0,\n\n      // se quiser também “promover” algumas métricas no topo (facilita planilha)\n      yesterday: ins ? {\n        spend: ins.spend_num,\n        impressions: ins.impressions_num,\n        clicks: ins.clicks_num,\n        reach: ins.reach_num,\n        ctr: ins.ctr_num,\n        cpm: ins.cpm_num,\n        actions: ins.actions || [],\n        cost_per_action_type: ins.cost_per_action_type || [],\n        date_start: ins.date_start,\n        date_stop: ins.date_stop,\n      } : {\n        spend: 0,\n        impressions: 0,\n        clicks: 0,\n        reach: 0,\n        ctr: 0,\n        cpm: 0,\n        actions: [],\n        cost_per_action_type: [],\n        date_start: null,\n        date_stop: null,\n      },\n    }\n  };\n});\n\n// 4) (Opcional) Se existir insight sem campanha meta, adiciona no final (raro, mas evita sumir dado)\nfor (const [cid, ins] of insightsMap.entries()) {\n  const exists = campaigns.some(c => String(c.id) === cid);\n  if (!exists) {\n    out.push({\n      json: {\n        id: cid,\n        name: ins.campaign_name || null,\n        insights_yesterday: ins,\n        has_delivery_yesterday: (ins.impressions_num > 0),\n        yesterday: {\n          spend: ins.spend_num,\n          impressions: ins.impressions_num,\n          clicks: ins.clicks_num,\n          reach: ins.reach_num,\n          ctr: ins.ctr_num,\n          cpm: ins.cpm_num,\n          actions: ins.actions || [],\n          cost_per_action_type: ins.cost_per_action_type || [],\n          date_start: ins.date_start,\n          date_stop: ins.date_stop,\n        },\n        _note: \"Insight sem metadados de campanha (não veio na lista de campaigns).\"\n      }\n    });\n  }\n}\n\nreturn out;\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[560,-1552],"id":"327a011b-d6ff-4048-ade4-ad11c03e326a","name":"Code in JavaScript2"},{"parameters":{"aggregate":"aggregateAllItemData","destinationFieldName":"yesterday_active_delivery","options":{}},"type":"n8n-nodes-base.aggregate","typeVersion":1,"position":[1232,-1568],"id":"77d20398-da78-4a6d-8759-af35aedce2af","name":"Report 1 - Yesterday Active+Delivery"},{"parameters":{"jsCode":"/**\n * n8n Code node (Run Once for All Items)\n * Calcula:\n * - results_yesterday\n * - cpr_yesterday\n * - result_action_type_yesterday (debug útil)\n */\n\nfunction toFloat(v) {\n  if (v === null || v === undefined || v === '') return 0;\n  const n = Number(String(v).replace(',', '.'));\n  return Number.isFinite(n) ? n : 0;\n}\n\nfunction toInt(v) {\n  // Meta quase sempre manda strings numéricas\n  const n = toFloat(v);\n  return Number.isFinite(n) ? Math.trunc(n) : 0;\n}\n\nfunction buildValueMap(arr) {\n  // arr = [{action_type, value}, ...]\n  const m = new Map();\n  if (!Array.isArray(arr)) return m;\n  for (const it of arr) {\n    if (!it || !it.action_type) continue;\n    m.set(String(it.action_type), toFloat(it.value));\n  }\n  return m;\n}\n\nfunction pickActionType(objective, actionsMap) {\n  const prefs = {\n    // Leads: tenta lead \"padrão\" primeiro, depois agrupados e variações comuns\n    OUTCOME_LEADS: [\n      'lead',\n      'onsite_conversion.lead_grouped',\n      'offsite_conversion.fb_pixel_lead',\n      'offsite_complete_registration_add_meta_leads',\n      'offsite_submit_application_add_meta_leads',\n      'onsite_web_lead',\n      'offsite_content_view_add_meta_leads',\n    ],\n\n    // Mensagens (WhatsApp/Messenger): conversa iniciada é o “resultado”\n    OUTCOME_MESSAGES: [\n      'onsite_conversion.messaging_conversation_started_7d',\n      'onsite_conversion.total_messaging_connection',\n      'onsite_conversion.messaging_first_reply',\n    ],\n\n    // Cliques (campanhas antigas/objetivo de link)\n    LINK_CLICKS: [\n      'link_click',\n      'inline_link_click',\n      'outbound_click',\n    ],\n\n    // Tráfego (quando vier nesse formato)\n    OUTCOME_TRAFFIC: [\n      'link_click',\n      'landing_page_view',\n      'omni_landing_page_view',\n    ],\n\n    // Vendas (se aparecerem na sua conta)\n    OUTCOME_SALES: [\n      'purchase',\n      'offsite_conversion.fb_pixel_purchase',\n      'offsite_conversion.purchase',\n      'omni_purchase',\n    ],\n\n    // Awareness (geralmente não tem “resultado” como ação; deixo reach como fallback)\n    OUTCOME_AWARENESS: [\n      // sem action_type obrigatório aqui\n    ],\n  };\n\n  const list = prefs[objective] || [];\n\n  // 1) tenta lista preferida\n  for (const t of list) {\n    if (actionsMap.has(t)) return t;\n  }\n\n  // 2) fallback por padrão: se for leads e não achou, procura qualquer action_type com \"lead\"\n  if (objective === 'OUTCOME_LEADS') {\n    for (const [k] of actionsMap.entries()) {\n      if (k.toLowerCase().includes('lead')) return k;\n    }\n  }\n\n  // 3) fallback por padrão: mensagens\n  if (objective === 'OUTCOME_MESSAGES') {\n    for (const [k] of actionsMap.entries()) {\n      if (k.toLowerCase().includes('messaging_conversation_started')) return k;\n    }\n  }\n\n  // 4) fallback genérico sensato (ordem de prioridade)\n  const genericPriority = [\n    'lead',\n    'onsite_conversion.messaging_conversation_started_7d',\n    'link_click',\n    'landing_page_view',\n    'omni_landing_page_view',\n  ];\n  for (const t of genericPriority) {\n    if (actionsMap.has(t)) return t;\n  }\n\n  // 5) último fallback: pega a maior ação que NÃO seja só “engajamento” inútil\n  const avoid = new Set([\n    'page_engagement',\n    'post_engagement',\n    'post_interaction_gross',\n    'post_reaction',\n    'video_view',\n  ]);\n\n  let bestType = null;\n  let bestVal = -1;\n\n  for (const [k, v] of actionsMap.entries()) {\n    if (avoid.has(k)) continue;\n    if (v > bestVal) {\n      bestVal = v;\n      bestType = k;\n    }\n  }\n\n  return bestType; // pode ser null\n}\n\nreturn items.map((item) => {\n  const j = item.json || {};\n\n  const objective = j.objective || null;\n\n  // Fonte principal: j.yesterday\n  const y = j.yesterday || {};\n  const actionsArr = y.actions || j.insights_yesterday?.actions || [];\n  const costArr = y.cost_per_action_type || j.insights_yesterday?.cost_per_action_type || [];\n\n  const actionsMap = buildValueMap(actionsArr);\n  const costMap = buildValueMap(costArr);\n\n  const actionType = pickActionType(objective, actionsMap);\n\n  const results = actionType ? (actionsMap.get(actionType) || 0) : 0;\n\n  // Spend\n  const spend =\n    (typeof y.spend === 'number' ? y.spend : null) ??\n    j.insights_yesterday?.spend_num ??\n    toFloat(j.insights_yesterday?.spend) ??\n    0;\n\n  // CPR: usa cost_per_action_type se existir; senão calcula spend / results\n  let cpr = null;\n  if (results > 0) {\n    if (actionType && costMap.has(actionType)) {\n      cpr = costMap.get(actionType);\n    } else {\n      cpr = spend / results;\n    }\n  }\n\n  item.json.results_yesterday = results;\n  item.json.cpr_yesterday = cpr; // null se results == 0\n  item.json.result_action_type_yesterday = actionType;\n\n  return item;\n});\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1040,-1568],"id":"12ba17b3-e7da-41e1-ace7-38381db8ea53","name":"action_type -> value"},{"parameters":{"graphApiVersion":"v23.0","node":"={{ $json.ad_account_id }}","edge":"insights","options":{"queryParameters":{"parameter":[{"name":"date_preset","value":"last_7d"},{"name":"fields","value":"spend,date_start,date_stop"},{"name":"effective_status"}]}}},"type":"n8n-nodes-base.facebookGraphApi","typeVersion":1,"position":[-656,-832],"id":"1d53f5ff-bccc-4a60-8223-28330d58f43b","name":"Spend Last 7d Total","credentials":{"facebookGraphApi":{"id":"eqR86ZmQxj7Mxsds","name":"Facebook Graph account"}}},{"parameters":{"graphApiVersion":"v23.0","node":"={{ $('Edit Fields').item.json.ad_account_id }}","edge":"insights","options":{"queryParameters":{"parameter":[{"name":"fields","value":"campaign_id,campaign_name,impressions,spend"},{"name":"level","value":"campaign"},{"name":"date_preset","value":"yesterday"},{"name":"filtering","value":"[{\"field\":\"impressions\",\"operator\":\"GREATER_THAN\",\"value\":0}]"},{"name":"limit","value":"500"}]}}},"type":"n8n-nodes-base.facebookGraphApi","typeVersion":1,"position":[32,-1312],"id":"4e8f0fd4-803d-4719-a044-2210938e4c9d","name":"Insights Lifetime - Campaign Level","executeOnce":true,"credentials":{"facebookGraphApi":{"id":"eqR86ZmQxj7Mxsds","name":"Facebook Graph account"}}},{"parameters":{"mode":"combine","advanced":true,"mergeByFields":{"values":[{"field1":"id","field2":"campaign_id"}]},"options":{}},"type":"n8n-nodes-base.merge","typeVersion":3.2,"position":[816,-1328],"id":"db93748c-769e-4ca0-993f-80c6812851c1","name":"Merge1"},{"parameters":{"fieldToSplitOut":"data","options":{}},"type":"n8n-nodes-base.splitOut","typeVersion":1,"position":[208,-1312],"id":"800e2cde-e5cd-442b-bc6b-fc36554a8213","name":"Split Out"},{"parameters":{"graphApiVersion":"v23.0","node":"={{ $json.campaign_id }}","edge":"insights","options":{"queryParameters":{"parameter":[{"name":"fields","value":"campaign_id,campaign_name,spend,impressions,clicks,reach,ctr,cpm,actions,cost_per_action_type"},{"name":"date_preset","value":"maximum"}]}}},"type":"n8n-nodes-base.facebookGraphApi","typeVersion":1,"position":[384,-1312],"id":"27823bbc-ba99-4768-bf4d-d80c8227ec26","name":"Facebook Graph API1","credentials":{"facebookGraphApi":{"id":"eqR86ZmQxj7Mxsds","name":"Facebook Graph account"}}},{"parameters":{"fieldToSplitOut":"data","options":{}},"type":"n8n-nodes-base.splitOut","typeVersion":1,"position":[592,-1312],"id":"725f5f1e-e555-4d02-a974-e32e6575cf89","name":"Split Out1"},{"parameters":{"aggregate":"aggregateAllItemData","destinationFieldName":"Report 2 - Lifetime Active+Delivery","options":{}},"type":"n8n-nodes-base.aggregate","typeVersion":1,"position":[1024,-1328],"id":"34ce0459-3186-49ec-b35f-e0851c9b1967","name":"Report 2 - Lifetime Active+Delivery"},{"parameters":{"assignments":{"assignments":[{"id":"dc89d235-f125-4d37-8c94-58f60b6b8a9e","name":"insights_yesterday.date_start","value":"={{ $json.insights_yesterday.date_start }}","type":"string"},{"id":"f6d20e13-d18a-44b6-9285-d6b1f978a2a9","name":"insights_yesterday.date_stop","value":"={{ $json.insights_yesterday.date_stop }}","type":"string"},{"id":"4d105596-6b29-4d28-890f-ecabc0411ebd","name":"insights_yesterday.spend","value":"={{ $json.insights_yesterday.spend }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[1120,-928],"id":"aae63b3b-4507-422a-870a-07804ebdf1be","name":"Report 4 - Extract Spend Yesterday"},{"parameters":{"assignments":{"assignments":[{"id":"594df13d-006e-414f-8587-3d3bdca204b5","name":"data[0].spend","value":"={{ $json.data[0].spend }}","type":"string"},{"id":"16a83c3e-4334-4c10-87b5-80c05deac500","name":"data[0].date_start","value":"={{ $json.data[0].date_start }}","type":"string"},{"id":"8d7449a2-ccf2-44b8-bc7f-e1bc9f363c86","name":"data[0].date_stop","value":"={{ $json.data[0].date_stop }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-448,-832],"id":"dca5fbee-db8a-402e-b025-ca9560a374bf","name":"Report 5 - Extract Spend Last 7d"},{"parameters":{"numberInputs":6},"type":"n8n-nodes-base.merge","typeVersion":3.2,"position":[1600,-928],"id":"aa67f51e-ca9c-49a2-a6ca-a59cd816a40f","name":"Merge2"},{"parameters":{"jsCode":"/**\n * n8n Code node (Run Once for All Items)\n * Entrada: saída do Merge final (vários itens com formatos diferentes)\n * Saída: 1 item com { whatsapp_text: \"...\" }\n */\n\nfunction toFloat(v) {\n  if (v === null || v === undefined || v === '') return 0;\n  const n = Number(String(v).replace(',', '.'));\n  return Number.isFinite(n) ? n : 0;\n}\n\nfunction fmtMoneyBR(v) {\n  const n = toFloat(v);\n  return `R$ ${n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;\n}\n\nfunction fmtIntBR(v) {\n  const n = Number(v ?? 0);\n  return Number.isFinite(n) ? n.toLocaleString('pt-BR') : '0';\n}\n\nfunction fmtPct(v) {\n  const n = toFloat(v);\n  return `${n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}%`;\n}\n\nfunction buildValueMap(arr) {\n  const m = new Map();\n  if (!Array.isArray(arr)) return m;\n  for (const it of arr) {\n    if (!it || !it.action_type) continue;\n    m.set(String(it.action_type), toFloat(it.value));\n  }\n  return m;\n}\n\nfunction resolveResultActionType({ objective, name, actionsMap }) {\n  const nm = String(name || '').toLowerCase();\n  const hasMessaging =\n    actionsMap.has('onsite_conversion.messaging_conversation_started_7d') ||\n    actionsMap.has('onsite_conversion.total_messaging_connection') ||\n    actionsMap.has('onsite_conversion.messaging_first_reply');\n\n  // Heurística: se nome sugere WhatsApp/mensagens ou se tem métricas de mensagem\n  if (nm.includes('whatsapp') || nm.includes('whats') || nm.includes('mensag') || hasMessaging) {\n    const msgPrefs = [\n      'onsite_conversion.messaging_conversation_started_7d',\n      'onsite_conversion.total_messaging_connection',\n      'onsite_conversion.messaging_first_reply',\n    ];\n    for (const t of msgPrefs) if (actionsMap.has(t)) return t;\n  }\n\n  const prefs = {\n    OUTCOME_LEADS: [\n      'lead',\n      'onsite_conversion.lead_grouped',\n      'offsite_complete_registration_add_meta_leads',\n      'offsite_submit_application_add_meta_leads',\n      'offsite_search_add_meta_leads',\n      'offsite_conversion.fb_pixel_lead',\n      'onsite_web_lead',\n    ],\n    LINK_CLICKS: ['link_click', 'inline_link_click', 'outbound_click'],\n    OUTCOME_TRAFFIC: ['landing_page_view', 'omni_landing_page_view', 'link_click'],\n    OUTCOME_SALES: ['purchase', 'offsite_conversion.fb_pixel_purchase', 'offsite_conversion.purchase', 'omni_purchase'],\n    OUTCOME_MESSAGES: [\n      'onsite_conversion.messaging_conversation_started_7d',\n      'onsite_conversion.total_messaging_connection',\n      'onsite_conversion.messaging_first_reply',\n    ],\n  };\n\n  const list = prefs[objective] || [];\n  for (const t of list) if (actionsMap.has(t)) return t;\n\n  // Fallback: maior ação que não seja só “engajamento”\n  const avoid = new Set(['page_engagement','post_engagement','post_interaction_gross','post_reaction','video_view']);\n  let bestType = null;\n  let bestVal = -1;\n  for (const [k, v] of actionsMap.entries()) {\n    if (avoid.has(k)) continue;\n    if (v > bestVal) { bestVal = v; bestType = k; }\n  }\n  return bestType;\n}\n\nfunction computeResultsAndCpr({ objective, name, spend, actions, cost_per_action_type }) {\n  const actionsMap = buildValueMap(actions);\n  const costMap = buildValueMap(cost_per_action_type);\n  const actionType = resolveResultActionType({ objective, name, actionsMap });\n\n  const results = actionType ? (actionsMap.get(actionType) || 0) : 0;\n\n  let cpr = null;\n  if (results > 0) {\n    if (actionType && costMap.has(actionType)) cpr = costMap.get(actionType);\n    else cpr = spend / results;\n  }\n\n  return { results, cpr, actionType };\n}\n\nfunction shortId(id) {\n  const s = String(id || '');\n  return s.length > 4 ? s.slice(-4) : s;\n}\n\nfunction fmtActionType(t) {\n  if (!t) return '—';\n  // deixa mais legível pra WhatsApp\n  return t\n    .replace('onsite_conversion.', '')\n    .replace('offsite_conversion.', '')\n    .replace('fb_pixel_', '')\n    .replaceAll('_', ' ');\n}\n\n// --------------------\n// 1) Coletar blocos do Merge bagunçado\n// --------------------\nlet yesterdayActiveDelivery = [];\nlet lifetimeActiveDelivery = [];\nlet ending48h = [];\nlet ended14d = [];\nlet spendLast7dTotal = null;\nlet spendYesterdayAccountTotal = null;\n\nfor (const it of items) {\n  const j = it.json || {};\n\n  if (Array.isArray(j.yesterday_active_delivery)) yesterdayActiveDelivery = j.yesterday_active_delivery;\n  if (Array.isArray(j['Report 2 - Lifetime Active+Delivery'])) lifetimeActiveDelivery = j['Report 2 - Lifetime Active+Delivery'];\n  if (Array.isArray(j.ending_next_48h)) ending48h = j.ending_next_48h;\n\n  if (Array.isArray(j.ended_14d_ago)) {\n    ended14d = j.ended_14d_ago.filter(x => x && Object.keys(x).length > 0);\n  }\n\n  // totais: {data:[{spend,date_start,date_stop}]}\n  if (Array.isArray(j.data) && j.data[0]?.spend) {\n    const row = j.data[0];\n    const ds = row.date_start;\n    const de = row.date_stop;\n    const spend = toFloat(row.spend);\n\n    if (ds && de && ds === de) {\n      spendYesterdayAccountTotal = { spend, date_start: ds, date_stop: de };\n    } else if (ds && de && ds !== de) {\n      spendLast7dTotal = { spend, date_start: ds, date_stop: de };\n    }\n  }\n}\n\n// se ended14d veio como [{}], deixa vazio\nended14d = ended14d.filter(x => x && Object.keys(x).length > 0);\n\n// --------------------\n// 2) Mapear lifetime por id (do Report 2)\n// --------------------\nconst lifeById = new Map();\nfor (const c of lifetimeActiveDelivery) {\n  const id = String(c.id || c.campaign_id || '');\n  if (!id) continue;\n  lifeById.set(id, c);\n}\n\n// --------------------\n// 3) Datas e totais auxiliares\n// --------------------\nconst yesterdayDate =\n  yesterdayActiveDelivery?.[0]?.yesterday?.date_start ||\n  yesterdayActiveDelivery?.[0]?.insights_yesterday?.date_start ||\n  null;\n\nconst todayDate =\n  yesterdayActiveDelivery?.[0]?._today ||\n  lifetimeActiveDelivery?.[0]?._today ||\n  (new Date().toISOString().slice(0,10));\n\nconst spendYesterdayFromSubset = yesterdayActiveDelivery\n  .reduce((sum, c) => sum + toFloat(c?.yesterday?.spend), 0);\n\nconst spendYesterdayLine = spendYesterdayAccountTotal\n  ? `${fmtMoneyBR(spendYesterdayAccountTotal.spend)} (Conta) • ${spendYesterdayAccountTotal.date_start}`\n  : `${fmtMoneyBR(spendYesterdayFromSubset)} (Somente campanhas com veiculação do relatório) • ${yesterdayDate || '—'}`;\n\n// --------------------\n// 4) Montar texto WhatsApp\n// --------------------\nconst lines = [];\n\nlines.push(`📊 *Relatório Meta Ads*`);\nif (yesterdayDate) lines.push(`Data base (ontem): *${yesterdayDate}*`);\nlines.push(`Gerado em: ${new Date().toLocaleString('pt-BR')}`);\nlines.push('');\n\nlines.push(`💸 *Gastos*`);\nlines.push(`• Ontem: ${spendYesterdayLine}`);\nif (spendLast7dTotal) {\n  lines.push(`• Últimos 7 dias: ${fmtMoneyBR(spendLast7dTotal.spend)} • ${spendLast7dTotal.date_start} → ${spendLast7dTotal.date_stop}`);\n} else {\n  lines.push(`• Últimos 7 dias: (não encontrado no merge final)`);\n}\nlines.push('');\n\n// 1) Campanhas ontem ativas + exibição\nlines.push(`1) ✅ *Campanhas ativas com exibição ontem* (${yesterdayActiveDelivery.length})`);\nif (!yesterdayActiveDelivery.length) {\n  lines.push('• Nenhuma.');\n} else {\n  let idx = 1;\n  for (const c of yesterdayActiveDelivery) {\n    const y = c.yesterday || {};\n    const id = c.id;\n    const name = c.name || c.campaign_name || '(sem nome)';\n    const obj = c.objective || '—';\n\n    // já vem calculado\n    const res = c.results_yesterday ?? 0;\n    const cpr = c.cpr_yesterday;\n    const actType = c.result_action_type_yesterday;\n\n    lines.push(`\\n${idx}) *${name}* (ID ${shortId(id)})`);\n    lines.push(`• Ontem: ${fmtMoneyBR(y.spend)} | Imp ${fmtIntBR(y.impressions)} | Cliques ${fmtIntBR(y.clicks)} | Alc ${fmtIntBR(y.reach)} | CTR ${fmtPct(y.ctr)} | CPM ${fmtMoneyBR(y.cpm)}`);\n    lines.push(`• Resultado: ${fmtIntBR(res)} (${fmtActionType(actType)}) | CPR: ${cpr === null ? '—' : fmtMoneyBR(cpr)} | Obj: ${obj}`);\n    idx++;\n  }\n}\nlines.push('');\n\n// 2) Lifetime (desde o início até hoje) das campanhas ativas e com veiculação\nlines.push(`2) 📈 *Campanhas (desde o início até ${todayDate})* (ativas e com veiculação)`);\nif (!yesterdayActiveDelivery.length) {\n  lines.push('• Nenhuma (porque não houve campanha com veiculação ontem para cruzar).');\n} else {\n  let idx = 1;\n  for (const c of yesterdayActiveDelivery) {\n    const id = String(c.id || '');\n    const life = lifeById.get(id);\n\n    if (!life) {\n      lines.push(`\\n${idx}) *${c.name || '(sem nome)'}* (ID ${shortId(id)})`);\n      lines.push(`• Total: (não encontrado no Report 2 para essa campanha)`);\n      idx++;\n      continue;\n    }\n\n    const spend = toFloat(life.spend);\n    const actions = life.actions || [];\n    const cpat = life.cost_per_action_type || [];\n    const r = computeResultsAndCpr({\n      objective: life.objective || c.objective,\n      name: life.name || c.name,\n      spend,\n      actions,\n      cost_per_action_type: cpat,\n    });\n\n    lines.push(`\\n${idx}) *${life.name || c.name || '(sem nome)'}* (ID ${shortId(id)})`);\n    lines.push(`• Total: ${fmtMoneyBR(spend)} | Imp ${fmtIntBR(life.impressions)} | Cliques ${fmtIntBR(life.clicks)} | Alc ${fmtIntBR(life.reach)} | CTR ${fmtPct(life.ctr)} | CPM ${fmtMoneyBR(life.cpm)}`);\n    lines.push(`• Resultado: ${fmtIntBR(r.results)} (${fmtActionType(r.actionType)}) | CPR: ${r.cpr === null ? '—' : fmtMoneyBR(r.cpr)} | Período: ${life.date_start || '—'} → ${life.date_stop || '—'}`);\n    idx++;\n  }\n}\nlines.push('');\n\n// 3) Terminando em 48h\nlines.push(`3) ⏳ *Campanhas com término nas próximas 48h* (${ending48h.length})`);\nif (!ending48h.length) {\n  lines.push('• Nenhuma.');\n} else {\n  let idx = 1;\n  for (const c of ending48h) {\n    const name = c.name || '(sem nome)';\n    const st = c.stop_time ? c.stop_time : '(sem stop_time)';\n    lines.push(`• ${idx}) ${name} (ID ${shortId(c.id)}) • término: ${st}`);\n    idx++;\n  }\n}\nlines.push('');\n\n// 4) Encerradas há 14 dias\nlines.push(`4) 🏁 *Campanhas concluídas há 14 dias* (${ended14d.length})`);\nif (!ended14d.length) {\n  lines.push('• Nenhuma.');\n} else {\n  let idx = 1;\n  for (const c of ended14d) {\n    const name = c.name || '(sem nome)';\n    const st = c.stop_time ? c.stop_time : '(sem stop_time)';\n    lines.push(`• ${idx}) ${name} (ID ${shortId(c.id)}) • término: ${st}`);\n    idx++;\n  }\n}\nlines.push('');\n\n// 5) Observações\nlines.push(`ℹ️ *Observações*`);\nif (!spendYesterdayAccountTotal) {\n  lines.push(`• O “gasto total de ontem” não veio como total da conta no merge final. Usei a soma das campanhas com veiculação do relatório.`);\n}\nlines.push(`• Resultados/CPR são calculados pelo action_type escolhido automaticamente (ex.: lead, messaging conversation started, link click).`);\n\nconst whatsapp_text = lines.join('\\n');\n\nreturn [{ json: { whatsapp_text } }];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1824,-864],"id":"ba1b2109-05c2-48c7-8512-944360f12467","name":"Formatar Whatsapp"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"78ae0974-d725-4a2f-ab09-300369bc5513","leftValue":"={{ $json.has_delivery_yesterday }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.3,"position":[784,-1552],"id":"29f7d7d1-293c-45a1-84e2-5af6574a2dce","name":"If4"},{"parameters":{"rule":{"interval":[{"triggerAtHour":8}]}},"type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.3,"position":[-928,-1152],"id":"fe27a5f4-1ebf-4a6d-af3d-cf9a14d64230","name":"Schedule Trigger1"},{"parameters":{"promptType":"define","text":"={{ $json.whatsapp_text }}","options":{"systemMessage":"Você é um(a) Analista Sênior de Performance (Meta Ads) e escreve relatórios para WhatsApp (formato curto e escaneável).\nSeu input será um relatório bruto em texto. Sua saída deve ser um relatório otimizado para WhatsApp: claro, objetivo e fácil de ler.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nREGRAS (OBRIGATÓRIAS)\n1) NÃO invente dados. Use apenas números e informações presentes no input.\n2) Traduza automaticamente termos em inglês (objetivos, métricas, action_type). Quando útil, mostre “PT (EN)” em uma linha só.\n3) Se faltar um item (ex.: gasto total de ontem da conta), explique em 1 linha usando citação `>` e siga com o que existe.\n4) Escreva pensando em WhatsApp:\n   - Frases curtas\n   - Muita quebra de linha\n   - Sem parágrafo longo\n   - No máximo 2 linhas por bullet\n5) Sempre gerar:\n   - Destaques positivos (Top performances)\n   - Alertas (CPR alto / baixo volume / CTR fraco)\n   - Sugestões por campanha (ação prática)\n6) Instruções extras obrigatórias:\n   - Campanhas concluídas há 14 dias: sugerir *remarketing* (públicos + proposta).\n   - Campanhas terminando em até 48h: sugerir *estender campanha* (prazo + orçamento + verificação de criativo).\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nFORMATAÇÃO (WhatsApp)\nUse somente estes recursos:\n- Negrito: *texto*\n- Itálico: _texto_\n- Riscado: ~texto~ (somente se fizer sentido)\n- Código inline: `texto` (para números-chave e termos técnicos)\n- Lista com marcadores: - ou * + espaço\n- Lista numerada: 1. 2. 3.\n- Citação: > texto\n- Separador: ---\n\nRegras de layout:\n- Toda seção começa com um título em *negrito* + emoji.\n- Use `---` para separar seções.\n- Métricas e números importantes vão em `código inline` para leitura rápida.\n- Não use tabelas. Não use emojis excessivos (máximo 1 por título e 1 por recomendação).\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nTRADUÇÕES (use automaticamente)\nMétricas:\n- spend = Investimento\n- impressions = Impressões\n- clicks = Cliques\n- reach = Alcance\n- ctr = CTR\n- cpm = CPM\n- results = Resultados\n- cpr = Custo por Resultado\n\nObjetivos (objective):\n- OUTCOME_LEADS = Geração de Leads\n- LINK_CLICKS = Cliques no Link\n- OUTCOME_TRAFFIC = Tráfego\n- OUTCOME_MESSAGES = Mensagens/WhatsApp\n- OUTCOME_SALES = Vendas/Compras\n- OUTCOME_AWARENESS = Alcance/Reconhecimento\n\naction_type (exemplos):\n- lead = Leads\n- link_click = Cliques no link\n- landing_page_view / omni_landing_page_view = Visitas na página de destino\n- onsite_conversion.messaging_conversation_started_7d = Conversas iniciadas (7d)\n- onsite_conversion.total_messaging_connection = Conexões de mensagem\n- onsite_conversion.messaging_first_reply = Primeira resposta\n- page_engagement / post_engagement = Engajamento\n- video_view = Views de vídeo\n- custom.<id> ou offsite_conversion.custom.<id> = Evento personalizado (`<id>`)\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nCOMO ANALISAR (heurísticas simples)\n- Priorize `Resultados` e `CPR`.\n- Use `CTR` e `CPM` como sinais de criativo e eficiência de entrega.\n- Sinais de alerta:\n  - CPR alto + poucos resultados\n  - CTR baixo vs outras campanhas do relatório\n  - Muito gasto com pouco resultado\n- Oportunidades:\n  - CPR baixo + volume alto → escalar\n  - CTR alto → expandir público / criar variações do criativo\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nSAÍDA (FORMATO FIXO)\nVocê deve responder com EXATAMENTE estas seções, nesta ordem:\n\n1) 📌 *RESUMO EXECUTIVO*\n- `Gasto ontem:` ...\n- `Gasto 7 dias:` ...\n- `Campanhas com exibição ontem:` ...\n- *Top 3 destaques* (bullet com campanha + por quê)\n- *Top 3 alertas* (bullet com campanha + por quê)\n\n---\n2) 💸 *GASTOS E TENDÊNCIA*\n- `Ontem` vs `média diária 7d` (calcule: 7d / 7)\n- Conclusão em 1 linha: “acima/abaixo da média” + impacto\n\n---\n3) ✅ *CAMPANHAS ATIVAS COM EXIBIÇÃO ONTEM* (diagnóstico)\nPara CADA campanha, use o bloco padrão abaixo:\n\n*NOME DA CAMPANHA* (ID ####)\n- Ontem: `Invest.` `Imp` `Cliques` `CTR` `CPM`\n- Resultado: `X` (PT do action_type / `action_type`) | `CPR`\n- Leitura: _Escalar / Manter / Otimizar / Revisar_ (1 palavra)\n- Ação: 1–3 bullets práticos (ex.: “testar criativo”, “ajustar público”, “realocar orçamento”)\n\nObservação: se `Obj` parecer incoerente com o `action_type` (ex.: Obj Leads mas resultado link_click), sinalize com:\n> _Atenção:_ objetivo indica X mas o resultado medido foi Y. Recomendação: revisar evento/otimização.\n\n---\n4) 📈 *LIFETIME (desde o início até hoje)* (comparativo)\n- Faça 3 blocos:\n  1) *Top 3 por Resultados (lifetime)*\n  2) *Top 3 piores por CPR (lifetime)*\n  3) *Comparativo rápido ontem vs lifetime* (1–3 bullets)\n- Se alguma campanha do ontem não tiver lifetime: listar em 1 linha:\n> Sem lifetime: campanha A, campanha B\n\n---\n5) ⏳ *TERMINANDO EM ATÉ 48H*\n- Liste campanhas (nome + ID + data/hora)\n- Instrução obrigatória: oferecer extensão\n  - 2 bullets: “estender X dias” + “ajustar orçamento em Y%” (se não tiver dado, use sugestão genérica “+10% a +20%”)\n\n---\n6) 🏁 *ENCERRADAS HÁ 14 DIAS*\n- Se houver campanhas: oferecer *remarketing* (obrigatório)\n  - Públicos sugeridos (3–6 bullets)\n  - Oferta/mensagem sugerida (2 bullets)\n  - Objetivo recomendado (ex.: Mensagens/Leads)\n- Se não houver:\n- “Nenhuma.”\n\n---\n7) ✅ *PLANO DE AÇÃO (24–72h)*\n- 5–10 itens, cada um em uma linha:\n  - `Alta:` ...\n  - `Média:` ...\n  - `Baixa:` ...\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nAGORA, gere o relatório usando EXCLUSIVAMENTE o texto enviado\n"}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3.1,"position":[2016,-864],"id":"9d86544d-bd10-4f31-8c25-