messages[0] : null;\n  if (typeof msg0?.created_at === 'number') return msg0.created_at;\n\n  // Fallback ISO date (updated_at) -> seconds\n  const iso = conv?.updated_at || msg0?.updated_at;\n  if (typeof iso === 'string') {\n    const ms = Date.parse(iso);\n    if (!Number.isNaN(ms)) return Math.floor(ms / 1000);\n  }\n\n  // Último fallback: created_at (epoch seconds)\n  if (typeof conv?.created_at === 'number') return conv.created_at;\n\n  // Se nada existir, joga lá pra baixo\n  return 0;\n}\n\n// 3) Ordena e pega a mais recente\nconversations.sort((a, b) => toEpochSeconds(b) - toEpochSeconds(a));\nconst latest = conversations[0];\n\n// 4) Retorna o que importa\nreturn [{\n  json: {\n    ultimoChatId: latest.id ?? null,\n    ultimoChatUuid: latest.uuid ?? null,\n    ultimoChatInboxId: latest.inbox_id ?? null,\n    ultimoChatStatus: latest.status ?? null,\n    ultimoChatLastActivityAt: latest.last_activity_at ?? latest.timestamp ?? toEpochSeconds(latest),\n    ultimoChat: latest,\n  }\n}];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2240,0],"id":"90e88e3c-df00-4f5a-949a-8071bb8186c9","name":"Code in JavaScript2"}],"connections":{"Pagina":{"main":[[{"node":"HTML","type":"main","index":0}]]},"HTML":{"main":[[{"node":"Respond to Webhook","type":"main","index":0}]]},"Requisiçao ":{"main":[[{"node":"List all sessions","type":"main","index":0}]]},"List all sessions":{"main":[[{"node":"Filter","type":"main","index":0}]]},"Filter":{"main":[[{"node":"Code in JavaScript","type":"main","index":0}]]},"Code in JavaScript":{"main":[[{"node":"Code in JavaScript1","type":"main","index":0}]]},"Code in JavaScript1":{"main":[[{"node":"Check phone number is registered in WhatsApp.","type":"main","index":0}]]},"Check phone number is registered in WhatsApp.":{"main":[[{"node":"If","type":"main","index":0}]]},"If":{"main":[[{"node":"Send a text message1","type":"main","index":0}],[{"node":"Respond to Webhook1","type":"main","index":0}]]},"List all sessions1":{"main":[