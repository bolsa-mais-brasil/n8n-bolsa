     display:flex;\n      align-items:center;\n      justify-content:center;\n      padding: 28px 16px;\n    }\n\n    .card{\n      width: min(720px, 100%);\n      background: linear-gradient(180deg, var(--card), rgba(255,255,255,.06));\n      border: 1px solid var(--border);\n      border-radius: var(--radius);\n      box-shadow: var(--shadow);\n      overflow:hidden;\n    }\n\n    .header{\n      padding: 18px 18px 12px;\n      border-bottom: 1px solid rgba(255,255,255,.10);\n    }\n\n    h1{\n      font-size: 18px;\n      margin: 0;\n      letter-spacing: .2px;\n    }\n    .sub{\n      margin: 8px 0 0;\n      color: var(--muted);\n      font-size: 13.5px;\n      line-height: 1.35;\n    }\n\n    .body{ padding: 18px; }\n\n    .field{\n      display:flex;\n      flex-direction:column;\n      gap: 8px;\n      margin-bottom: 14px;\n    }\n    label{\n      font-size: 13px;\n      color: rgba(255,255,255,.86);\n    }\n\n    input, textarea, select{\n      width:100%;\n      background: rgba(255,255,255,.06);\n      border: 1px solid rgba(255,255,255,.14);\n      border-radius: var(--radius-sm);\n      padding: 12px 12px;\n      color: var(--text);\n      outline: none;\n      transition: border-color .15s ease, box-shadow .15s ease;\n      font-size: 14px;\n    }\n    textarea{ min-height: 120px; resize: vertical; }\n\n    input:focus, textarea:focus, select:focus{\n      border-color: rgba(96,165,250,.7);\n      box-shadow: var(--focus);\n    }\n\n    select option{\n      color: #0b1220;\n    }\n\n    .hint{\n      font-size: 12px;\n      color: var(--muted);\n      line-height: 1.35;\n    }\n\n    .actions{\n      display:flex;\n      gap: 12px;\n      align-items:center;\n      margin-top: 10px;\n      flex-wrap: wrap;\n    }\n\n    .btn{\n      appearance:none;\n      border: 1px solid rgba(255,255,255,.14);\n      background: rgba(255,255,255,.08);\n      color: var(--text);\n      padding: 12px 14px;\n      border-radius: 14px;\n      cursor:pointer;\n      font-weight: 600;\n      transition: transform .05s ease, background .15s ease, border-color .15s ease, opacity .15s ease;\n      display:inline-flex;\n      align-items:center;\n      gap: 10px;\n      user-select:none;\n    }\n    .btn:hover{ background: rgba(255,255,255,.12); }\n    .btn:active{ transform: translateY(1px); }\n    .btn:disabled{ opacity:.55; cursor:not-allowed; }\n\n    .btn-primary{\n      border-color: rgba(49,196,141,.35);\n      background: rgba(49,196,141,.16);\n    }\n    .btn-primary:hover{\n      background: rgba(49,196,141,.22);\n      border-color: rgba(49,196,141,.55);\n    }\n\n    .btn-ghost{ background: transparent; }\n\n    .spinner{\n      width: 16px; height: 16px;\n      border-radius: 50%;\n      border: 2px solid rgba(255,255,255,.28);\n      border-top-color: rgba(255,255,255,.85);\n      animation: spin .8s linear infinite;\n      display:none;\n    }\n    .btn.loading .spinner{ display:inline-block; }\n    @keyframes spin { to{ transform: rotate(360deg); } }\n\n    .toast{\n      font-size: 12px;\n      color: rgba(255,255,255,.78);\n      margin-top: 10px;\n      min-height: 16px;\n    }\n    .toast.error{ color: rgba(251,113,133,.95); }\n\n    /* modal */\n    .modal-backdrop{\n      position: fixed;\n      inset: 0;\n      background: rgba(0,0,0,.55);\n      display:none;\n      align-items:center;\n      justify-content:center;\n      padding: 18px;\n    }\n    .modal-backdrop.show{ display:flex; }\n\n    .modal{\n      width: min(620px, 100%);\n      background: rgba(15,23,42,.92);\n      border: 1px solid rgba(255,255,255,.14);\n      border-radius: 18px;\n      box-shadow: var(--shadow);\n      overflow:hidden;\n      transform: translateY(6px);\n      animation: pop .14s ease-out forwards;\n    }\n    @keyframes pop { to { transform: translateY(0); } }\n\n    .modal-head{\n      padding: 14px 16px;\n      border-bottom: 1px solid rgba(255,255,255,.10);\n      display:flex;\n      align-items:center;\n      justify-content:space-between;\n      gap: 10px;\n    }\n    .modal-title{\n      margin:0;\n      font-size: 14px;\n      letter-spacing: .2px;\n    }\n    .x{\n      border:none;\n      background: transparent;\n      color: rgba(255,255,255,.75);\n      cursor:pointer;\n      font-size: 18px;\n      line-height: 1;\n      padding: 6px 8px;\n      border-radius: 10px;\n    }\n    .x:hover{ background: rgba(255,255,255,.08); }\n\n    .modal-body{ padding: 16px; }\n    .modal-msg{\n      margin: 0 0 12px;\n      color: rgba(255,255,255,.88);\n      line-height: 1.45;\n      font-size: 14px;\n      white-space: pre-wrap;\n      word-break: break-word;\n    }\n    .linkbox{\n      display:none;\n      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;\n      font-size: 12px;\n      color: rgba(255,255,255,.78);\n      background: rgba(0,0,0,.22);\n      border: 1px solid rgba(255,255,255,.10);\n      padding: 10px;\n      border-radius: 14px;\n      overflow:auto;\n    }\n    .modal-actions{\n      padding: 0 16px 16px;\n      display:flex;\n      gap: 10px;\n      justify-content:flex-end;\n      flex-wrap: wrap;\n    }\n  </style>\n</head>\n<body>\n  <section class=\"card\">\n    <header class=\"header\">\n      <h1>Enviar mensagem</h1>\n      <p class=\"sub\">\n        Selecione a origem, informe o número de destino e digite a mensagem.\n      </p>\n    </header>\n\n    <div class=\"body\">\n      <form id=\"form\">\n        <div class=\"field\">\n          <label for=\"sessaoSelect\">Enviar a partir de</label>\n          <select id=\"sessaoSelect\" required>\n            <option value=\"\" disabled selected>Carregando opções...</option>\n          </select>\n          <div class=\"hint\">Escolha o número/origem que vai enviar a mensagem.</div>\n        </div>\n\n        <div class=\"field\">\n          <label for=\"numero\">Número de destino</label>\n          <input\n            id=\"numero\"\n            name=\"numero\"\n            type=\"tel\"\n            inputmode=\"tel\"\n            placeholder=\"Ex.: 5511999999999\"\n            autocomplete=\"tel\"\n            required\n          />\n          <div class=\"hint\">Use DDI + DDD + número (somente números).</div>\n        </div>\n\n        <div class=\"field\">\n          <label for=\"mensagem\">Mensagem</label>\n          <textarea\n            id=\"mensagem\"\n            name=\"mensagem\"\n            placeholder=\"Digite sua mensagem...\"\n            required\n          ></textarea>\n        </div>\n\n        <div class=\"actions\">\n          <button id=\"btnEnviar\" class=\"btn btn-primary\" type=\"submit\">\n            <span class=\"spinner\" aria-hidden=\"true\"></span>\n            <span>Enviar</span>\n          </button>\n          <button class=\"btn btn-ghost\" type=\"button\" id=\"btnLimpar\">Limpar</button>\n        </div>\n\n        <div id=\"toast\" class=\"toast\" aria-live=\"polite\"></div>\n      </form>\n    </div>\n  </section>\n\n  <!-- Modal -->\n  <div class=\"modal-backdrop\" id=\"modalBackdrop\" role=\"dialog\" aria-modal=\"true\" aria-hidden=\"true\">\n    <div class=\"modal\" role=\"document\">\n      <div class=\"modal-head\">\n        <h2 class=\"modal-title\" id=\"modalTitle\">Aviso</h2>\n        <button class=\"x\" id=\"modalClose\" aria-label=\"Fechar\">×</button>\n      </div>\n      <div class=\"modal-body\">\n        <p class=\"modal-msg\" id=\"modalMsg\"></p>\n        <div class=\"linkbox\" id=\"modalLinkBox\"></div>\n      </div>\n      <div class=\"modal-actions\">\n        <button class=\"btn btn-ghost\" id=\"btnCopiar\" type=\"button\" style=\"display:none;\">Copiar link</button>\n        <button class=\"btn btn-primary\" id=\"btnAbrir\" type=\"button\" style=\"display:none;\">Abrir Chatwoot</button>\n        <button class=\"btn\" id=\"btnOk\" type=\"button\">OK</button>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    const ENDPOINT_SESSOES = \"https://webhookbolsa.bmbr.com.br/webhook/421aa6e4-ee03-420d-aeea-983148a511dc\";\n    const ENDPOINT_ENVIO   = \"https://webhookbolsa.bmbr.com.br/webhook/b1d25587-492f-4ded-a52d-5d43d5ba32c5\";\n\n    const $ = (sel) => document.querySelector(sel);\n\n    const form = $(\"#form\");\n    const sessaoSelect = $(\"#sessaoSelect\");\n    const numero = $(\"#numero\");\n    const mensagem = $(\"#mensagem\");\n    const btnEnviar = $(\"#btnEnviar\");\n    const btnLimpar = $(\"#btnLimpar\");\n    const toast = $(\"#toast\");\n\n    const modalBackdrop = $(\"#modalBackdrop\");\n    const modalTitle = $(\"#modalTitle\");\n    const modalMsg = $(\"#modalMsg\");\n    const modalClose = $(\"#modalClose\");\n    const btnOk = $(\"#btnOk\");\n    const btnAbrir = $(\"#btnAbrir\");\n    const btnCopiar = $(\"#btnCopiar\");\n    const modalLinkBox = $(\"#modalLinkBox\");\n\n    function setLoading(isLoading){\n      btnEnviar.disabled = isLoading;\n      btnEnviar.classList.toggle(\"loading\", isLoading);\n      btnLimpar.disabled = isLoading;\n      sessaoSelect.disabled = isLoading || sessaoSelect.dataset.locked === \"1\";\n      numero.disabled = isLoading;\n      mensagem.disabled = isLoading;\n    }\n\n    function lockSessaoSelect(locked){\n      sessaoSelect.dataset.locked = locked ? \"1\" : \"0\";\n      sessaoSelect.disabled = locked;\n    }\n\n    function showToast(text, isError=false){\n      toast.textContent = text || \"\";\n      toast.classList.toggle(\"error\", !!isError);\n    }\n\n    function openModal({ title=\"Aviso\", message=\"\", link=null }){\n      modalTitle.textContent = title;\n      modalMsg.textContent = message;\n\n      if (link){\n        modalLinkBox.style.display = \"block\";\n        modalLinkBox.textContent = link;\n\n        btnAbrir.style.display = \"inline-flex\";\n        btnCopiar.style.display = \"inline-flex\";\n\n        btnAbrir.onclick = () => window.open(link, \"_blank\", \"noopener,noreferrer\");\n        btnCopiar.onclick = async () => {\n          try{\n            await navigator.clipboard.writeText(link);\n            showToast(\"Link copiado.\", false);\n          }catch(e){\n            showToast(\"Não foi possível copiar automaticamente. Copie manualmente.\", true);\n          }\n        };\n      }else{\n        modalLinkBox.style.display = \"none\";\n        modalLinkBox.textContent = \"\";\n        btnAbrir.style.display = \"none\";\n        btnCopiar.style.display = \"none\";\n        btnAbrir.onclick = null;\n        btnCopiar.onclick = null;\n      }\n\n      modalBackdrop.classList.add(\"show\");\n      modalBackdrop.setAttribute(\"aria-hidden\", \"false\");\n      btnOk.focus();\n    }\n\n    function closeModal(){\n      modalBackdrop.classList.remove(\"show\");\n      modalBackdrop.setAttribute(\"aria-hidden\", \"true\");\n    }\n\n    modalClose.addEventListener(\"click\", closeModal);\n    btnOk.addEventListener(\"click\", closeModal);\n    modalBackdrop.addEventListener(\"click\", (e) => {\n      if (e.target === modalBackdrop) closeModal();\n    });\n    document.addEventListener(\"keydown\", (e) => {\n      if (e.key === \"Escape\" && modalBackdrop.classList.contains(\"show\")) closeModal();\n    });\n\n    function normalizePhone(raw){\n      return (raw || \"\").replace(/\\D/g, \"\");\n    }\n\n    async function carregarSessoes(){\n      lockSessaoSelect(true);\n      sessaoSelect.innerHTML = `<option value=\"\" disabled selected>Carregando opções...</option>`;\n      showToast(\"Carregando opções...\");\n\n      try{\n        const resp = await fetch(ENDPOINT_SESSOES, {\n          method: \"POST\",\n          headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify({})\n        });\n\n        const data = await resp.json();\n\n        if (!Array.isArray(data) || data.length === 0) {\n          throw new Error(\"Lista vazia\");\n        }\n\n        sessaoSelect.innerHTML = `<option value=\"\" disabled selected>Selecione uma opção</option>`;\n\n        for (const item of data){\n          const value = (item?.sessao ?? \"\").trim();\n          const label = (item?.display ?? value).trim();\n          if (!value) continue;\n\n          const opt = document.createElement(\"option\");\n          opt.value = value;      // o que vai no POST: sessao\n          opt.textContent = label; // o que o usuário vê: display\n          sessaoSelect.appendChild(opt);\n        }\n\n        if (sessaoSelect.options.length <= 1) {\n          throw new Error(\"Sem opções válidas\");\n        }\n\n        lockSessaoSelect(false);\n        showToast(\"\");\n      }catch(e){\n        sessaoSelect.innerHTML = `<option value=\"\" disabled selected>Não foi possível carregar</option>`;\n        lockSessaoSelect(true);\n        showToast(\"Não foi possível carregar as opções.\", true);\n        openModal({\n          title: \"Atenção\",\n          message: \"Não foi possível carregar os números disponíveis. Recarregue a página e tente novamente.\"\n        });\n      }\n    }\n\n    form.addEventListener(\"submit\", async (e) => {\n      e.preventDefault();\n      showToast(\"\");\n\n      const sessaoVal = (sessaoSelect.value || \"\").trim();\n      const numeroVal = normalizePhone(numero.value);\n      const mensagemVal = (mensagem.value || \"\").trim();\n\n      if (!sessaoVal){\n        openModal({ title: \"Erro\", message: \"Selecione por qual número a mensagem será enviada.\" });\n        return;\n      }\n      if (!numeroVal){\n        openModal({ title: \"Erro\", message: \"Informe um número de destino válido.\" });\n        return;\n      }\n      if (!mensagemVal){\n        openModal({ title: \"Erro\", message: \"Informe a mensagem.\" });\n        return;\n      }\n\n      setLoading(true);\n      showToast(\"Enviando...\");\n\n      try{\n        const resp = await fetch(ENDPOINT_ENVIO, {\n          method: \"POST\",\n          headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify({ sessao: sessaoVal, numero: numeroVal, mensagem: mensagemVal })\n        });\n\n        const data = await resp.json();\n        const status = !!data?.status;\n        const link = data?.link ?? null;\n\n        // Se status for true mas link vier vazio, trata como falha também (melhor que “sucesso sem link”)\n        if (!status || !link){\n          openModal({ title: \"Não encontrado\", message: \"Numero nao encontrado\", link: null });\n          showToast(\"Número não encontrado.\", true);\n        } else {\n          openModal({\n            title: \"Sucesso\",\n            message: \"Mensagem enviada com sucesso, segue o link abaixo.\",\n            link\n          });\n          showToast(\"Mensagem enviada.\");\n        }\n\n      }catch(err){\n        openModal({\n          title: \"Não foi possível enviar\",\n          message: \"Tivemos um problema ao enviar sua solicitação. Tente novamente em instantes.\"\n        });\n        showToast(\"Erro ao enviar.\", true);\n      }finally{\n        setLoading(false);\n      }\n    });\n\n    btnLimpar.addEventListener(\"click\", () => {\n      form.reset();\n      showToast(\"\");\n      if (sessaoSelect.options.length > 0) sessaoSelect.selectedIndex = 0;\n      numero.focus();\n    });\n\n    carregarSessoes();\n  </script>\n</body>\n</html>\n"},"type":"n8n-nodes-base.html","typeVersion":1.2,"position":[224,416],"id":"ef65e619-297e-41e7-9f84-b4424b3f779c","name":"HTML"},{"parameters":{"respondWith":"text","responseBody":"={{ $json.html }}","options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[448,416],"id":"1ada5664-3e94-4c6a-8940-9b69a638476d","name":"Respond to Webhook"},{"parameters":{"resource":"Contacts","operation":"Check Exists","session":"={{ $('Code in JavaScript').item.json.name }}","phone":"={{ $json.jidCom9 }}","requestOptions":{}},"type":"n8n-nodes-waha.WAHA","typeVersion":202411,"position":[1120,96],"id":"ffb6c0b5-d937-4667-974b-941399db0d5e","name":"Check phone number is registered in WhatsApp.","credentials":{"wahaApi":{"id":"ZSKOfTrheV9bZb7M","name":"WAHA account"}}},{"parameters":{"resource":"Sessions","operation":"List","all":true,"requestOptions":{}},"type":"n8n-nodes-waha.WAHA","typeVersion":202411,"position":[224,96],"id":"d19be03c-e99c-4826-bea5-0b209b679c8a","name":"List all sessions","credentials":{"wahaApi":{"id":"ZSKOfTrheV9bZb7M","name":"WAHA account"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"dfdb218b-654d-440d-b3ac-1fa5b1143fa6","leftValue":"={{ $json.status }}","rightValue":"WORKING","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.filter","typeVersion":2.3,"position":[448,96],"id":"52c88a3d-f8c3-4ae7-a955-43e7f2b13fca","name":"Filter"},{"parameters":{"jsCode":"const items = $input.all();\nconst pick = items[Math.floor(Math.random() * items.length)];\nreturn [pick];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[672,96],"id":"ce6bf21b-2630-4caa-a2ec-916d70085503","name":"Code in JavaScript"},{"parameters":{"jsCode":"// n8n Code node (JavaScript)\n// Entrada: $('Requisiçao ').item.json.body.numero\n\nconst raw = $('Requisiçao ').item.json.body.numero ?? '';\nlet digits = String(raw).replace(/\\D/g, '');\n\n// Remove prefixo internacional tipo 00 (ex: 0055...)\nif (digits.startsWith('00')) digits = digits.slice(2);\n\n// Se não começar com 55, assume DDI 55\nif (!digits.startsWith('55')) digits = '55' + digits;\n\n// Se vier 55 duplicado (55 + 55 + ...), só removemos quando o TAMANHO denuncia.\n// Caso DDI 55 + DDD 55:\n// - total 12 (8 dígitos) ou 13 (9 dígitos) -> COMEÇA 5555 e é válido.\n// Caso DDI duplicado:\n// - total 14 ou 15 -> COMEÇA 5555 mas está grande demais -> remove um 55.\nwhile (digits.startsWith('5555') && (digits.length === 14 || digits.length === 15)) {\n  digits = digits.slice(2); // remove o primeiro 55\n}\n\n// Se ainda estiver maior que 13, recorta mantendo o DDI 55 e pegando a \"cauda\" correta\nif (digits.length > 13) {\n  // Mantém o 55 e pega os últimos 10 (DDD+8) ou 11 (DDD+9) dígitos\n  const tail11 = digits.slice(-11);\n  const tail10 = digits.slice(-10);\n\n  // Se tail11 parece móvel novo (DDD + 9xxxx....), usa ele\n  if (tail11.length === 11 && tail11[2] === '9') {\n    digits = '55' + tail11;\n  } else {\n    digits = '55' + tail10;\n  }\n}\n\n// Se ficou menor que 12 (faltando DDD por exemplo), não dá pra adivinhar.\n// Ainda assim tentamos gerar \"com9/sem9\" pelo final.\nconst cc = '55';\nconst rest = digits.startsWith(cc) ? digits.slice(2) : digits;\n\nlet ddd = '';\nlet subscriber = '';\n\nif (rest.length >= 10) {\n  ddd = rest.slice(0, 2);\n  subscriber = rest.slice(2);\n} else {\n  // sem DDD, só pega o que tem\n  subscriber = rest;\n}\n\n// aparar subscriber pra 8 ou 9\nif (subscriber.length > 9) subscriber = subscriber.slice(-9);\n\nlet numeroCom9 = '';\nlet numeroSem9 = '';\n\nif (ddd && subscriber) {\n  if (subscriber.length === 8) {\n    numeroSem9 = cc + ddd + subscriber;\n    numeroCom9 = cc + ddd + '9' + subscriber;\n  } else if (subscriber.length === 9) {\n    if (subscriber.startsWith('9')) {\n      numeroCom9 = cc + ddd + subscriber;\n      numeroSem9 = cc + ddd + subscriber.slice(1);\n    } else {\n      // 9 dígitos mas não começa com 9: mantém e deriva o sem9 com os últimos 8\n      numeroCom9 = cc + ddd + subscriber;\n      numeroSem9 = cc + ddd + subscriber.slice(-8);\n    }\n  } else {\n    const last8 = subscriber.slice(-8);\n    const last9 = subscriber.slice(-9);\n    numeroSem9 = cc + ddd + last8;\n    numeroCom9 = cc + ddd + (last9.startsWith('9') ? last9 : ('9' + last8));\n  }\n} else {\n  // Sem DDD: não inventa, só trabalha com cauda\n  const last8 = digits.slice(-8);\n  const last9 = digits.slice(-9);\n  numeroSem9 = cc + last8;\n  numeroCom9 = cc + (last9.startsWith('9') ? last9 : ('9' + last8));\n}\n\nreturn [\n  {\n    json: {\n      inputOriginal: raw,\n      inputSomenteDigitos: String(raw).replace(/\\D/g, ''),\n      normalizado: digits,\n      numeroCom9,\n      numeroSem9,\n      jidCom9: `${numeroCom9}@c.us`,\n      jidSem9: `${numeroSem9}@c.us`,\n    }\n  }\n];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[896,96],"id":"970bd7b2-7032-4498-be15-6ae1b095127b","name":"Code in JavaScript1"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"30493e84-9942-4872-ac08-bc9b9147e998","leftValue":"={{ $json.numberExists }}","rightValue":false,"operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.3,"position":[1344,96],"id":"6adc796f-7eab-43b9-8435-7a0a3bacb769","name":"If"},{"parameters":{"respondWith":"json","responseBody":"{\n  \"status\": false,\n  \"link\": \"\"\n}","options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[1568,192],"id":"011e7c68-982e-4213-9e2b-04de3f3ca780","name":"Respond to Webhook1"},{"parameters":{"resource":"Contacts","operation":"Contact Search","account_id":1,"q":"={{ $('Code in JavaScript1').item.json.numeroCom9 }}","sort":"phone_number","requestOptions":{}},"type":"@devlikeapro/n8n-nodes-chatwoot.chatWoot","typeVersion":1,"position":[1792,0],"id":"e99a1143-f28e-4297-91a0-aaa100b3ed00","name":"Search Contacts","credentials":{"chatwootApi":{"id":"br8oDVCUJbhcYO2q","name":"ChatWoot account"}}},{"parameters":{"resource":"Sessions","operation":"List","all":true,"requestOptions":{}},"type":"n8n-nodes-waha.WAHA","typeVersion":202411,"position":[224,-224],"id":"36dd9cd6-5730-4ac9-9567-e45646817c6f","name":"List all sessions1","credentials":{"wahaApi":{"id":"ZSKOfTrheV9bZb7M","name":"WAHA account"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"dfdb218b-654d-440d-b3ac-1fa5b1143fa6","leftValue":"={