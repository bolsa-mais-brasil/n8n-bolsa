length !== 13) {\n    return '';\n  }\n\n  return telefoneFinal;\n}\n\n// Uso no n8n\nconst telefone = $input.item.json.telefone || '';\nconst telefoneFormatado = formatarTelefoneBrasileiro(telefone);\n\nreturn {\n  json: {\n    ...$input.item.json,\n    telefone_original: telefone,\n    telefone_formatado: telefoneFormatado,\n    telefone_valido: telefoneFormatado !== ''\n  }\n};\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[624,-16],"id":"9629c5cc-2fcd-4584-a379-e6f45257e0db","name":"Code in JavaScript1"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"9d4b8a9e-57bd-4881-a5c8-01589ce95703","leftValue":"={{ $json.Telefone }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{"ignoreCase":false}},"type":"n8n-nodes-base.if","typeVersion":2.3,"position":[1008,-16],"id":"d729e2d5-8103-4b34-8365-6f710cb7cfe0","name":"If"},{"parameters":{"resource":"Contacts","operation":"Check Exists","session":"=Arthur","phone":"={{ $json.telefone_formatado }}","requestOptions":{}},"type":"n8n-nodes-waha.WAHA","typeVersion":202411,"position":[832,-16],"id":"2351040a-a9eb-4168-bab7-1c8ee7585fa0","name":"Check phone number is registered in WhatsApp.","credentials":{"wahaApi":{"id":"pf9MjSmvxZH8bowz","name":"WAHA account 4"}}},{"parameters":{},"type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[624,-368],"id":"01eab748-f8cf-4de5-925d-146350765ce1","name":"Sticky Note"},{"parameters":{"resource":"Chatting","operation":"Send Text","session":"=arthur","chatId":"={{json.chatId }}","text":"={{ $('Code in JavaScript').item.json.mensagem_personalizada }}","requestOptions":{}},"type":"n8n-nodes-waha.WAHA","typeVersion":202411,"position":[1232,-176],"id":"effdd300-e80c-4585-accf-176246b86ee4","name":"Send a text message","credentials":{"wahaApi":{"id":"pf9MjSmvxZH8bowz","name":"WAHA account 4"}}}],"connections":{"On for