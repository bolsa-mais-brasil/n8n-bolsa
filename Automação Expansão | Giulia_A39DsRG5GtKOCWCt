"74vuorPFMovlnboz","name":"Bolsa"}}},{"parameters":{"operation":"getAll","team":"9014888338","space":"90143751702","folder":"90146513343","list":"901413371798","filters":{}},"type":"n8n-nodes-base.clickUp","typeVersion":1,"position":[-208,-448],"id":"f288eb55-0aa3-46e3-8126-c7f422f1ac65","name":"Get many tasks","alwaysOutputData":true,"credentials":{"clickUpApi":{"id":"74vuorPFMovlnboz","name":"Bolsa"}},"onError":"continueRegularOutput"},{"parameters":{"jsCode":"// n8n Code node (JavaScript)\n// Setor de Expansão — Variações de mensagem com Giulia (substituição já aplicada)\n// Compatível com o input de Meta Lead Ads (array com um objeto)\n\n// ===== Entrada =====\nlet input = items[0].json;\nif (Array.isArray(input)) input = input[0];\n\n// ===== Helpers =====\nfunction xorshift32(seed) {\n  let x = seed | 0;\n  x ^= x << 13;\n  x ^= x >>> 17;\n  x ^= x << 5;\n  return (x >>> 0);\n}\nfunction randIndex(n) {\n  let base = Date.now() >>> 0;\n  base ^= (Math.floor(Math.random() * 0xffffffff)) >>> 0;\n  let r = xorshift32(base);\n  r = xorshift32(r);\n  r = xorshift32(r);\n  return Math.floor((r / 0x100000000) * n);\n}\nfunction safeStr(v) {\n  return (v == null ? '' : String(v)).trim();\n}\nfunction firstNameClean(s) {\n  const noDigits = safeStr(s)\n    .replace(/\\d+/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n  return noDigits.split(' ')[0] || 'Aluno';\n}\nfunction saudacaoSP() {\n  try {\n    const hour = parseInt(\n      new Intl.DateTimeFormat('pt-BR', {\n        hour: 'numeric',\n        hour12: false,\n        timeZone: 'America/Sao_Paulo',\n      }).format(new Date()),\n      10\n    );\n    if (hour < 12) return 'bom dia 👋';\n    if (hour < 18) return 'boa tarde 👋';\n    return 'boa noite 👋';\n  } catch {\n    const h = new Date().getHours();\n    if (h < 12) return 'bom dia 👋';\n    if (h < 18) return 'boa tarde 👋';\n    return 'boa noite 👋';\n  }\n}\n\n// ===== Campos extraídos =====\nconst nome = firstNameClean(input['Seu nome Completo']);\nconst telefone = safeStr(input['phone_number_formatado']);\nconst email = safeStr(input['Insira seu e-mail']);\nconst atuaEducacao = safeStr(input['você_já_atua_na_área_da_educação?']);\nconst saudacao = saudacaoSP();\n\n// ===== Templates (Expansão - Giulia) =====\nconst templates = [\n  () => `Olá ${nome}, ${saudacao}! Tudo bem?\nSou a Giulia, do Grupo Bolsa Mais Brasil. Trabalho na expansão da nossa rede de cursos técnicos e vi seu interesse em aumentar a renda.\n\nNosso modelo permite que você atue como consultor ou unidade parceira, oferecendo bolsas de estudo e recebendo uma renda recorrente por cada aluno indicado.\n\nQuer que eu te mostre rapidamente como isso funciona na prática?`,\n\n  () => `Oi ${nome}, ${saudacao}! Aqui é a Giulia, do setor de Expansão do Grupo Bolsa Mais Brasil.\nEstamos abrindo novas parcerias para quem busca renda extra atuando na área da educação.\nQuer que eu te envie o resumo de como funciona e o potencial de ganhos?`,\n\n  () => `${nome}, ${saudacao}! Sou a Giulia, do Grupo Bolsa Mais Brasil.\nNosso modelo de expansão permite que você ganhe uma renda recorrente ao indicar alunos para bolsas de estudo.\nPosso te mostrar um exemplo real de quanto nossos parceiros estão faturando?`,\n\n  () => `Tudo bem, ${nome}? ${saudacao}\nAqui é a Giulia, do Grupo Bolsa Mais Brasil. Nosso projeto de expansão permite que você lucre com indicações de alunos que estudam com bolsa.\nQuer entender em 2 minutos como isso funciona?`,\n\n  () => `Olá ${nome}, ${saudacao}! Sou a Giulia, do time de Expansão do Grupo Bolsa Mais Brasil.\nTemos um modelo simples para quem quer começar a gerar renda na área da educação, mesmo sem experiência.\nQuer que eu te mostre como iniciar?`,\n\n  () => `Oi ${nome}, ${saudacao}! Aqui é a Giulia, do Grupo Bolsa Mais Brasil.\nVi que você demonstrou interesse em oportunidades para aumentar sua renda.\nPosso te explicar como funciona o modelo de consultoria parceira e quanto dá pra ganhar por mês?`,\n\n  () => `Olá ${nome}, ${saudac