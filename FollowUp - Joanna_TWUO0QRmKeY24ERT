label !== \"string\") return label;\n  return label.replace(/\\s+/g, \"\").replace(/h$/i, \"\");\n}\n\n// Extrai o nome da(s) opção(ões) de um campo dropdown\nfunction resolveDropdownValue(field) {\n  const { value, type_config } = field || {};\n  const opts = (type_config && Array.isArray(type_config.options)) ? type_config.options : [];\n\n  if (value == null || value === \"\") return value;\n\n  const byIndex = (idx) => (opts[idx] ? opts[idx].name : null);\n  const byId = (id) => {\n    const found = opts.find(o => o.id === id || o.name === id);\n    return found ? found.name : null;\n  };\n\n  if (Array.isArray(value)) {\n    const names = value.map(v =>\n      typeof v === \"number\" ? byIndex(v) : byId(String(v))\n    ).filter(Boolean);\n    return names.length ? names : value;\n  }\n\n  if (typeof value === \"number\") {\n    const name = byIndex(value);\n    return name ?? value;\n  }\n\n  const name = byId(String(value));\n  return name ?? value;\n}\n\n// util: insere/atualiza entrada única por nome em CustomFieldsList\nfunction upsertPair(list, pair) {\n  const idx = list.findIndex(p => p.name === pair.name);\n  if (idx >= 0) {\n    list[idx] = { ...list[idx], ...pair };\n  } else {\n    list.push(pair);\n  }\n}\n\nfor (const item of items) {\n  const data = item.json || item;\n\n  // fonte A: array de custom fields (pode vir em dois lugares)\n  const customFieldsArr =\n    (Array.isArray(data.custom_fields) && data.custom_fields) ||\n    (data.raw && Array.isArray(data.raw.custom_fields) && data.raw.custom_fields) ||\n    [];\n\n  // fonte B: objeto “flat” com chaves -> valores\n  const flat = (data.custom_fields_flat && typeof data.custom_fields_flat === \"object\")\n    ? data.custom_fields_flat\n    : {};\n\n  const formattedObj = {};\n  const customPairs = [];\n\n  // 1) processa array de custom_fields com resolução de dropdown\n  for (const field of customFieldsArr) {\n    const rawVal = field.value;\n    const resolved =\n      field.type === \"drop_down\"\n        ? resolveDropdownValue(field)\n        : rawVal;\n\n    // sempre lista completa\n    upsertPair(customPairs, {\n      name: field.name,\n      value: rawVal,\n      resolvedValue: resolved,\n      id: field.id ?? null,\n      type: field.type ?? null\n    });\n\n    // comportamento antigo: só chave direta se tiver valor \"não vazio\"\n    if (rawVal !== null && rawVal !== undefined && rawVal !== \"\") {\n      formattedObj[field.name] = resolved;\n    }\n  }\n\n  // 2) completa a partir do custom_fields_flat (sem sobrescrever o que já veio do array)\n  for (const [k, v] of Object.entries(flat)) {\n    // resolvedValue igual ao valor bruto no flat (não tem metadados de dropdown aqui)\n    upsertPair(customPairs, {\n      name: k,\n      value: v,\n      resolvedValue: v,\n      id: null,\n      type: null\n    });\n\n    // só cria chave direta se ainda não criada e valor não vazio\n    if (!(k in formattedObj) && v !== null && v !== undefined && v !== \"\") {\n      formattedObj[k] = v;\n    }\n  }\n\n  // Telefones (mantido: se existir \"Telefone\", gera _12 e _13)\n  if (formattedObj[\"Telefone\"]) {\n    const { tel12, tel13 } = formatTelefone(formattedObj[\"Telefone\"]);\n    formattedObj[\"Telefone_12\"] = tel12;\n    formattedObj[\"Telefone_13\"] = tel13;\n  }\n\n  // Follow-Up atual e próximo, baseado na ORDEM do dropdown\n  let followUpCurrent = null;\n  let followUpNext = null;\n\n  const followField =\n    customFieldsArr.find(f => f.name === \"Follow-Up\") ||\n    null;\n\n  if (followField) {\n    const resolved = resolveDropdownValue(followField);\n    followUpCurrent = Array.isArray(resolved) ? resolved[0] : resolved;\n\n    const opts = (followField.type_config && followField.type_config.options) || [];\n    const names = opts.map(o => o.name);\n\n    let idx = typeof followField.value === \"number\"\n      ? followField.value\n      : names.findIndex(n => normalizeFollowLabel(n) === normalizeFollowLabel(String(followUpCurrent)));\n\n    if (idx >= 0) {\n      followUpNext = idx < names.length - 1 ? names[idx + 1] : names[idx];\n    } else {\n      followUpNext = followUpCurrent ?? null;\n    }\n  } else if (data.update) {\n    followUpNext = data.update;\n  }\n\n  if (followUpCurrent) {\n    formattedObj[\"FollowUpValue\"] = normalizeFollowLabel(String(followUpCurrent));\n  }\n\n  results.push({\n    json: {\n      id: data.id,\n      name: data.name,\n      ...formattedObj,\n      FollowUpNext: followUpNext,\n      CustomFieldsList: customPairs\n    }\n  });\n}\n\nreturn results;\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-1984,368],"id":"901f2335-4ffb-49ab-a2f6-991076157e4f","name":"formatador"},{"parameters":{"assignments":{"assignments":[{"id":"9f81aa89-8259-44b0-9d82-ee9dace20565","name":"task","value":"={{ $('formatador').item.json}}","type":"object"},{"id":"ddd65243-0484-45c0-85cf-b7127c8d00c6","name":"messages","value":"={{ $json.messages }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-816,368],"id":"a5b7684c-0df4-4bd1-9676-afd6bc5fd05e","name":"Ajuntar dados"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"1a2a7549-2d71-446b-b404-e8d76750a0b1","leftValue":"={{ $('janela de horario').item.json.task.FollowUpValue }}","rightValue":"","operator":{"type":"string","operation":"empty","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[432,368],"id":"b7d31986-d945-43d3-ba7f-f9d9718e49fc","name":"Filtro se é primeira mensagem"},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"f097564a-5f7c-41f4-86ee-f8b6e5fb4153","leftValue":"={{ $('janela de horario').item.json.task.FollowUpNext }}","rightValue":"48-72","operator":{"type":"string","operation":"contains"}}],"combinator":"and