r lead, com todas as infos, mas organizadas.\n\nconst STAGES = {\n  EMPTY: \"EMPTY\",\n  \"0\": \"0\",\n  \"1\": \"1\",\n  \"2\": \"2\",\n  \"3\": \"3\",\n  \"4\": \"4\",\n};\n\n// janela mínima por estágio (em horas)\nconst MIN_HOURS_BY_STAGE = {\n  EMPTY: 24,\n  \"0\": 48,\n  \"1\": 72,\n  \"2\": 96,\n  \"3\": 144,\n  \"4\": 144,\n};\n\nfunction asNumber(x, def = 0) {\n  const n = Number(x);\n  return Number.isFinite(n) ? n : def;\n}\n\nfunction hoursSince(tsMs) {\n  const base = asNumber(tsMs);\n  return (Date.now() - base) / (1000 * 60 * 60);\n}\n\nfunction getCF(lead, name) {\n  return lead.custom_fields?.find(f => f?.name === name) ?? null;\n}\nfunction getCFVal(lead, name) {\n  return getCF(lead, name)?.value ?? null;\n}\n\nfunction resolveStage(lead) {\n  const v = getCFVal(lead, \"Follow-Up\");\n  return (v === null || v === undefined) ? STAGES.EMPTY : String(v);\n}\n\nfunction sortByDateCreatedAsc(leads) {\n  return [...leads].sort((a, b) => asNumber(a.date_created) - asNumber(b.date_created));\n}\n\nfunction pickStatus(statusObj) {\n  if (!statusObj || typeof statusObj !== \"object\") return null;\n  const { status, id, color, type, orderindex } = statusObj;\n  return { status, id, color, type, orderindex };\n}\n\nfunction flatCustomFields(lead) {\n  // pega os nomes usados no seu payload\n  return {\n    campanha: getCFVal(lead, \"Campanha\"),\n    cidade_interesse: getCFVal(lead, \"Cidade de interesse\"),\n    curso_interesse: getCFVal(lead, \"Curso de interesse\"),\n    conhece_bmb: getCFVal(lead, \"Conhece o BMB\"),\n    origem: getCFVal(lead, \"Orígem\"),\n    telefone: getCFVal(lead, \"Telefone\"),\n    whatsapp_url: getCFVal(lead, \"Whatsapp\"),\n    email: getCFVal(lead, \"email\"),\n  };\n}\n\nfunction buildContact(lead) {\n  const cf = flatCustomFields(lead);\n  return {\n    whatsapp: cf.whatsapp_url || null,\n    phone: cf.telefone || null,\n    email: cf.email || null,\n  };\n}\n\nfunction buildAssignees(arr) {\n  if (!Array.isArray(arr)) return [];\n  return arr.map(a => {\n    if (!a || typeof a !== \"object\") return null;\n    const { id, username, color, initials, email, profilePicture } = a;\n    return { id, username, color, initials, email, profilePicture };\n  }).filter(Boolean);\n}\n\nfunction buildCreator(c) {\n  if (!c || typeof c !== \"object\") return null;\n  const { id, username, color, email, profilePicture } = c;\n  return { id, username, color, email, profilePicture };\n}\n\nfunction buildOutputLead(lead) {\n  // Derivados\n  const stage = resolveStage(lead);\n  const minHours = MIN_HOURS_BY_STAGE[stage] ?? null;\n  const hrs = hoursSince(lead.date_updated ?? lead.date_created);\n  const contact = buildContact(lead);\n  const status = pickStatus(lead.status);\n  const cfFlat = flatCustomFields(lead);\n  const assignees = buildAssignees(lead.assignees);\n  const creator = buildCreator(lead.creator);\n\n  // Ordem de inserção AQUI define a ordem final\n  const out = {};\n  out.id = lead.id;\n  out.name = lead.name;\n  out.url = lead.url;\n  out.status = status;\n  out.date_created = lead.date_created;\n  out.date_updated = lead.date_updated;\n  out.stage = stage;\n  out.followup_min_hours = minHours;\n  out.hours_since_update = Number(hrs.toFixed(2));\n  out.contact = contact;\n  out.custom_fields_flat = cfFlat;\n  out.assignees = assignees;\n  out.creator = creator;\n\n  // Guarda TUDO no final, cru, para auditoria\n  out.raw = lead;\n\n  return out;\n}\n\n// Normaliza entrada\nlet leads;\nif (Array.isArray(items[0]?.json)) {\n  // caso: items[0].json é o array de leads\n  leads = items[0].json;\n} else {\n  // caso: cada item já é um lead\n  leads = items.map(i => i.json);\n}\n\n// Ordena por criação\nleads = sortByDateCreatedAsc(leads);\n\n// Constrói saída\nconst result = leads.map(lead => ({ json: buildOutputLead(lead) }));\n\nreturn result;\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-2752,368],"id":"536cd57a-b0fa-4649-af73-8e7da4c92ec6","name":"Code in JavaScript