ckPreview(){\n      try{\n        log('Iniciando processo de exclusão')\n        const res = await fetch(LINKS.whPreview, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ preview:true })});\n        const txt = await res.text();\n        let data; try{ data = JSON.parse(txt) } catch{ data = { count: 0 } }\n        const pickCount = (d) => {\n          if (Array.isArray(d)) return d[0]?.n_pessoas ?? d[0]?.count ?? d[0]?.deleted ?? d[0]?.deletedCount;\n          if (d && typeof d === 'object') return d.n_pessoas ?? d.count ?? d.deleted ?? d.deletedCount;\n          return 0;\n        };\n        const count = Number(pickCount(data) ?? 0) || 0\n        els.ws.innerHTML = `\n          <div class='stack'>\n            <div class='badge-bin'>\n              <svg width='28' height='28' viewBox='0 0 24 24' fill='currentColor'><path d='M9 3.75h6M4.5 7.5h15m-1.125 0l-.9 11.7a2.25 2.25 0 01-2.244 2.05H8.769a2.25 2.25 0 01-2.244-2.05l-.9-11.7'/></svg>\n            </div>\n            <h2 style='color:var(--bb-green-dark); font-size:24px; font-weight:700;'>Excluir Participantes</h2>\n            <div class='count-card' style='margin-top:14px;'>\n              <div style='font-size:15px; color:#334d43;'>Participantes a serem excluídos:</div>\n              <div class='count-num'>${count}</div>\n            </div>\n            <div style='margin-top:18px; display:flex; gap:12px; justify-content:center;'>\n              <button id='btn-cancel' class='btn btn-ghost'>Cancelar</button>\n              <button id='btn-confirm' class='btn btn-danger'>Confirmar Exclusão</button>\n            </div>\n          </div>`;\n        log('Requisição enviada com sucesso', 'success')\n        document.getElementById('btn-cancel').addEventListener('click', mountExcluirIntro)\n        document.getElementById('btn-confirm').addEventListener('click', doDelete)\n      }catch(err){ log('Erro na prévia', 'error') }\n    }\n\n    async function doDelete(){\n      try{\n        els.ws.innerHTML = `<div class='stack'><div style='color:#2a3f35'>Executando...</div></div>`\n        const res = await fetch(LINKS.whExec, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ confirm:true })});\n        const txt = await res.text(); let data; try{ data = JSON.parse(txt) } catch{ data = { deleted: 0 } }\n        const pickDeleted = (d) => {\n          if (Array.isArray(d)) return d[0]?.n_pessoas ?? d[0]?.deleted ?? d[0]?.deletedCount ?? d[0]?.count;\n          if (d && typeof d === 'object') return d.n_pessoas ?? d.deleted ?? d.deletedCount ?? d.count;\n          return 0;\n        };\n        const deleted = Number(pickDeleted(data) ?? 0) || 0\n        els.ws.innerHTML = `\n          <div class='stack'>\n            <div class='badge-bin' style='background:#e9f7ef; color:#0b6b3f;'>\n              <svg width='28' height='28' viewBox='0 0 24 24' fill='currentColor'><path d='M9 12.75l2.25 2.25L15.75 9'/></svg>\n            </div>\n            <h2 style='color:var(--bb-green-dark); font-size:24px; font-weight:700;'>Exclusão concluída</h2>\n            <p class='muted' style='margin-top:6px;'>Removidos: <span style='color:#0f5132; font-weight:700'>${deleted}</span>. Job: <span style='font-family:ui-monospace, SFMono-Regular, Menlo, monospace; font-size:12px;'>${data.jobId || 'n/a'}</span></p>\n            <div style='margin-top:18px;'><button id='btn-ok' class='btn btn-ghost'>Voltar</button></div>\n          </div>`\n        log(`Exclusão: ${deleted} removido(s).`, 'success')\n        document.getElementById('btn-ok').addEventListener('click', mountExcluirIntro)\n      }catch(err){ log('Erro na exclusão', 'error'); mountExcluirIntro() }\n    }\n\n    // Bindings\n    els.tiles.grupo.addEventListener('click', () => { activate(els.tiles.grupo); mountForm(LINKS.formGrupo, 'Enviar Mensagem - Grupo'); log('Abrindo formulário de mensagem para grupo') })\n    els.tiles.leads.addEventListener('click', () => { activate(els