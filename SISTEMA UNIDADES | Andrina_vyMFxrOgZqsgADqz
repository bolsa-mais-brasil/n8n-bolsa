nd img { height: 34px; width:auto; }\n    .side-caption { font-size:13px; opacity:.9; margin: 6px 0 14px; }\n\n    /* TILE NAV igual ao print */\n    .tile { width: 170px; height: 170px; border-radius: 10px; display:grid; place-items:center; background:#1b7946; position:relative; box-shadow: inset 0 1px 0 rgba(255,255,255,.05); }\n    .tile--active { background: var(--bb-yellow); }\n    .tile-wrap { width: 170px; margin: 10px 0 26px; }\n    .tile-label { color:#fff; font-weight:600; font-size:14px; margin-top: 10px; display:block; }\n    .tile--active + .tile-label { color:#fff; opacity:.95; }\n    .nav-item { cursor:pointer; user-select:none; }\n\n    /* ICONS: simples, altos, em branco/verde */\n    .icon { width: 88px; height: 88px; }\n    .icon path, .icon rect, .icon circle { fill:#fff; }\n    .tile--active .icon path, .tile--active .icon rect, .tile--active .icon circle { fill: var(--bb-green-dark); }\n\n    /* MAIN */\n    .main { padding: 24px 28px 28px; display:flex; flex-direction:column; }\n    .page-title { text-align:center; color: var(--bb-green-dark); font-weight:800; font-size: 32px; letter-spacing:.2px; }\n\n    .workspace { display:flex; justify-content:center; align-items:flex-start; padding-top: 18px; }\n    .card { background:#fff; border:1px solid #e8eef0; border-radius:12px; box-shadow: 0 8px 30px rgba(15, 68, 51, .06); }\n    .card--frame { width: min(880px, 92%); padding: 22px; }\n    .frame { width:100%; height: 540px; border:0; border-radius: 10px; background:#fff; }\n\n    /* EXCLUIR */\n    .stack { text-align:center; margin-top: 26px; }\n    .badge-bin { width:60px; height:60px; border-radius:16px; display:grid; place-items:center; background:#ffeaea; color:#e34a4a; margin: 0 auto 10px; }\n    .count-card { display:inline-block; border: 1px solid #bfe1cd; background:#fff; border-radius:14px; padding: 18px 36px; }\n    .count-num { font-size:44px; font-weight:900; color:#e34a4a; line-height:1; }\n    .btn { appearance:none; border:0; cursor:pointer; border-radius:12px; font-weight:600; padding: 12px 18px; }\n    .btn-ghost { background:#fff; color:#185b34; border:1px solid #cfe7db; }\n    .btn-ghost:hover { background:#f7fbf9; }\n    .btn-danger { background:#ef4444; color:#fff; }\n    .btn-danger:hover { background:#dc2626; }\n\n    /* LOGS */\n    .logs { margin-top:auto; display:flex; justify-content:center; }\n    .logs-card { width:min(1080px, 92%); background:#f6faf8; border:1px solid #e3efea; border-radius:14px; }\n    .logs-head { padding: 10px 14px; border-bottom:1px solid #e3efea; font-size:11px; color:#0e4d2c; font-weight:700; letter-spacing:.06em; }\n    .logs-body { padding: 10px 14px 14px; font-size:12px; color:#344c43; max-height:96px; overflow:auto; }\n\n    @media (max-width: 980px) {\n      .shell { grid-template-columns: 1fr; }\n      .sidebar { flex-direction:row; gap:14px; align-items:flex-start; }\n      .tile-wrap { width:120px; }\n      .tile { width:120px; height:120px; }\n      .tile-label { font-size:12px; }\n      .main { padding:16px; }\n      .page-title { font-size:24px; }\n      .frame { height: 62vh; }\n      .logs { padding-bottom: 12px; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"shell\">\n    <!-- SIDEBAR -->\n    <aside class=\"sidebar\">\n      <div class=\"brand\"><img src=\"https://www.bolsamaisbrasil.com.br/themes/web_v2/assets/images/logo-branco.png\" alt=\"Bolsa Brasil\" /></div>\n      <div class=\"side-caption\">Sistema de Gerenciamento</div>\n\n      <!-- NAV: tiles -->\n      <div class=\"nav-item tile-wrap\" id=\"nav-grupo\">\n        <div class=\"tile tile--active\">\n          <!-- Ícone grupo estilo \"silhueta\" -->\n          <svg class=\"icon\" viewBox=\"0 0 64 64\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n            <circle cx=\"32\" cy=\"22\" r=\"10\"/>\n            <rect x=\"10\" y=\"36\" width=\"44\" height=\"18\" rx=\"9\" ry=\"9\"/>\n          </svg>\n        </div>\n        <span class=\"tile-label\">Mensagem para Grupo</span>\n      </div>\n\n      <div class=\"nav-item tile-wrap\" id=\"nav-leads\">\n        <div class=\"tile\">\n          <!-- Ícone seta/avião -->\n          <svg class=\"icon\" viewBox=\"0 0 64 64\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n            <path d=\"M6 34 L58 10 L42 54 L32 36 L6 34 Z\"/>\n          </svg>\n        </div>\n        <span class=\"tile-label\">Mensagem para Leads</span>\n      </div>\n\n      <div class=\"nav-item tile-wrap\" id=\"nav-excluir\">\n        <div class=\"tile\">\n          <!-- Ícone lixeira minimal -->\n          <svg class=\"icon\" viewBox=\"0 0 64 64\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n            <rect x=\"18\" y=\"22\" width=\"28\" height=\"30\" rx=\"4\"/>\n            <rect x=\"14\" y=\"16\" width=\"36\" height=\"6\" rx=\"3\"/>\n          </svg>\n        </div>\n        <span class=\"tile-label\">Excluir Participantes</span>\n      </div>\n\n      <div style=\"margin-top:auto; font-size:12px; opacity:.75;\">© <span id=\"year\"></span> Bolsa Brasil</div>\n    </aside>\n\n    <!-- MAIN -->\n    <section class=\"main\">\n      <h1 id=\"page-title\" class=\"page-title\">Enviar Mensagem - Grupo</h1>\n\n      <div id=\"workspace\" class=\"workspace\">\n        <!-- Form em card central -->\n        <div class=\"card card--frame\">\n          <iframe class=\"frame\" src=\"https://webhookbolsa.bmbr.com.br/form/disparo-pessos-grupo-temporario-andrina\" referrerpolicy=\"no-referrer\" loading=\"lazy\"></iframe>\n        </div>\n      </div>\n\n      <!-- LOGS -->\n      <div class=\"logs\">\n        <div class=\"logs-card\">\n          <div class=\"logs-head\">LOGS DO SISTEMA</div>\n          <div id=\"log\" class=\"logs-body\"></div>\n        </div>\n      </div>\n    </section>\n  </div>\n\n  <script>\n    const LINKS = {\n      formGrupo: 'https://webhookbolsa.bmbr.com.br/form/disparo-pessos-grupo-temporario-andrina',\n      formLeads: 'https://webhookbolsa.bmbr.com.br/form/b9aaa7aa-3a62-4dc5-8bf1-bdd183fdf57baegdf',\n      whPreview: 'https://webhookbolsa.bmbr.com.br/webhook/e39f4af9-32cf-48b5-8fa9-a6eca8ddffc0',\n      whExec: 'https://webhookbolsa.bmbr.com.br/webhook/4a911ba4-1194-473e-9d09-1b93b3606d2e'\n    }\n\n    const els = {\n      year: document.getElementById('year'),\n      title: document.getElementById('page-title'),\n      ws: document.getElementById('workspace'),\n      log: document.getElementById('log'),\n      tiles: {\n        grupo: document.getElementById('nav-grupo'),\n        leads: document.getElementById('nav-leads'),\n        excluir: document.getElementById('nav-excluir'),\n      }\n    }\n    els.year.textContent = new Date().getFullYear()\n\n    function log(msg, type='info'){\n      const t=new Date().toLocaleTimeString();\n      const color = type==='error'?'#c62828': type==='success'?'#0b6b3f' : '#2a3f35';\n      els.log.insertAdjacentHTML('afterbegin', `<div style=\"color:${color}\">${t} — ${msg}</div>`)\n    }\n\n    function activate(target){\n      for(const key of Object.keys(els.tiles)){\n        const wrap = els.tiles[key];\n        const tile = wrap.querySelector('.tile');\n        tile.classList.remove('tile--active');\n      }\n      target.querySelector('.tile').classList.add('tile--active');\n    }\n\n    function mountForm(url, title){\n      els.title.textContent = title;\n      els.ws.innerHTML = `<div class='card card--frame'><iframe class='frame' src='${url}' referrerpolicy='no-referrer' loading='lazy'></iframe></div>`;\n    }\n\n    function mountExcluirIntro(){\n      els.title.textContent = 'Excluir Participantes';\n      els.ws.innerHTML = `\n        <div class='stack'>\n          <div class='badge-bin'>\n            <svg width='28' height='28' viewBox='0 0 24 24' fill='currentColor'><path d='M9 3.75h6M4.5 7.5h15m-1.125 0l-.9 11.7a2.25 2.25 0 01-2.244 2.05H8.769a2.25 2.25 0 01-2.244-2.05l-.9-11.7'/></svg>\n          </div>\n          <h2 style='color:var(--bb-green-dark); font-siz